decision_nodes:
  - provider_validated_gate  # 3 branches: validated, not_validated, default -- "validated" now points straight to ccare_data_collection
  - session_gate             # 3 branches: needs_clarification, failed, default -- "sufficient"/"needs_refresh" branches REMOVED, replaced by a single "default" -> ccare_data_collection path (freshness logic now lives inside that task)
  - action_dispatch          # 7 branches: attendance, payment, explain, starter, clarify, end, default
  - payout_impact_gate       # 2 branches: payout_impact, default
  - response_exit_gate       # 2 branches: end, continue(default)

human_nodes:
