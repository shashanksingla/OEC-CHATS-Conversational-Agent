{
  "servers": {
    "Salesforce DX": {
      "command": "npx",
      "args": ["-y", "@salesforce/mcp@latest", 
               "--orgs", "DEFAULT_TARGET_ORG", 
               "--toolsets", "orgs,metadata,data,users,testing"]
    },
    "cccapprovider": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/mcp/cccap-provider-api/dist/index.js"],
      "cwd": "${workspaceFolder}/CHATS_SIT",
      "env": {
        "SF_TARGET_ORG": "CHATS_SIT",
        "CCCAP_PROVIDER_DISPLAY_NAME": "Shashank"
      }
    }
  }
}