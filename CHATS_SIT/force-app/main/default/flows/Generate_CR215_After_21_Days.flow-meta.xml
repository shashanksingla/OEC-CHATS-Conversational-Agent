<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Generate_CR215_Correspondence</name>
        <label>Generate CR215 Correspondence</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>AuthorizationFlowApxCtrl</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>authIds</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>AuthorizationFlowApxCtrl</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_If_Not_UPK_Stacked</name>
        <label>Check If Not UPK Stacked</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Not_UPK_Stacked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CDE_CHILD_ENROLLED_IN_UPK__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Is_UPK_Stacked__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Authorization_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>2</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.IDN_PROVR__r.CDE_ELV_WAIVER__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.IDN_PROVR__r.CDE_ATS_WAIVER__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Generate_CR215_Correspondence</targetReference>
            </connector>
            <label>Not UPK Stacked</label>
        </rules>
    </decisions>
    <description>Triggers CR215 when auth has ‘Yes’ selected to is this ‘Child Dually Enrolled in UPK’ and is UPK stacked value ‘No’ and the time has been 21 days since the value has been switched to ‘Yes’ as is this value  ‘Child Dually Enrolled in UPK’</description>
    <environments>Default</environments>
    <interviewLabel>Generate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Generate CR215 After 22 Days</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>ISPICKVAL({!$Record.Authorization_Status__c}, &apos;2&apos;) &amp;&amp; NOT({!$Record.IDN_PROVR__r.CDE_ELV_WAIVER__c}) &amp;&amp; NOT({!$Record.IDN_PROVR__r.CDE_ATS_WAIVER__c}) &amp;&amp; ISPICKVAL({!$Record.CDE_CHILD_ENROLLED_IN_UPK__c}, &apos;Yes&apos;) &amp;&amp; ISPICKVAL({!$Record.Is_UPK_Stacked__c}, &apos;No&apos;)  &amp;&amp; NOT(ISBLANK({!$Record.UPK_Last_Updated_date__c}))</filterFormula>
        <object>T_AUTH__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>X22_Days_After</name>
            <connector>
                <targetReference>Check_If_Not_UPK_Stacked</targetReference>
            </connector>
            <label>22 Days After</label>
            <offsetNumber>1</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>UPK_Last_Updated_date__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
