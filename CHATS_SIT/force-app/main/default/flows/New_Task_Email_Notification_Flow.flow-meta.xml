<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Email_Action</name>
        <label>Email Action</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>recipientAddresses</name>
            <value>
                <collectionElements>
                    <elementReference>Get_Assigned_User.Email</elementReference>
                </collectionElements>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <inputConfiguratorMode>Custom</inputConfiguratorMode>
                <stringValue>OrgWideEmailAddress</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderAddress</name>
            <value>
                <inputConfiguratorMode>Custom</inputConfiguratorMode>
                <stringValue>oit_salesforce_noreply@state.co.us</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>composeEmailContent</name>
            <value>
                <stringValue>True</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>$Record.Subject</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>TaskTemplate</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>true</booleanValue>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>useLineBreaks</name>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
        <versionString>3.0.1</versionString>
    </actionCalls>
    <actionCalls>
        <name>Return_Related_Object_Record_Name</name>
        <label>Return Related Object &amp; Record Names</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>getTaskRelatedRecordName</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Get_Assigned_User</targetReference>
        </connector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>recordIds</name>
            <value>
                <elementReference>$Record.WhatId</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <nameSegment>getTaskRelatedRecordName</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>vDynamicRelatedRecordName</assignToReference>
            <name>output</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <collectionProcessors>
        <name>Filter_Excluded_Tasks</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Excluded Tasks</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_Excluded_Tasks</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Excluded_Prefixes</collectionReference>
        <conditionLogic>formula_evaluates_to_true</conditionLogic>
        <connector>
            <targetReference>Is_Excluded</targetReference>
        </connector>
        <formula>LEFT(UPPER({!$Record.Subject}), LEN({!currentItem_Filter_Excluded_Tasks.Prefix__c})) =UPPER({!currentItem_Filter_Excluded_Tasks.Prefix__c})</formula>
    </collectionProcessors>
    <decisions>
        <name>Is_Excluded</name>
        <label>Is Excluded?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Return_Related_Object_Record_Name</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_excluded_from_email_notifications</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Filter_Excluded_Tasks</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes, excluded from email notifications</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>FlowName</name>
        <dataType>String</dataType>
        <expression>&apos;New_Task_Email_Notification_Flow&apos;</expression>
    </formulas>
    <formulas>
        <name>RelatedRecordText</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.WhatId}), &quot;&quot;, {!vDynamicRelatedRecordName}+&apos;&lt;br&gt;&apos;)</expression>
    </formulas>
    <formulas>
        <name>Task_URL_formula</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Enterprise_Server_URL_660}, FIND(&apos;/services&apos;, {!$Api.Enterprise_Server_URL_660})) &amp; &quot;/lightning/r/&quot; &amp;
IF(ISBLANK({!$Record.WhatId}), {!$Record.Id}, {!$Record.WhatId}) &amp; &quot;/view&quot;</expression>
    </formulas>
    <formulas>
        <name>TaskPrefixMatch_fx</name>
        <dataType>Boolean</dataType>
        <expression>BEGINS({!$Record.Subject}, {!currentItem_Filter_Excluded_Tasks.Prefix__c})</expression>
    </formulas>
    <formulas>
        <name>TaskSubjectPrefix_fx</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Subject}, 4)</expression>
    </formulas>
    <formulas>
        <name>WhatId_Prefix_formula</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.WhatId}, 3)</expression>
    </formulas>
    <interviewLabel>New Task Email Notification Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>New Task Email Notification Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Assigned_User</name>
        <label>Get Assigned User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Email_Action</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get the custom metadata types containing the task prefixes where emails should not be sent.</description>
        <name>Get_Excluded_Prefixes</name>
        <label>Get Excluded Prefixes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Filter_Excluded_Tasks</targetReference>
        </connector>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Excluded_Task_Prefixes__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterFormula>AND(BEGINS({!$Record.OwnerId}, &apos;005&apos;), NOT(ISPICKVAL({!$Record.Status}, &apos;Completed&apos;)), {!$Record.OwnerId} &lt;&gt;{!$Record.LastModifiedById})</filterFormula>
        <object>Task</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Get_Excluded_Prefixes</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>TaskTemplate</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;New Task&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;To: {!Get_Assigned_User.Name}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;{!$User.FirstName} {!$User.LastName} has assigned you the following new task:&lt;/p&gt;&lt;p&gt;Subject: {!$Record.Subject}&lt;br&gt;{!RelatedRecordText}Due Date: {!$Record.ActivityDate}&lt;br&gt;Priority: {!$Record.Priority}&lt;br&gt;Comments: {!$Record.Description}&lt;/p&gt;&lt;p&gt;For more details, please click the following link:&lt;br&gt;{!Task_URL_formula}&lt;/p&gt;</text>
    </textTemplates>
    <variables>
        <name>currentItem_Filter_Excluded_Tasks</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Excluded_Task_Prefixes__mdt</objectType>
    </variables>
    <variables>
        <name>isExcluded_var</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <name>vDynamicRelatedRecordName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
