        <name>T209Description</name>
        <dataType>String</dataType>
        <expression>&apos;The qualified exempt provider &apos; + $Record.ID_SERVICE__r.Name + &apos; has a new fiscal agreement &apos; + $Record.Name+ &apos; with the effective begin date of &apos; + Text($Record.DTE_BEGIN_AGRMT__c) + &apos; in &apos; + $Record.CDE_COUNTY__r.Name +&apos; County.&apos;</expression>
    </formulas>
    <formulas>
        <name>TaskDescription</name>
        <dataType>String</dataType>
