    <decisions>
        <name>Check_Excempt_Provider_and_Status</name>
        <label>Check Excempt Provider and Status</label>
        <locationX>380</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Exempt_Provider_with_Open_FA</name>
            <conditionLogic>(1 OR 2) AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ID_SERVICE__r.CDE_TYPE_PROVR__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>EFACB</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ID_SERVICE__r.CDE_TYPE_PROVR__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>EFACH</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.CDE_TYPE_STATUS__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DFT</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CDE_TYPE_STATUS__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OPN</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Home_or_Business_Type_Provider</targetReference>
            </connector>
            <label>Exempt Provider with Open FA</label>
        </rules>
    </decisions>
