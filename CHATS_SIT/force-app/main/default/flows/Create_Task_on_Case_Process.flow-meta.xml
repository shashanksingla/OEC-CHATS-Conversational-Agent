    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
	[T_SBSD_CASE__c].Ongoing_And_Open_Cases__c &gt;= 1,
	[T_SBSD_CASE__c].DTE_REDET_CASE__c&gt;=TODAY() , 
	OR(
	    [T_SBSD_CASE__c].DTE_RCVD_PACKET_REDET__c &lt;= TODAY() - 30,
		ISBLANK([T_SBSD_CASE__c].DTE_RCVD_PACKET_REDET__c)
