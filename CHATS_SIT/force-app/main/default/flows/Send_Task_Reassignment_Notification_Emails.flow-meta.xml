    <decisions>
        <name>Is_Assigned_To_user_active</name>
        <label>Is Assigned To user active?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Owner_is_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Assigned_To_User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notification_Recipient_Assignment</targetReference>
            </connector>
            <label>Yes, Owner is Active</label>
        </rules>
    </decisions>
    <decisions>
        <name>Reassigned_to_self</name>
        <label>Reassigned to self?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Assigned_To_User</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_skip_email</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.LastModifiedById</elementReference>
                </rightValue>
            </conditions>
            <label>Yes, skip email</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>notificationTitle_formula</name>
        <dataType>String</dataType>
        <expression>{!$User.FirstName} + &quot; &quot; + {!$User.LastName} + &quot; assigned you a task&quot;</expression>
    </formulas>
    <formulas>
        <name>RelatedRecordText</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.WhatId}), &quot;&quot;, {!vDynamicRelatedRecordName}+&apos;&lt;br&gt;&apos;)</expression>
    </formulas>
    <formulas>
        <name>Task_URL_formula</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Enterprise_Server_URL_660}, FIND(&apos;/services&apos;, {!$Api.Enterprise_Server_URL_660})) &amp; &quot;/lightning/r/&quot; &amp;
IF(ISBLANK({!$Record.WhatId}), {!$Record.Id}, {!$Record.WhatId}) &amp; &quot;/view&quot;</expression>
    </formulas>
    <formulas>
        <name>TriggeringUserId_formula</name>
        <dataType>String</dataType>
        <expression>{!$User.Id}</expression>
    </formulas>
    <formulas>
        <name>WhatId_Prefix_formula</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.WhatId}, 3)</expression>
    </formulas>
