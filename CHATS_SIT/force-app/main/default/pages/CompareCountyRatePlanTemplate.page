                            </tr>
                            <!-- End: CCCAP-2618 -->
                            <tr class="dataRow" width="100%"> <td width="70%">10. Does your county underwrite costs of fees charged to exempt family child care home providers to obtain fingerprint-based background checks?</td><td width="30%">{!ApprovedCountyRatePlan.PAYMENT_Q12__c}</td><td width="70%;" style="color: {!IF(CountyRatePlan.PAYMENT_Q12__c!= ApprovedCountyRatePlan.PAYMENT_Q12__c, 'red', 'black')}">{!CountyRatePlan.PAYMENT_Q12__c}</td></tr>
