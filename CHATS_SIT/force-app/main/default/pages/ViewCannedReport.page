<apex:page controller="ViewCannedReportApxCtrl" showHeader="false" sidebar="false">
    <apex:slds />
    <div class="slds-scope">
        <apex:form id="form" style="height: 200px;">
            <div class="slds-grid slds-align_absolute-center slds-p-top_xx-large" >
                <h2 class="slds-card__header-title">Report has been downloaded, please check the attachment.</h2>
            </div>
            <!-- SPINNER -->
            <div id="spinner" class="slds-spinner_container slds-is-relative" >
                
               <iframe src="data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;content-disposition:attachment;base64,{!reportStrConvertedBlob}" width="100%" height="720px"  ></iframe>
                 <div role="status" class="slds-spinner slds-spinner--large slds-spinner--brand">
                    <div class="slds-spinner__dot-a"></div>
                    <div class="slds-spinner__dot-b"></div>
                </div>
            </div>
            <!-- / SPINNER -->
            
        </apex:form>
    </div>
    
    <script type="text/javascript">
    window.addEventListener('load', function() {
        document.getElementById('spinner').className += ' slds-hide' ;
    })
    
    </script>
</apex:page>