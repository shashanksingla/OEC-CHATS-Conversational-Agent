                <html>
                    <tr align="left"><td style= "font-size: 100%;" align="left" >Parent Fees</td></tr>
                    <table border="1" class="list" cellspacing="0" cellpadding="0" width="100%" >                   
                        <tr class="dataRow" width="100%"> <td width="70%">4. Does your county offer Parent Fee hardships?</td><td width="30%">{!CountyPlan.PF_Q1__c}</td></tr>
                        <apex:outputPanel rendered="{!(CountyPlan.PF_Q1__c == 'Yes')}">
                            <apex:outputPanel rendered="{!isDateAfter_15June2025 == false}" layout="none">
                                <tr class="dataRow" width="100%"> <td width="70%">5. What is the process for establishing a parent fee hardship for a family receiving Colorado Works/TANF?</td><td width="30%">{!CountyPlan.PF_Q2__c}</td></tr>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!isDateAfter_15June2025 == true}" layout="none">
                                <tr class="dataRow" width="100%"> <td width="70%">5. How does a family receiving Colorado Works/TANF request a parent fee hardship?</td><td width="30%">{!CountyPlan.PF_Q7_new__c}</td></tr>
