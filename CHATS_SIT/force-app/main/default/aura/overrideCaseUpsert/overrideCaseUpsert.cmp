<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickAction,lightning:actionOverride" access="global" 
                controller="DynamicFormGenerationController" 
                extends="c:genericUtilities">
    <aura:attribute name="currentTabNumber" type="Integer" default="1"/>
    <aura:attribute name="pageMessages" type="List"/>
    <aura:attribute name="messageType" type="String"/>
    <aura:attribute name="fieldValidationErrors" type="List"/>
    <aura:attribute name="objectName" type="String" default="T_SBSD_CASE__c"/>
    <aura:attribute name="fieldNames" type="List" default="['T_SBSD_CASE__c.Name','T_SBSD_CASE__c.OwnerId','T_SBSD_CASE__c.AMT_INCOME__c','T_SBSD_CASE__c.CDE_COUNTY__c','T_SBSD_CASE__c.CDE_LANG_CORR__c','T_SBSD_CASE__c.CNT_CC_NEED_CHILD__c','T_SBSD_CASE__c.CNT_SIZE_FAMILY__c','T_SBSD_CASE__c.DTE_APPLN__c','T_SBSD_CASE__c.CDE_STATUS_WTLST__c','T_SBSD_CASE__c.DTE_RCVD_PACKET_REDET__c','T_SBSD_CASE__c.DTE_REDET_CASE__c','T_SBSD_CASE__c.DTE_SENT_PACKET_REDET__c','T_SBSD_CASE__c.IDN_PROVR__c','T_SBSD_CASE__c.IND_ASSIST_PROVR__c','T_SBSD_CASE__c.LOC_ELG_DETERM__c','T_SBSD_CASE__c.NAM_FACLTY_PROVR__c','T_SBSD_CASE__c.NAM_FIRST_PROVR__c','T_SBSD_CASE__c.NAM_LAST_PROVR__c','T_SBSD_CASE__c.ADR_CITY_PROVR__c','T_SBSD_CASE__c.ADR_LINE_1_PROVR__c','T_SBSD_CASE__c.ADR_STATE_PROVR__c','T_SBSD_CASE__c.ADR_ZIP_PROVR__c','T_SBSD_CASE__c.IND_ELG_PRE_PROVR__c','T_SBSD_CASE__c.CDE_ASST_HSNG__c','T_SBSD_CASE__c.IND_ASST_HSNG_ADDL__c','T_SBSD_CASE__c.IND_CHP__c','T_SBSD_CASE__c.IND_CHP_ADDL__c','T_SBSD_CASE__c.IND_FOOD_PGM__c','T_SBSD_CASE__c.IND_FOOD_PGM_ADDL__c','T_SBSD_CASE__c.IND_FS_RCVNG__c','T_SBSD_CASE__c.IND_FS_RCVNG_ADDL__c','T_SBSD_CASE__c.IND_HEAD_START__c','T_SBSD_CASE__c.IND_HEAD_START_ADDL__c','T_SBSD_CASE__c.IND_IDEA_0_3__c','T_SBSD_CASE__c.IND_IDEA_0_3_ADDL__c','T_SBSD_CASE__c.IND_IDEA_3_5__c','T_SBSD_CASE__c.IND_IDEA_3_5_ADDL__c','T_SBSD_CASE__c.IND_INCOME_FED_OTHER__c','T_SBSD_CASE__c.IND_INCOME_FED_OTHER_ADDL__c','T_SBSD_CASE__c.IND_LEAP__c','T_SBSD_CASE__c.IND_LEAP_ADDL__c','T_SBSD_CASE__c.IND_PENSION__c','T_SBSD_CASE__c.IND_PENSION_ADDL__c','T_SBSD_CASE__c.IND_REFUGEE__c','T_SBSD_CASE__c.IND_REFUGEE_ADDL__c','T_SBSD_CASE__c.IND_SSI__c','T_SBSD_CASE__c.IND_SSI_ADDL__c','T_SBSD_CASE__c.IND_WIC__c','T_SBSD_CASE__c.IND_WIC_ADDL__c','T_SBSD_CASE__c.IND_Child_SS_participant__c']"/>
    <aura:attribute name="sectionInformation" type="Map" default="{'Name':'Information','DTE_RCVD_PACKET_REDET__c':'Redetermination','IDN_PROVR__c':'Provider Information','CDE_ASST_HSNG__c':'Other Information'}"/>
    <aura:attribute name="requiredFields" type="List" default="['T_SBSD_CASE__c.Name','T_SBSD_CASE__c.OwnerId','T_SBSD_CASE__c.CDE_LANG_CORR__c','T_SBSD_CASE__c.IND_ASSIST_PROVR__c','T_SBSD_CASE__c.DTE_APPLN__c','T_SBSD_CASE__c.IND_ASSIST_PROVR__c','T_SBSD_CASE__c.CDE_ASST_HSNG__c','T_SBSD_CASE__c.IND_ASST_HSNG_ADDL__c','T_SBSD_CASE__c.IND_CHP__c','T_SBSD_CASE__c.IND_CHP_ADDL__c','T_SBSD_CASE__c.IND_FOOD_PGM__c','T_SBSD_CASE__c.IND_FOOD_PGM_ADDL__c','T_SBSD_CASE__c.IND_FS_RCVNG__c','T_SBSD_CASE__c.IND_FS_RCVNG_ADDL__c','T_SBSD_CASE__c.IND_HEAD_START__c','T_SBSD_CASE__c.IND_HEAD_START_ADDL__c','T_SBSD_CASE__c.IND_IDEA_0_3__c','T_SBSD_CASE__c.IND_IDEA_0_3_ADDL__c','T_SBSD_CASE__c.IND_IDEA_3_5__c','T_SBSD_CASE__c.IND_IDEA_3_5_ADDL__c','T_SBSD_CASE__c.IND_INCOME_FED_OTHER__c','T_SBSD_CASE__c.IND_INCOME_FED_OTHER_ADDL__c','T_SBSD_CASE__c.IND_LEAP__c','T_SBSD_CASE__c.IND_LEAP_ADDL__c','T_SBSD_CASE__c.IND_PENSION__c','T_SBSD_CASE__c.IND_PENSION_ADDL__c','T_SBSD_CASE__c.IND_REFUGEE__c','T_SBSD_CASE__c.IND_REFUGEE_ADDL__c','T_SBSD_CASE__c.IND_SSI__c','T_SBSD_CASE__c.IND_SSI_ADDL__c','T_SBSD_CASE__c.IND_WIC__c','T_SBSD_CASE__c.IND_WIC_ADDL__c','T_SBSD_CASE__c.IND_ELG_PRE_PROVR__c','T_SBSD_CASE__c.IND_Child_SS_participant__c']"/>
    <aura:attribute name="readOnlyFields" type="List" default="['T_SBSD_CASE__c.Name','T_SBSD_CASE__c.AMT_INCOME__c','T_SBSD_CASE__c.CDE_COUNTY__c','T_SBSD_CASE__c.CNT_CC_NEED_CHILD__c','T_SBSD_CASE__c.CNT_SIZE_FAMILY__c','T_SBSD_CASE__c.DTE_APPLN__c','T_SBSD_CASE__c.DTE_REDET_CASE__c','T_SBSD_CASE__c.DTE_RCVD_PACKET_REDET__c','T_SBSD_CASE__c.CDE_STATUS_WTLST__c']"/>
    <aura:attribute name="caseRec" type="T_SBSD_CASE__c" default="{'sobjectType':'T_SBSD_CASE__c'}"/>
    <aura:attribute name="ownerId" type="String"/>
    <aura:attribute name="parentId" type="String"/>

    <aura:attribute name="fieldDefinition" type="List[]"/>
    <aura:attribute name="initDataLoaded" type="Boolean" default="false"/>

    <aura:attribute name="countyMismatchMessage" type="String"/>
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>

    <aura:attribute name="errorComponentIds" type="List"/>
    <aura:handler name="change" value="{!v.fieldValidationErrors}" action="{!c.doHandleFieldValidationErrors}"/>
    <!--For Internal Use-->

    
    <c:LoadingSpinnerComp spinner="{!v.showSpinner}"/>
    <lightning:overlayLibrary aura:id='overlayLib'/>
    <!-- <aura:if isTrue="{!!empty(v.sOb) &amp;&amp; !empty(v.fieldDefinition)}">-->
    <aura:if isTrue="{!v.initDataLoaded==true}">
        <lightning:card iconName="standard:event">
            <aura:set attribute="title"> 
                <div class="slds-grid">
                    <div class="slds-col slds-has-flexi-truncate">
                        <div class="slds-media slds-no-space slds-grow">                        
                            <div class="slds-media__body">
                                <p class="slds-text-title--caps slds-line-height--reset">{!empty(v.parentId)?'CREATE NEW':'EDIT'}</p>
                                <h1 class="slds-page-header__title slds-m-right--small slds-align-middle slds-truncate" title="Case">Case</h1>
                            </div>
                        </div>
                    </div>
                </div>
            </aura:set>
            <aura:set attribute="actions">
                <c:navigationComponent totalTabs="1" 
                                       currentTabNumber="{!v.currentTabNumber}"
                                       onFinish="{!c.doFinish}"
                                       finishLabel="Save"
                                       showCancel="true"
                                       onCancel="{!c.doCancel}"
                                       />
            </aura:set>
            <c:pageMessages pageMessages="{!v.pageMessages}" messageType="{!v.messageType}"/>
            <aura:if isTrue="{!v.currentTabNumber==1}">
                <lightning:layout multipleRows="true" horizontalAlign="space">
                    <aura:iteration items="{!v.fieldDefinition}" var="eachField">
                        <aura:if isTrue="{!!empty(eachField.preSectionName)}">
							<aura:if isTrue="{!eachField.sectionBreakerPoint}">
                                <lightning:layoutItem flexibility="auto" size="6" padding="around-small"></lightning:layoutItem>
                            </aura:if>
                            <lightning:layoutItem flexibility="auto" size="12" padding="around-small">
                                <h3 class="slds-section__title">{!eachField.preSectionName}</h3>
                            </lightning:layoutItem>
                        </aura:if>
                        <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                            <c:CHATS_dynamicFormGenerator aura:id="dynamicFormGenerator"
                                                    fieldLabel="{!eachField.fieldLabel}"
                                                    fieldType="{!eachField.dataType}"
                                                    fieldAPIName="{!eachField.fieldAPIName}"
                                                    objectName="{!eachField.objectName}"
                                                    sOb="{!v.caseRec}"
                                                    required="{!eachField.required}"
                                                    parentObjectName="{!eachField.referenecedObjectName}"
                                                    readOnly="{!eachField.readOnly}"
                                                    usePlainValue="{!eachField.usePlainValue}"      />
                            <c:ShowErrorMessage aura:id="errorMessageComp" objectToFieldValue="{!eachField.objectName + '-' +eachField.fieldAPIName}" errorMessage=""/>
                        </lightning:layoutItem>                    
                    </aura:iteration>
                    <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                    </lightning:layoutItem>
                </lightning:layout>
                <c:confirmationModal aura:id="countyMismatch" confirmMsg="{!v.countyMismatchMessage}"
                                     confirmModalYes="{!c.doHidecountyMismatch}"
                                     title="WARNING!"/>
            </aura:if>
        </lightning:card>
    </aura:if>    
</aura:component>