<aura:component extends="c:genericUtilities" controller="GenericDataSaverApxCtrl">
    <aura:attribute name="householdIneligibilityFailure" type="batchsit_t_fcompsn_failr__x[]"/>
    <aura:attribute name="householdEligibilityId" type="String"/>
    <aura:attribute name="ineligFailureReasons" type="String"/>
    <aura:attribute name="ineligReasons" type="T_INELIG_REASON__c[]"/>
    <aura:attribute name="deleteIneligReasons" type="batchsit_t_fcompsn_failr__x[]"/>
    <aura:attribute name="addIneligReasons" type="String[]"/>
    <aura:attribute name="loadDoInit" type="Boolean" default="false"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <lightning:overlayLibrary aura:id="overlayLib"/>
    <div class="slds-m-around--small">
        <aura:if isTrue="{!v.loadDoInit}">
            <c:picklistToCheckbox label="Failure Reason Codes"
                                  object="Field_Utility__c"
                                  field="R00335__c"
                                  aura:id="input-field"
                                  value="{!v.ineligFailureReasons}"
                                  listOfRecords="{!v.ineligReasons}"
                                  onChange="{!c.updateIneligReasons}"
                                  />
       </aura:if>
    </div>
    <div class="slds-float_right">
        <lightning:button label="Save" onclick="{!c.updateIndivInelig}"/>
        <lightning:button label="Cancel" onclick="{!c.closeModal}"/>
    </div>
</aura:component>