<aura:component controller="APXPeakApplicationToCaseController" extends="c:genericUtilities" implements="force:hasRecordId">
    <!-- Variables -->
    <aura:attribute name="appCaseId" type="String"/>
    <aura:attribute name="appProcessQueueRec" type="T_APPLN_PRCS_QUEUE__c"/>
    <aura:attribute name="recordId" type="String" default="a2Dg0000000qGbq"/>

    <!-- Handlers -->
    <aura:handler event="c:peakAppUpdateParentComponentAttribute" action="{!c.doUpdateComponentAttribute}"/>
	<aura:handler name="change" value="{!v.appProcessQueueRec}" action="{!c.doInit}"/>

    <aura:attribute name="lstApplicationIndividuals" type="List"/>
    <aura:attribute name="lstSelectedApplicationIndividuals" type="List"/>
    <aura:attribute name="lstCHATSMatchedIndividuals" type="List"/>
    <aura:attribute name="stateID" type="String"/>
    <aura:attribute name="anyCaseSelected" type="Boolean" default="false"/>
    <aura:attribute name="anyIndividualSelected" type="Boolean" default="false"/>
    <aura:attribute name="mapCaseIdCaseStatus" type="Map"/>
    <aura:attribute name="lstCaseIndividual" type="List"/>
    
    
    <aura:attribute name="currentState" type="String" default="APP_INDIV_SELECTION"/>
    <aura:attribute name="currentStateTitle" type="String" default="Application Individual Selection"/>
    <aura:attribute name="applicationIndividualForClearance" type="T_APPLN_INDIV__c"/>
    <aura:attribute name="selectedCaseID" type="String"/>
    
    <aura:attribute name="lstError" type="List" description="List of errors to be displayed at the top of the table."/>
    <aura:attribute name="showError" type="Boolean" default="false" description="Flag to show/hide lstError."/>
    <aura:attribute name="recordError" type="String" />
    
    <force:recordData aura:id="forceRecordCmp"
                      recordId="{!v.recordId}"
                      fields="Id,IDN_APPLN__c,IDN_CASE__c"
                      targetFields="{!v.appProcessQueueRec}"
                      mode="VIEW"
                      targetError="{!v.recordError}" />
    
    <article class="slds-card">
        <div class="slds-card__header slds-grid">
            <header class="slds-media slds-media_center slds-has-flexi-truncate">
                <div class="slds-media__body">
                    <h2>
                        <a href="javascript:void(0);" class="slds-card__header-link slds-truncate" title="[object Object]">
                            <span class="slds-text-heading_small">{!v.currentStateTitle}</span>
                        </a>
                    </h2>
                </div>
            </header>
        </div>
        <div class="slds-card__body slds-card__body_inner">
            <aura:if isTrue="{!v.showError}">
                <div class="slds-notify slds-notify_alert slds-theme_alert-texture slds-theme_error" role="alert">
                    <span class="slds-assistive-text">error</span>
                    <span class="slds-icon_container slds-icon-utility-ban slds-m-right_x-small" title="Description of icon when needed">
                    </span>
                    <ul>
                        <aura:iteration items="{!v.lstError}" var="error">
                            <h2><li>{!error}</li></h2>
                        </aura:iteration>
                    </ul>
                    <button class="slds-button slds-button_icon slds-notify__close slds-button_icon-inverse" title="Close">
                        <span class="slds-assistive-text">Close</span>
                    </button>
                </div>     
            </aura:if>
            
            <aura:if isTrue="{!v.currentState=='APP_INDIV_SELECTION'}">
                <c:peakApplicationIndividualSelection lstApplicationIndividuals="{!v.lstApplicationIndividuals}"
                                                      lstSelectedApplicationIndividuals="{!v.lstSelectedApplicationIndividuals}"/>
            </aura:if>
            <aura:if isTrue="{!v.currentState=='APP_INDIV_CLEARANCE'}">
                <c:peakApplicationIndividualClearance lstSelectedApplicationIndividuals="{!v.lstSelectedApplicationIndividuals}"
                                                      applicationIndividualForClearance="{!v.applicationIndividualForClearance}"/>
            </aura:if>
            <aura:if isTrue="{!v.currentState=='CLEAR_INDIVIDUAL'}">
                <c:peakApplicationClearIndividual applicationIndividualForClearance="{!v.applicationIndividualForClearance}"
                                                  lstCHATSMatchedIndividuals="{!v.lstCHATSMatchedIndividuals}"/>
            </aura:if>
            <aura:if isTrue="{!v.currentState=='CASE_SELECTION'}">
                <c:peakCaseSelection lstCaseIndividual="{!v.lstCaseIndividual}"
                                     mapCaseIdCaseStatus="{!v.mapCaseIdCaseStatus}"/>
            </aura:if>
        </div>
        <footer class="slds-card__footer">
            <div class="slds-button-group" role="group">
                <aura:if isTrue="{!v.currentState=='CLEAR_INDIVIDUAL'}">
                    <button class="slds-button slds-button_brand" onclick="{!c.doClearIndividual}">Clear Individual</button>
                </aura:if>
                <aura:if isTrue="{!v.currentState=='APP_INDIV_CLEARANCE'}">
                    <button class="slds-button slds-button_neutral" onclick="{!c.goPrev}">Previous</button>
                    <button class="slds-button slds-button_brand" onclick="{!c.goToClearIndividual}">Run Clearance</button>
                </aura:if>  
                <aura:if isTrue="{!v.currentState=='APP_INDIV_CLEARANCE' || v.currentState=='APP_INDIV_SELECTION'}">
                    <button class="slds-button slds-button_brand" onclick="{!c.goNext}">Next</button>
                </aura:if>  
                <aura:if isTrue="{!v.currentState=='CASE_SELECTION'}">
                    <button class="slds-button slds-button_neutral" onclick="{!c.goPrev}">Previous</button>
                    <button class="slds-button slds-button_brand" onclick="{!c.doFinish}">Finish</button>
                </aura:if>
            </div>        	
        </footer>
        
    </article>    
    
</aura:component>