                    </lightning:accordionSection>
                    <lightning:accordionSection name="SystemInformation" label="System Information">     
                        <lightning:layout horizontalAlign="spread" multipleRows="true" class="slds-p_small height-setup">
                            <lightning:layoutItem flexibility="auto" padding="around-small" size="5" class="slds-border_bottom">
                                <div class="slds-form-element">
                                    <label class="slds-form-element__label" for="Created By">Created By</label>
                                    <div class="slds-form-element__control">
                                        <lightning:icon iconName="action:user" alternativeText="user" size="xx-small"/>
                                        &nbsp;<a href="" onclick="{!c.navigateToRecord}" data-item="{!v.case.CreatedById}">
                                        <lightning:formattedText  value="{!v.case.CreatedBy.Name}" year="numeric" month="numeric" day="numeric" aura:id="Created By"/>
                                        </a>,
                                        <lightning:formattedDateTime  value="{!v.case.CreatedDate}" year="numeric" month="numeric" day="numeric" hour="2-digit"
                                                                     minute="2-digit" hour12="true" timeZone="{!$locale.timezone}" aura:id="Created By"/>
                                    </div>
                                </div>
                            </lightning:layoutItem>
                            <lightning:layoutItem flexibility="auto" padding="around-small" size="5" class="slds-border_bottom">
                                <div class="slds-form-element">
                                    <label class="slds-form-element__label" for="Last Modified By">Last Modified By</label>
                                    <div class="slds-form-element__control">
                                        <lightning:icon iconName="action:user" alternativeText="user" size="xx-small" />
                                        &nbsp;<a href="" onclick="{!c.navigateToRecord}" data-item="{!v.case.LastModifiedById}">
                                        <lightning:formattedText  value="{!v.case.LastModifiedBy.Name}" year="numeric" month="numeric" day="numeric" aura:id="Created By"/>
                                        </a>,
                                        <lightning:formattedDateTime  value="{!v.case.LastModifiedDate}" year="numeric" month="numeric" day="numeric" hour="2-digit"
                                                                     minute="2-digit" hour12="true" timeZone="{!$locale.timezone}" aura:id="Last Modified By"/>
                                    </div>
                                </div>
                            </lightning:layoutItem>
                        </lightning:layout>
                    </lightning:accordionSection>
                </lightning:accordion>
            </p>
        </lightning:card>
    </aura:if> 
</aura:component>