<aura:component extends="c:abstractComponent" controller="EligibilityFlowCmpApxCtrl">
    <aura:attribute name="currentTabNumber" type="Integer" default="1"/>
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="readOnlyMode" type="Boolean" default="false"/>
    
    <aura:attribute name="recordError" type="String" />
    <aura:attribute name="eligRunExtId" type="String"/>
    <aura:attribute name="showSpinner" type="Boolean" default="false" description="Flag to show/hide spinner."/>
    <aura:attribute name="caseStatus" type="T_SBSD_CASE_STATUS_MODE__c"/>
    <aura:attribute name="caseEligibilityRun" type="batchsit_t_eligty_run__x"/>
    <aura:attribute name="caseEligibility" type="batchsit_t_fcompsn_eligty__x"/>
    <aura:attribute name="lastCaseEligibility" type="batchsit_t_fcompsn_eligty__x"/>
    <aura:attribute name="secondLastCaseEligibility" type="batchsit_t_fcompsn_eligty__x"/>
    <aura:attribute name="caseEligibilityDetails" type="batchsit_t_fcompsn_eligty_detail__x"/>
    <aura:attribute name="lastCaseEligibilityDetails" type="batchsit_t_fcompsn_eligty_detail__x"/>
    <aura:attribute name="secondLastCaseEligibilityDetails" type="batchsit_t_fcompsn_eligty_detail__x"/>
    <aura:attribute name="indivEligIdToWrapper" type="Map"/>
    <aura:attribute name="householdIneligibilityFailure" type="batchsit_t_fcompsn_failr__x[]"/>
    <aura:attribute name="individual" type="T_SBSD_INDIV__c[]"/>
    <aura:attribute name="casePayment" type="batchsit_t_sbsd_case_copay__x[]"/>
    <aura:attribute name="caseRec" type="T_SBSD_CASE__c"/>
    <aura:attribute name="countyPlan" type="T_COUNTY_PLAN__c"/>
    <aura:attribute name="indivEmplmtIncomeTypeEmployment" type="batchsit_t_indiv_eligty_emplmt_income__x"/>
    <aura:attribute name="indivEmplmtIncomeTypeSelfEmployment" type="batchsit_t_indiv_eligty_emplmt_income__x"/>
    <aura:attribute name="indivEmplmtExpense" type="batchsit_t_indiv_eligty_emplmt_exp__x"/>
    <aura:attribute name="indivEligtyOtherIncome" type="batchsit_t_indiv_eligty_income_other__x"/>
    <aura:attribute name="indivEligtyIncomeDeduction" type="batchsit_t_indiv_eligty_income_ddtn__x"/>
    <aura:attribute name="caseIndivs" type="T_SBSD_CASE_INDIV__c[]"/>
    <aura:attribute name="ineligReasons" type="T_INELIG_REASON__c[]"/>
    <aura:attribute name="childCareProgram" type="String"/>
    <!--<aura:attribute name="indivEmplmtIncomeTypeEmployment" type="Map"/>
    <aura:attribute name="indivEmplmtIncomeTypeSelfEmployment" type="Map"/>
    <aura:attribute name="indivEmplmtExpense" type="Map"/>
    <aura:attribute name="indivEligtyOtherIncome" type="Map"/>
    <aura:attribute name="indivEligtyIncomeDeduction" type="Map"/>-->
    
    <aura:attribute name="primCareTakerIndivElig" type="batchsit_t_fcompsn_indiv_eligty__x[]"/>
    
    <aura:attribute name="withdrawCCR" type="Boolean" default="false"/>
    <aura:attribute name="eligConfirmed" type="Boolean" default="false"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="initLoaded" type="Boolean" default="false"/>
    
    <aura:handler name="change" value="{!v.currentTabNumber}" action="{!c.doChangeCurrentTab}"/> 
    
    <div class="slds-wrap slds-grid"> 
        <div class="slds-size--2-of-3">
            <lightning:card iconName="custom:custom53">
                <aura:set attribute="title">
                    <div class="slds-grid">
                        <div class="slds-col slds-has-flexi-truncate">
                            <div class="slds-media slds-no-space slds-grow">                        
                                <div class="slds-media__body">
                                    <h1 class="slds-page-header__title slds-m-right--small slds-align-middle slds-truncate" title="Household Eligibility Results">Household Eligibility Results</h1>
                                </div>
                            </div>
                        </div>
                    </div>
                </aura:set>
                <aura:set attribute="actions">
                    <c:navigationComponent totalTabs="1" 
                                           currentTabNumber="{!v.currentTabNumber}"
                                           customButtonLabel="Back to Eligibility Run"
                                           onClickCustomButton="{!c.onClickCustomButton}"
                                           showCancel="false"
                                           showCustomButton="true"
                                           finishLabel="Confirm Eligibility"
                                           customButtonVariant="neutral"
                                           showFinish="{!!v.readOnlyMode}"
                                           onFinish="{!c.doValidateConfirmEligibility}"/>
                </aura:set>
                <c:pageMessages pageMessages="{!v.pageMessages}" messageType="{!v.messageType}"/>
                <aura:if isTrue="{!and(v.currentTabNumber==1,v.initLoaded)}">
                    <c:eligibilityFlow_householdEligibility caseStatus="{!v.caseStatus}"
                                                            caseRec="{!v.caseRec}"
                                                            caseEligibility="{!v.caseEligibility}"
                                                            lastCaseEligibility="{!v.lastCaseEligibility}"
                                                            secondLastCaseEligibility="{!v.secondLastCaseEligibility}"
                                                            caseEligibilityDetails="{!v.caseEligibilityDetails}"
                                                            lastCaseEligibilityDetails="{!v.lastCaseEligibilityDetails}"
                                                            secondLastCaseEligibilityDetails="{!v.secondLastCaseEligibilityDetails}"
                                                            caseEligibilityRun="{!v.caseEligibilityRun}"
                                                            indivEligIdToWrapper="{!v.indivEligIdToWrapper}"
                                                            householdIneligibilityFailure="{!v.householdIneligibilityFailure}"
                                                            individual="{!v.individual}"
                                                            casePayment="{!v.casePayment}"
                                                            countyPlan="{!v.countyPlan}"
                                                            eligibilityRunId="{!v.recordId}"
                                                            withdrawCCR="{!v.withdrawCCR}"
                                                            indivEmplmtIncomeTypeEmployment="{!v.indivEmplmtIncomeTypeEmployment}"
                                                            indivEmplmtIncomeTypeSelfEmployment="{!v.indivEmplmtIncomeTypeSelfEmployment}"
                                                            indivEmplmtExpense="{!v.indivEmplmtExpense}"
                                                            indivEligtyOtherIncome="{!v.indivEligtyOtherIncome}"
                                                            indivEligtyIncomeDeduction="{!v.indivEligtyIncomeDeduction}"
                                                            eligConfirmed="{!v.eligConfirmed}"
                                                            ineligReasons="{!v.ineligReasons}"
                                                            readOnlyMode="{!v.readOnlyMode}"
                                                            childCareProgram ="{!v.childCareProgram}"/>
                </aura:if>
            </lightning:card>
        </div>
        <div class="slds-size--1-of-3 slds-p-left--small">
            <lightning:card iconName="" title="Case Header">
                <aura:if isTrue="{!!empty(v.caseRec.Id)}">
                    <c:caseHeader aura:id="CaseHeader"
                                  sObjectName="T_SBSD_CASE__c"
                                  recordId="{!v.caseRec.Id}"
                                  childCareProgram ="{!v.childCareProgram}"
                                  />
                </aura:if>
            </lightning:card>
        </div> 
    </div>
    <!-- For Continuation Callbacks  -->
    <c:continuationProxy aura:id="proxy" />
</aura:component>