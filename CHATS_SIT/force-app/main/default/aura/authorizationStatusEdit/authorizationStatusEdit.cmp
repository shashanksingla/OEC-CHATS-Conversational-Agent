<aura:component extends="c:abstractComponent" controller="AuthorizationStatusController"  implements="lightning:actionOverride,flexipage:availableForRecordHome,force:hasRecordId,force:hasSObjectName" access="global">
    <aura:attribute name="authStatusRecord" type="batchsit_t_auth_status__x" default="{'sobjectType':'batchsit_t_auth_status__x',
                                                                                    'ExternalId':'',
                                                                                    'dte_end_effv__c':'',
                                                                                    'dte_begin_effv__c':'',
                                                                                    'cde_status_auth__c':'',
                                                                                    'cde_reason_change_auth__c':'',
                                                                                    'idn_auth__c':'',
                                                                                      'idn_status_auth__c':'',
                                                                                      'createdbyid__c':''}"/>
    <aura:attribute name="propertyRecord" type="batchsit_t_auth_status__x" />
    <aura:attribute name="proRecord" type="T_AUTH__c" />
    <aura:attribute name="authRecord" type="T_AUTH__c" />
    <aura:attribute name="recordDisplayName" type="String" />
    <aura:attribute name="sObjectName" type="String" />
    <aura:attribute name="isAuthChange" type="Boolean" default="true"/>
    <aura:attribute name="loggedInUserId" type="String" />
    <aura:attribute name="authStatusOptions" type="List" />
    <aura:attribute name="statusChangeReasonOptions" type="List" />
    <aura:set attribute="pageMessages" value="{!v.recordError}" />
    <aura:set attribute="messageType" value="{!v.message}" />
    <aura:attribute name="message" type="String" />
    <aura:attribute name="recordError" type="list" />
    <aura:attribute name="isAuthIdChange" type="Boolean" default="false"/>
     <aura:attribute name="isAuthIdChangeFirst" type="Boolean" default="true"/>
    <aura:handler name="change" value="{!v.propertyRecord.idn_auth__c}" action="{!c.handleAuthIdChange}"/>
    <aura:handler event="force:refreshView" action="{!c.doInit}" />
    <force:recordData aura:id="forceRecord"
                      recordId="{!v.recordId}"
                      layoutType="FULL"
                      targetRecord="{!v.authStatusRecord}"
                      targetFields="{!v.propertyRecord}"
                      fields="ExternalId,lastmodifiedbyid__c,lastmodifieddate__c,dte_end_effv__c,dte_begin_effv__c,cde_status_auth__c,cde_reason_change_auth__c,idn_auth__c,idn_status_auth__c,createdbyid__c"
                      mode="EDIT"
                      recordUpdated="{!c.handleRecordUpdated}" />
    <aura:if isTrue="{!v.isAuthChange}">
         <force:recordData aura:id="authRecord"
                           layoutType="FULL"
                           recordId="{!v.propertyRecord.idn_auth__c}"
                           targetRecord="{!v.authRecord}"
                           targetFields="{!v.proRecord}"
                           fields="Id,Name,IDN_EXTNL__c"
                           mode="EDIT"
                           recordUpdated="{!c.handleRecordUpdated}" />
    </aura:if>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <lightning:card iconName="standard:event">
        <lightning:overlayLibrary aura:id="overlayLib"/>
        <aura:set attribute="title">
            <div class="slds-grid">
                <div class="slds-col slds-has-flexi-truncate">
                    <div class="slds-media slds-no-space slds-grow">                        
                        <div class="slds-media__body">
                            <h1 class="slds-page-header__title slds-m-right--small slds-align-middle slds-truncate" title="New Authorization Notes">Edit Authorization Status</h1>
                        </div>
                    </div>
                </div>
            </div>
        </aura:set>
        <aura:set attribute="footer">
            <lightning:button variant="neutral" label="Cancel" onclick="{!c.handleCancelAuthNote}"/>
            <lightning:button variant="brand" label="Submit" onclick="{!c.saveRecord}" />
        </aura:set>
        <aura:set attribute="actions">
        </aura:set>
        <p class="slds-p-horizontal_small">
            <c:pageMessages pageMessages="{!v.pageMessages}" messageType="{!v.messageType}"/>
            <div class="slds-form_stacked">
                <div class="slds-card">
                    <div class="slds-card__body slds-card__body_inner"> 
                        <lightning:layout multipleRows="true" horizontalAlign="space">
                            <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
                                <label class="slds-form-element__label" for="input-id-01"><abbr class="slds-required" title="required">*</abbr>Status Change Reason</label> <br />
                                <ui:inputSelect aura:id="rateTypeId" class="slds-select" value="{!v.propertyRecord.cde_reason_change_auth__c}" required="true">
                                    <aura:iteration var="rate" items="{!v.statusChangeReasonOptions}" indexVar="ind">
                                        <ui:inputSelectOption text="{!rate.value}" value="{!(v.propertyRecord.cde_reason_change_auth__c == rate.value) ? true : false }" label="{!rate.label}"/>
                                    </aura:iteration>
                                </ui:inputSelect>
                                <c:fieldLevelMessage aura:id="batchsit_t_auth_notes__x-cde_reason_change_auth__c"/>
                            </lightning:layoutItem>
                            <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                                <label class="slds-form-element__label" for="input-id-01"><abbr class="slds-required" title="required">*</abbr>Authorization Status</label> <br />
                                <ui:inputSelect aura:id="authStatusId" class="slds-select" value="{!v.propertyRecord.cde_status_auth__c}" required="true">
                                    <aura:iteration var="rate1" items="{!v.authStatusOptions}" indexVar="ind">
                                        <ui:inputSelectOption text="{!rate1.value}" value="{!(v.propertyRecord.cde_status_auth__c == rate1.value) ? true : false }" label="{!rate1.label}"/>
                                    </aura:iteration>
                                </ui:inputSelect>
                                <c:fieldLevelMessage aura:id="batchsit_t_auth_notes__x-txt_notes__c"/>
                            </lightning:layoutItem>
                            <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                                <lightning:input type="date" label="Authorization Status Effective Date" name="Authorization Status Effective Date" value="{!v.propertyRecord.dte_begin_effv__c}" required="true"/>
                                <c:fieldLevelMessage aura:id="batchsit_t_auth_notes__x-txt_notes__c"/>
                            </lightning:layoutItem>
                            <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                               <lightning:input type="date" label="Authorization Status End Date" name="Authorization Status End Date" value="{!v.propertyRecord.dte_end_effv__c}"/>
                                <c:fieldLevelMessage aura:id="batchsit_t_auth_notes__x-txt_notes__c"/>
                            </lightning:layoutItem>
                            <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                                <c:inputLookup label="Authorization Id" aura:id="input-field"
                                   value="{!v.propertyRecord.idn_auth__c}"
                                   object="T_AUTH__c"
                                               required="true"
                                   searchField="Name"/>
                                <c:fieldLevelMessage aura:id="batchsit_t_auth_notes__x-idn_auth__c"/>
                            </lightning:layoutItem>
                            <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                                <label class="slds-form-element__label" for="input-id-01" required="true"><abbr class="slds-required" title="required">*</abbr>Authorization Status ID</label> <br />
                                {!v.propertyRecord.ExternalId}
                                <c:fieldLevelMessage aura:id="batchsit_t_auth_notes__x-txt_notes__c"/>
                            </lightning:layoutItem>
                        </lightning:layout>
                    </div>
                </div>
            </div>
        </p>
    </lightning:card>
</aura:component>