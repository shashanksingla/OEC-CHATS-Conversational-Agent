<aura:component controller="CompareCountyPlanTemplateController"
                implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId" access="global" >
    <aura:attribute name="recordId" type="Id" />
    <!-- <aura:handler name="init" value="{!this}" action="{!c.doInit}"/> -->
    <aura:attribute name="countyPlan" type="T_COUNTY_PLAN__c" />
    <force:recordData aura:id="recordLoader" recordId="{!v.recordId}"
                      fields="DTE_BEGIN_EFFEV__c"
                      targetFields="{!v.countyPlan}"
                      recordUpdated="{!c.doInit}"/>
</aura:component>