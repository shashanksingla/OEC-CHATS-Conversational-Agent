<aura:component controller="countyRatePlanTemplateController"
                implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickAction" access="global" >
    <aura:attribute name="recordId" type="Id" />
    <aura:attribute name="countyRate" type="T_COUNTY_RATE__c" />
    <force:recordData aura:id="recordLoader" recordId="{!v.recordId}"
                      fields="DTE_BEGIN_EFFV_RATE__c,IND_RATE_PLAN_TEMPLT__c"
                      targetFields="{!v.countyRate}"
                      recordUpdated="{!c.doInit}"/>
</aura:component>