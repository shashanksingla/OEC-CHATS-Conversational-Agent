<aura:component >
    <aura:attribute name="currentTabNumber" type="Integer"/>
    <aura:attribute name="tabNames" type="List"/>
    <aura:attribute name="tabMetadata" type="List"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    <div class="slds-path">
        <div class="slds-grid slds-path__track">
            <div class="slds-grid slds-path__scroller-container">
                <div class="slds-path__scroller">
                    <div class="slds-path__scroller_inner">
                        <ul class="slds-path__nav">
                            <aura:if isTrue="{!v.tabMetadata.length>0}">
                                <aura:iteration items="{!v.tabMetadata}" var="tabMetadatum">
                                    <li class="{!v.currentTabNumber&gt;tabMetadatum.tabNumber?'slds-is-incomplete slds-path__item':v.currentTabNumber==tabMetadatum.tabNumber?'slds-is-active slds-is-current slds-path__item':'slds-is-incomplete slds-path__item'}">
                                        <span class="slds-path__stage">{!tabMetadatum.tabName}</span>
                                        <span class="slds-path__link slds-path__title">{!tabMetadatum.tabName}</span>
                                    </li>                                	
                                </aura:iteration>
                            </aura:if>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>	
</aura:component>