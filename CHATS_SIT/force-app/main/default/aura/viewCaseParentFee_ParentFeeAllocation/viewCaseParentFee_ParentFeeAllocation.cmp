<aura:component >
    <aura:attribute name="caseParentFeeAllocations" type="List"/>
    <aura:attribute name="isEditable" type="Boolean" default="false"/>
    <aura:method name="validateAllRows" action="{!c.validateParentFeeAllocation}" access="PUBLIC"/>
    <aura:attribute name="isNotReadOnlyUser" type="Boolean" default="false"/>
    <aura:attribute name="isAuthCopayEditable" type="Boolean" default="false"/>
    <lightning:layoutItem flexibility="auto" size="12" padding="horizontal-small">
        <div class="slds-section__title">Parent Fee Allocation</div>
    </lightning:layoutItem>    
    <lightning:layoutItem flexibility="auto" size="12" padding="horizontal-small">
        <div class="slds-text-body_small">Below are the authorization that are active on the case parent fee Effective Begin Date</div> 
    </lightning:layoutItem>    
    <aura:if isTrue="{!!empty(v.caseParentFeeAllocations)}">
        <lightning:layoutItem flexibility="auto" size="12" padding="horizontal-small">
            <div class="slds-scrollable_x">
                <table class="slds-table slds-table_bordered">
                    <thead>
                        <tr class="slds-text-title_caps">
                            <th scope="col">
                                <div class="slds-truncate" title="CHILD NAME">CHILD NAME</div>
                            </th>
                            <th scope="col">
                                <div class="slds-truncate" title="AUTH ID">AUTH ID</div>
                            </th>
                            <th scope="col">
                                <div class="slds-truncate" title="DATE OF BIRTH">DATE OF BIRTH</div>
                            </th>
                            <th scope="col">
                                <div class="slds-truncate" title="PROVIDER ID">PROVIDER ID</div>
                            </th>
                            <th scope="col">
                                <div class="slds-truncate" title="PROVIDER NAME">PROVIDER NAME</div>
                            </th>
                            <th scope="col">
                                <div class="slds-truncate" title="AUTH BEGIN DATE">AUTH BEGIN DATE</div>
                            </th>
                            <th scope="col">
                                <div class="slds-truncate" title="AUTH END DATE">AUTH END DATE</div>
                            </th>
                            <th scope="col">
                                <div class="slds-truncate" title="ALLOCATED AUTH AMOUNT">ALLOCATED AUTH AMOUNT</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <aura:iteration items="{!v.caseParentFeeAllocations}" var="eachParentFeeAllocation">
                            <c:viewCaseParentFee_ParentFeeAllocationRow aura:id="parentFeeAllocationRow" eachParentFeeAllocation="{!eachParentFeeAllocation}"
                             isEditable="{!v.isEditable}"
                            isNotReadOnlyUser ="{!v.isNotReadOnlyUser}" 
                            isAuthCopayEditable ="{!v.isAuthCopayEditable}"/>
                        </aura:iteration>
                    </tbody>
                </table>  
            </div>
         </lightning:layoutItem>
    </aura:if>
</aura:component>