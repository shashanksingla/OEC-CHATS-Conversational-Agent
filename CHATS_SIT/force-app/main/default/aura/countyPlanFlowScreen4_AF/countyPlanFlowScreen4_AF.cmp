    <lightning:layout multipleRows="true">
        <lightning:layoutItem flexibility="auto" padding="around-small" size="12">
            <h3 class="slds-section__title"><B>Program Integrity</B></h3>
            <h1 class="slds-section__title">Please complete the following questions related to Program Integrity.</h1>
        </lightning:layoutItem>        
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <lightning:textarea name="input-name" label="1. Please identify the staff (titles/positions of staff) responsible for researching potential erroneous client payments."
                                aura:id="input-field" value="{!v.countyPlanRec.PI_Q3_new__c}" 
                                required="true" length="255"/>    
            <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q3_new__c"/>
        </lightning:layoutItem>        
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6"> 
            <c:inputMultiSelectCombobox label="1.1. Please identify the methods used to identify questionable client information." 
                                aura:id="input-field" value="{!v.countyPlanRec.PI_Q3_1_new__c}" 
                                object="T_COUNTY_PLAN__c" field="PI_Q3_1_new__c" required="true"/>  
            <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q3_1_new__c"/>
        </lightning:layoutItem>
        <aura:if isTrue="{!v.isQ3OtherReq}">
            <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
                <lightning:textarea name="input-name" label="If other, please specify."
                                    aura:id="input-field" value="{!v.countyPlanRec.PI_Q3_1_other__c}" 
                                    required="true" length="255"/>
                <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q3_1_other__c"/> 
            </lightning:layoutItem> 
        </aura:if>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <lightning:textarea name="input-name" label="2. Please identify the staff (titles/positions of staff) responsible for researching potential provider erroneous payments."
                                    aura:id="input-field" value="{!v.countyPlanRec.PI_Q4_new__c}" 
                                    required="true" length="255"/>
            <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q4_new__c"/>
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputMultiSelectCombobox label="2.1 Please identify all of the methods used to identify questionable provider information." 
                                aura:id="input-field" value="{!v.countyPlanRec.PI_Q4_1_new__c}" 
                                object="T_COUNTY_PLAN__c" field="PI_Q4_1_new__c" required="true"/>  
            <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q4_1_new__c"/>
        </lightning:layoutItem>
        <aura:if isTrue="{!v.isQ4OtherReq}">
            <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
                <lightning:textarea name="input-name" label="If other, please specify."
                                    aura:id="input-field" value="{!v.countyPlanRec.PI_Q4_1_other__c}" 
                                    required="true" length="255"/>
                <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q4_1_other__c"/> 
            </lightning:layoutItem> 
        </aura:if>
        
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputMultiSelectCombobox label="3. Please identify how your county ensures questionable information will be reported to other programs as applicable." 
                                aura:id="input-field" value="{!v.countyPlanRec.PI_Q5_new__c}" 
                                object="T_COUNTY_PLAN__c" field="PI_Q5_new__c" required="true"/>  
            <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q5_new__c"/>
        </lightning:layoutItem>
        <aura:if isTrue="{!v.isQ5OtherReq}">
            <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
                <lightning:textarea name="input-name" label="If other, please specify."
                                    aura:id="input-field" value="{!v.countyPlanRec.PI_Q5_other__c}" 
                                    required="true" length="255"/>
                <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q5_other__c"/> 
            </lightning:layoutItem> 
        </aura:if>
    </lightning:layout>

    <lightning:layout multipleRows="true">
        <lightning:layoutItem flexibility="auto" padding="around-small" size="12">
            <h3 class="slds-section__title"><B>Fraud Prevention</B></h3>
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <lightning:textarea name="input-name" label="4. Please explain the process your county follows to prevent and identify potential client and provider fraud:"
                                    aura:id="input-field" value="{!v.countyPlanRec.PI_Q6_new__c}" 
                                    required="true" length="2000"/>
            <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q6_new__c"/>  
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputMultiSelectCombobox label="5. The county utilizes the following methods to ensure staff are made aware of the county's fraud prevention policies and procedures to mitigate fraud:" 
                        aura:id="input-field" value="{!v.countyPlanRec.PI_Q7_new__c}" 
                        object="T_COUNTY_PLAN__c" field="PI_Q7_new__c" required="true"/>  
            <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q7_new__c"/>
        </lightning:layoutItem>
        <aura:if isTrue="{!v.isQ7OtherReq}">
            <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <lightning:textarea name="input-name" label="Please describe the other methods your county is using." aura:id="input-field"
                                 value="{!v.countyPlanRec.PI_Q7_1__c}" 
                                 required="true"
                             	 length="2000"/>    
            <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q7_1__c"/>
        </lightning:layoutItem>
        </aura:if>                
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputMultiSelectCombobox label="6. How are the county's fraud prevention policies/expectations communicated with CCCAP applicants/recipients?" 
                        aura:id="input-field" value="{!v.countyPlanRec.PI_Q9_new__c}" 
                        object="T_COUNTY_PLAN__c" field="PI_Q9_new__c" required="true"/>  
            <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q9_new__c"/>
        </lightning:layoutItem>
        <aura:if isTrue="{!v.isQ9OtherReq}">
            <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <lightning:textarea name="input-name" label="If other, please specify." aura:id="input-field"
                                 value="{!v.countyPlanRec.PI_Q9_other__c}" 
                                 required="true"
                             	 length="255"/>
            <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q9_other__c"/>
        </lightning:layoutItem>
        </aura:if>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputMultiSelectCombobox label="7. How are the county's fraud prevention policies/expectations communicated with providers?" 
                        aura:id="input-field" value="{!v.countyPlanRec.PI_Q10_new__c}" 
                        object="T_COUNTY_PLAN__c" field="PI_Q10_new__c" required="true"/>  
            <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q10_new__c"/>
        </lightning:layoutItem>
        <aura:if isTrue="{!v.isQ10OtherReq}">
            <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <lightning:textarea name="input-name" label="If other, please specify." aura:id="input-field"
                                 value="{!v.countyPlanRec.PI_Q10_other__c}" 
                                 required="true"
                             	 length="255"/>
            <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q10_other__c"/>
        </lightning:layoutItem>
        </aura:if>
    </lightning:layout>
    <lightning:layout multipleRows="true">
        <lightning:layoutItem flexibility="auto" padding="around-small" size="12">
            <h3 class="slds-section__title"><B>Fraud Detection</B></h3>
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputPicklist type="Checkbox" label="8. The county utilizes the following methods to identify potential fraud:" 
                                            aura:id="input-field"
                                            value="{!v.countyPlanRec.PI_Q11__c}" 
                                            object="T_COUNTY_PLAN__c" 
                                            field="PI_Q11__c"
                             				required="true"
                             				class="slds-text-body_small"/>
            <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q11__c"/>
        </lightning:layoutItem>
        
        <aura:if isTrue="{!v.isQ11_2Required}">
            <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
                <lightning:textarea name="input-name" label="Please identify the titles of the staff that conduct the investigation:" aura:id="input-field"
                                     value="{!v.countyPlanRec.PI_Q11_2__c}" 
                                     required="{!v.isQ11_2Required}"
                                     length="1000"/>    
                <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q11_2__c"/>
            </lightning:layoutItem>
        </aura:if>        
        <aura:if isTrue="{!v.isQ11_1Required}">
            <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
                <c:inputMultiSelectCombobox label=" Please identify the systems used as part of the review:" 
                        aura:id="input-field" value="{!v.countyPlanRec.PI_Q11_1_new__c}" 
                        object="T_COUNTY_PLAN__c" field="PI_Q11_1_new__c" required="true"/>  
                <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q11_1_new__c"/>
            </lightning:layoutItem>
        </aura:if>
        <aura:if isTrue="{!v.isQ11OtherRequired}">
            <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
                <lightning:textarea name="input-name" label="If other, please specify." aura:id="input-field"
                                     value="{!v.countyPlanRec.PI_Q11_1_other__c}" 
                                     required="true" length="255"/>    
                <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q11_1_other__c"/>
            </lightning:layoutItem>
        </aura:if>  
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <lightning:textarea name="input-name" label="9. Please identify how your county coordinates investigations for CCCAP with other public assistance programs (Adult Financial, Colorado Works, SNAP) to ensure that CCCAP-relevant information is obtained and how the county ensures that CCCAP is included in applicable IPV/fraud investigations:"
                                 aura:id="input-field"
                                 value="{!v.countyPlanRec.PI_Q12__c}" 
                                 required="true"
                             	 length="1000"/>    
            <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q12__c"/>
        </lightning:layoutItem>

        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputMultiSelectCombobox label="10. Please describe the process your county uses to monitor provider attendance records and payments. This includes regular reviews/monitoring and random or targeted reviews of provider records suspected of submitting inaccurate information:" 
                        aura:id="input-field" value="{!v.countyPlanRec.PI_Q13_new__c}" 
                        object="T_COUNTY_PLAN__c" field="PI_Q13_new__c" required="true"/>  
            <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q13_new__c"/>
        </lightning:layoutItem>
        <aura:if isTrue="{!v.isQ13OtherRequired}">
            <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
                <lightning:textarea name="input-name" label="If other, please specify." aura:id="input-field"
                                    value="{!v.countyPlanRec.PI_Q13_other__c}" 
                                    required="true"
                                    length="255"/>
                <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q13_other__c"/>
            </lightning:layoutItem>
        </aura:if>
    </lightning:layout>

    <lightning:layout multipleRows="true">
        <lightning:layoutItem flexibility="auto" padding="around-small" size="12">
            <h3 class="slds-section__title"><B>Determining Intentional Program Violations and/or Fraud</B></h3>
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputPicklist label="11. Please identify who is responsible for reviewing the allegation and investigation details to authorize the county to pursue an IPV/fraud in your county:" 
                                            aura:id="input-field"
                                            value="{!v.countyPlanRec.PI_Q14__c}" 
                                            object="T_COUNTY_PLAN__c" 
                                            field="PI_Q14__c"
                                            required="true"
                                            showNone="true" 
                             				inputPickListCustomWarningMsg="Complete this field."/>
            <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q14__c"/>
        </lightning:layoutItem>
        <aura:if isTrue="{!v.countyPlanRec.PI_Q14__c=='4'}">
            <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
                <lightning:input type="text" name="input-name" label="Please identity the title of the position" aura:id="input-field"
                                    value="{!v.countyPlanRec.PI_Q14_1__c}" 
                                    required="{!v.countyPlanRec.PI_Q14__c=='4'?true:false}"
                                    length="255"/>
                <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-PI_Q14_1__c"/>
            </lightning:layoutItem>
        </aura:if>
    </lightning:layout>    
</aura:component>