<aura:component extends="c:abstractSection">
    <aura:method name="callValidateCurrentPage" action="{!c.handleValidateCurrentPage}" access="PUBLIC"/>
    <aura:attribute name="countyPlanRec" type="T_COUNTY_PLAN__c"
                    default="{'sobjectType':'T_COUNTY_PLAN__c'}"/>
    <aura:attribute name="fieldValidationErrors" type="List"/>
    <aura:attribute name="countyId" type="String" />
    <aura:handler name="change" value="{!v.fieldValidationErrors}" action="{!c.handleFieldLevelValidation}"/>
    <aura:attribute name="recordError" type="String" />
    <aura:handler name="change" value="{!v.countyPlanRec.PI_Q7__c}" action="{!c.handleSetRequired}"/>
    <aura:handler name="change" value="{!v.countyPlanRec.PI_Q14__c}" action="{!c.handleSetRequired}"/>
    <aura:handler name="change" value="{!v.countyPlanRec.PI_Q11__c}" action="{!c.handleSetRequired}"/>
    <aura:handler name="change" value="{!v.countyPlanRec.PI_Q3_1_new__c}" action="{!c.handleSetRequired}"/>
    <aura:handler name="change" value="{!v.countyPlanRec.PI_Q4_1_new__c}" action="{!c.handleSetRequired}"/>
    <aura:handler name="change" value="{!v.countyPlanRec.PI_Q5_new__c}" action="{!c.handleSetRequired}"/>
    <aura:handler name="change" value="{!v.countyPlanRec.PI_Q7_new__c}" action="{!c.handleSetRequired}"/>
    <aura:handler name="change" value="{!v.countyPlanRec.PI_Q9_new__c}" action="{!c.handleSetRequired}"/>
    <aura:handler name="change" value="{!v.countyPlanRec.PI_Q10_new__c}" action="{!c.handleSetRequired}"/>
    <aura:handler name="change" value="{!v.countyPlanRec.PI_Q11_1_new__c}" action="{!c.handleSetRequired}"/>
    <aura:handler name="change" value="{!v.countyPlanRec.PI_Q13_new__c}" action="{!c.handleSetRequired}"/>

    <aura:attribute name="isQ23Required" type="boolean" default="false"/>
    <aura:attribute name="isQ24Required" type="boolean" default="false"/>
    <aura:attribute name="isQ25Required" type="boolean" default="false"/>
    <aura:attribute name="isQ26Required" type="boolean" default="false"/>
    <aura:attribute name="isQ11_1Required" type="boolean" default="false"/>
    <aura:attribute name="isQ11_2Required" type="boolean" default="false"/>
    <aura:attribute name="isQ11_3Required" type="boolean" default="false"/>
    <aura:attribute name="isQ11_4Required" type="boolean" default="false"/>
    <aura:attribute name="isQ3OtherReq" type="boolean" default="false"/>
    <aura:attribute name="isQ4OtherReq" type="boolean" default="false"/>
    <aura:attribute name="isQ5OtherReq" type="boolean" default="false"/>
    <aura:attribute name="isQ7OtherReq" type="boolean" default="false"/>
    <aura:attribute name="isQ9OtherReq" type="boolean" default="false"/>
    <aura:attribute name="isQ10OtherReq" type="boolean" default="false"/>
    <aura:attribute name="isQ11OtherRequired" type="boolean" default="false"/>
    <aura:attribute name="isQ13OtherRequired" type="boolean" default="false"/>

    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    <!--RY: Commented below section as part of CCCAP-7693 -->
