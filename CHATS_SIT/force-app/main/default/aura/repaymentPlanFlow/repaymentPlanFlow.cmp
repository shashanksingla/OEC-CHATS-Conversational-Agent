<!--
Author      :	Rishav Maji
Description :	Container component for provider's Repayment Plan new and edit flow
JIRA Id     :	CCCAP-5785
-->
<aura:component Controller="repaymentPlanFlowApexController" extends="c:abstractComponent" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickAction,lightning:actionOverride" access="global" >
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:handler name="change" value="{!v.messageType}" action="{!c.handleError}"/>
    
    <aura:set attribute="pageMessages" value="{!v.recordError}"/>
    <aura:set attribute="messageType" value="{!v.message}"/>
    
    <aura:attribute name="recordId" type="String"/>
    <aura:attribute name="parentObjId" type="String"/>
    <aura:attribute name="parentObjName" type="String"/>
    <aura:attribute name="sObjName" type="String"/>
    <aura:attribute name="recordError" type="List"/>
    <aura:attribute name="message" type="String"/>
    <aura:attribute name="repaymentPlanObj" type="T_PMT_PLAN__c" default="{'sobjectType':'T_PMT_PLAN__c',
                                                                          'IND_ACTIVE__c':'',
                                                                          'AMT_PLAN_PMT__c':'',
                                                                          'IDN_PROVR__c':'',
                                                                          'CDE_COUNTY__c':''}"/>
    <aura:attribute name="assignedCounties" type="List" default="[]"/>
    <aura:attribute name="allowedCounties" type="List" default="[]"/>
    <aura:attribute name="isAdmin" type="Boolean" default="false"/>
    
    <c:pageMessages aura:id="recordErrors" pageMessages="{!v.pageMessages}" messageType="{!v.messageType}"/>
    
    <lightning:card>
        <c:repaymentPlanFlow_Layout aura:id="repaymentPlanRecord" 
                                 recordId="{!v.recordId}"
                                 repaymentPlanObj="{!v.repaymentPlanObj}"
                                 isCurrentPageValid="{!v.isCurrentPageValid}"
                                 fieldValidationErrors="{!v.fieldValidationErrors}"
                                 sObjName="{!v.sObjName}"
                                 parentObjId="{!v.parentObjId}"
                                 parentObjName="{!v.parentObjName}"
                                 assignedCounties="{!v.assignedCounties}"/>
    </lightning:card>
    
    <div class="slds-modal__footer">
        <c:navigationComponent onFinish="{!c.doFinish}"
                               onCancel="{!c.doCancel}"
                               finishLabel="Save"
                               showNext="false"
                               showFinish="true"/>
    </div>
    
    <c:confirmationModal aura:id="confirmationModalOnFinish" confirmModalYes="{!c.comfirmFinish}"
                         confirmMsg="Are you sure you want to create a Repayment Plan for the county selected?"/>
</aura:component>