<aura:component controller="viewPeakApplnPdfController"
                extends="c:abstractComponent"
                implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickAction" access="global">
    <aura:attribute name="recordId" type="Id" />
    <aura:attribute name="toggleSpinner" type="boolean" default="false"/>
    <aura:attribute name="navigationCheck" type="boolean" default="false"/>
    <aura:attribute name="msgOnDiffOwnerCounty" type="string" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    <!-- LOADING GIF -->
    <aura:if isTrue="{!v.toggleSpinner}">
        <lightning:spinner variant="brand" size="large"/>
    </aura:if>
    <!-- / LOADING GIF -->
    <c:confirmationModal aura:id="warningModalOnDiffOwnerCounty" 
                             confirmMsg="{!v.msgOnDiffOwnerCounty}"
                             confirmModalYes="{!c.processPeakPDF}" 
                             confirmModalNo="{!c.closeModal}"
                             title="WARNING!"/>
</aura:component>