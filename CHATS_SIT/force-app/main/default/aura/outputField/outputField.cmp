<aura:component >
    <aura:attribute name="hideLabel" type="Boolean" default="false"/>
    <aura:attribute name="label" type="String"/>
    <aura:attribute name="value" type="Object"/>
    <aura:attribute name="updatedValue" type="Object"/>
    <aura:attribute name="type" type="String" default="NONE"/>
    <aura:attribute name="usePlainValue" type="Boolean" default="false"/>
    <aura:attribute name="convertTime" type="Boolean" default="false"/>
    <aura:attribute name="suffix" type="String"/>
    <aura:attribute name="format" type="String"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:if isTrue="{!!v.hideLabel}">
        <div>
            <lightning:formattedText value="{!v.label}" class="slds-form-element__label slds-no-flex"/>
        </div>   
    </aura:if>
    <div>
        <aura:if isTrue="{!v.type=='UIDATE'}">
            <ui:outputDate value="{!v.value}" format="MM/dd/yyyy"/> 
        </aura:if>
        <aura:if isTrue="{!v.usePlainValue==true}">
            <lightning:formattedText value="{!v.value}"/>
            <aura:set attribute="else">
                <aura:if isTrue="{!v.type=='DATE'}">
                    <aura:if isTrue="{!v.convertTime==true}">
                        <ui:outputText value="{!v.updatedValue}"/>
                        <aura:set attribute="else">
                            <lightning:formattedDateTime value="{!v.value}" year="numeric" month="numeric" day="numeric"/>
                        </aura:set>                    
                    </aura:if>
                </aura:if>
                <aura:if isTrue="{!v.type=='NONE' || v.type=='STRING' || v.type=='EMAIL' || v.type=='PHONE'}">
                    <lightning:formattedText value="{!v.value}"/>
                </aura:if>
                <aura:if isTrue="{!v.type=='DECIMAL' || v.type=='DOUBLE'}">
                    <ui:outputText value="{!v.updatedValue}"/>
                </aura:if>
                <aura:if isTrue="{!v.type=='CURRENCY'}">
                    <ui:outputCurrency aura:id="amount" value="{!v.value}" format="{!v.format}"/>
                </aura:if>
            </aura:set>
        </aura:if>
    </div>
</aura:component>