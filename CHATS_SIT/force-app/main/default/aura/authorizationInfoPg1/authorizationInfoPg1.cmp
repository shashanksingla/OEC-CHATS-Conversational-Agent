                                             required="{!v.isCreate == 'true'?true:false}"
                                             type="number" name="Friday" step="1"
                                             min="0" max="24"
                                             value="{!v.hoursPerWeekDay[5].CNT_HOUR_CARE__c}" label=""
                                             disabled="{!v.isReadOnly}"/>
                        </th>
                        <th scope="row" data-label="Saturday">
                            <lightning:input aura:id="input-field"
                                             required="{!v.isCreate == 'true'?true:false}"
                                             type="number" name="Saturday" step="1"
                                             min="0" max="24"
                                             value="{!v.hoursPerWeekDay[6].CNT_HOUR_CARE__c}" label=""
                                             disabled="{!v.isReadOnly}"/>
