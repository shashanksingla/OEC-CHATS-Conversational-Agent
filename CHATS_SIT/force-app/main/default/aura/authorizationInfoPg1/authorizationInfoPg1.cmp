                                             required="{!v.isCreate == 'true'?true:false}"
                                             type="number" name="Sunday" step="1"
                                             min="0" max="24"
                                             value="{!v.hoursPerWeekDay[0].CNT_HOUR_CARE__c}" label=""
                                             disabled="{!v.isReadOnly}"/>
                        </th>
                    </tr>
                    <tr>
