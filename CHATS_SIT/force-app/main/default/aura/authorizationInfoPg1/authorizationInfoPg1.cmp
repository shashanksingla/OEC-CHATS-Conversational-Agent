                                             required="{!v.isCreate == 'true'?true:false}" 
                                             type="number" name="Monday" step="1"
                                             min="0" max="24"
                                             value="{!v.hoursPerWeekDay[1].CNT_HOUR_CARE__c}" label=""
                                             disabled="{!v.isReadOnly}"/>
                        </th>
                        <th scope="row" data-label="Tuesday">
                            <lightning:input aura:id="input-field" 
                                             required="{!v.isCreate == 'true'?true:false}" 
                                             type="number" name="Tuesday" step="1"
                                             min="0" max="24"
                                             value="{!v.hoursPerWeekDay[2].CNT_HOUR_CARE__c}"
                                             label=""
                                             disabled="{!v.isReadOnly}"/>
                        </th>
                        <th scope="row" data-label="Wednesday">
