                                             object="T_AUTH_ENCMBR__c"
                                             field="CDE_TYPE_UNIT_CARE__c"/>
                                <aura:set attribute="else">
							-->
                            <lightning:select aura:id="rate5" name="select" label="" required="{!v.isCreate == 'true'?true:false}" value="{!v.hoursPerWeekDay[4].CDE_TYPE_UNIT_CARE__c}" messageWhenValueMissing="Did you forget to select a rate type?" disabled="{!v.isReadOnly}">
                                <option value="--None--" text="--None--"></option>
                                <aura:iteration items="{!v.rateTypeOptions}" var="rate">
