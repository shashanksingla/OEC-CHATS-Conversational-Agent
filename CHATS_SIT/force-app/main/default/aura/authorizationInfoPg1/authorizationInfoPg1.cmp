                            <lightning:select aura:id="rate3" name="select" label="" required="{!v.isCreate == 'true'?true:false}" value="{!v.hoursPerWeekDay[2].CDE_TYPE_UNIT_CARE__c}" messageWhenValueMissing="Did you forget to select a rate type?"
                                              disabled="{!v.isReadOnly}">
                                <option value="--None--" text="--None--"></option>
                                <aura:iteration items="{!v.rateTypeOptions}" var="rate">
                                    <option value="{!rate.value}" text="{!rate.label}"></option>
                                </aura:iteration>
                            </lightning:select>
                        <!--    
                        </aura:set>
                        </aura:if>
						-->
