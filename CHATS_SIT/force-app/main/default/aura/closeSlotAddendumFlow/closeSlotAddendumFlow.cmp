<aura:component implements="force:hasRecordId,force:lightningQuickAction" access="global" extends="c:abstractComponent" controller="DynamicFormGenerationController">
	
<aura:attribute name="slotContractAddendum" type="T_SLOT_CONTRACT_ADDENDUM__c"
                    default="{'sobjectType':'T_SLOT_CONTRACT_ADDENDUM__c',
                             'DTE_END_ADDENDUM__c' : null}"/>
    <aura:attribute name="recordId" type="String"/>
    <aura:attribute name="objectName" type="String" default="T_SLOT_CONTRACT_ADDENDUM__c"/>
    <aura:attribute name="fieldDefinition" type="List[]"/>
    <aura:attribute name="recordError" type="String"/>
    <aura:attribute name="effectiveEndDate" type="Date"/>
    <aura:attribute name="effectiveBeginDate" type="Date"/>
    <aura:attribute name="FAeffectiveEndDate" type="Date"/>
    <aura:attribute name="reasonForClosure" type="String"/>
    <aura:attribute name="effectiveEndDateReadOnly" type="boolean" default="false"/>
    <aura:attribute name="currentTabNumber" type="Integer" default="1"/>
    <aura:attribute name="cancelMsg" type="String"/> 
    <aura:attribute name="fieldNames" type="List" default="['T_SLOT_CONTRACT_ADDENDUM__c.DTE_END_ADDENDUM__c']"/>
    <aura:attribute name="parentId" type="String"/>
    <aura:attribute name="userData" type="Map"/>
    <aura:attribute name="ownerId" type="String"/>
    <aura:attribute name="msgOnDiffOwnerCounty" type="String" default=""/>
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="messageText" type="String" default="Closing the Slot Contract Addendum will also update/delete any related Slot Contract records that are dated beyond the Addendum end date." />
    <aura:attribute name="errorDone" type="boolean" default="false" />
    <c:confirmationModal aura:id="warningMsgModal" 
                         confirmMsg="{!v.messageText}"                             
                         confirmModalNo="{!c.actiononNo}"
                         confirmModalYes="{!c.actionOnYes}"
                         />
    
    <aura:if isTrue="{!!empty(v.recordId)}">
        <force:recordData aura:id="forceRecordCmp"
                          recordId="{!v.recordId}"
                          fields="Id,DTE_BEGIN_ADDENDUM__c,DTE_END_ADDENDUM__c,IDN_FISCAL_AGREEMENT__r.DTE_END_AGRMT__c"
                          mode="EDIT"
                          targetFields="{!v.slotContractAddendum}"
                          targetError="{!v.recordError}" />
        {!v.recordError}
    </aura:if>
    
    <div class="slds-wrap slds-grid">
        <div class="slds-size--3-of-3">
            <lightning:card iconName="standard:event" title="Close Slot Contract Addendum">
                <aura:set attribute="actions">
                    <c:navigationComponent totalTabs="1" 
                                           onFinish="{!c.doFinish}"
                                           onCancel="{!c.doCancel}"
                                           showPrevious="true"/>
                </aura:set>
                <c:pageMessages pageMessages="{!v.pageMessages}" messageType="{!v.messageType}"/>
                <lightning:layout multipleRows="true" horizontalAlign="space">
                    <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                        <c:inputDate aura:id="input-field" label="Slot Contract Addendum End Date"
                                     value="{!v.effectiveEndDate}"/>
                        <c:fieldLevelMessage aura:id="effectiveEndDate"/>
                    </lightning:layoutItem>
                    
                    <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                        <c:inputPicklist label="Reason For Closure" aura:id="input-field"
                                         value="{!v.reasonForClosure}"
                                         object="T_SLOT_CONTRACT_ADDENDUM__c"
                                         field="CDE_REASON_END_ADDENDUM__c"
                                         showNone="false"
                                         required="false"/>
                        <c:fieldLevelMessage aura:id="reasonForClosure"/>
                    </lightning:layoutItem>
                </lightning:layout>
                <c:confirmationModal aura:id="confirmationModalOnCancel_1" 
                                     confirmMsg="Confirm to cancel Close Slot Contract Addendum Flow"
                                     confirmModalYes="{!c.actionOnCancelYesButton}"/>
                <c:confirmationModal aura:id="warningModalOnDiffOwnerCounty" 
                             confirmMsg="{!v.msgOnDiffOwnerCounty}"
                             noLabel="Cancel"
                             confirmModalNo="{!c.actionOnCancelYesButton}"
                             showYesButton="false"
                             title="ERROR!"/>
            </lightning:card>
        </div> 
    </div>
</aura:component>