<aura:component >
    <aura:attribute name="indivEligIdToWrapper" type="Map"/>
    <aura:attribute name="indivEligWrappers" type="List"/>
     <aura:attribute name="returnId" type="String"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <h2 class="slds-section__title slds-p-left--small slds-p-top--small slds-border_top">Individual Eligibility</h2>
	
    <div class="slds-grid slds-wrap slds-p-around--small">
        <table class="slds-table slds-table_bordered slds-size_1-of-4">
            <thead>
                <tr class="slds-text-title_caps">
                    <th scope="col">
                        <div class="slds-truncate" title="individual">Individual</div>
                    </th>
                    <th scope="col">
                        <div class="slds-truncate" title="State ID">State ID</div>
                    </th>
                </tr>
            </thead>
            <tbody>
                <aura:iteration items="{!v.indivEligWrappers}" var="indivEligWrapper">
                    <aura:if isTrue="{!!empty(indivEligWrapper.indivId)}">
                    	<c:individualHistoryRows indivEligWrapper="{!indivEligWrapper}"
                                                 returnId="{!v.returnId}"/>
                    </aura:if>
                    
                                      <!--indiv="{!indivEligWrapper.indiv}"
                                      caseRec="{!v.caseRec}"
                                      caseEligibilityId="{!v.caseEligibility.idn_eligty_fcompsn__c}"
                                      eligibilityRunId="{!v.eligibilityRunId}"
                                      eligConfirmed="{!v.eligConfirmed}"
                                      ineligReasons="{!v.ineligReasons}"/>-->
                </aura:iteration>
            </tbody>
        </table>
    </div>
    
</aura:component>