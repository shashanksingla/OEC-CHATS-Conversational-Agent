<aura:component implements="force:lightningQuickAction,lightning:actionOverride,force:hasRecordId" access="global">
    <aura:attribute name="recordId" type="String"/>
    <aura:attribute name="showLWC" type="Boolean" default="false"/>    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>    
    <aura:if isTrue="{!not(v.showLWC)}">
        <lightning:spinner alternativeText="Loading..." size="medium" class="slds-show"/>
    </aura:if>
    <aura:if isTrue="{!v.showLWC}">
        <c:overrideFiscalAgreementUpsert_lwc recordId="{!v.recordId}" sObjectName="T_PROVR_FISCAL_AGREMENT__c"/>
    </aura:if>
</aura:component>