<aura:component implements="flexipage:availableForAllPageTypes,force:hasRecordId"  extends="c:genericUtilities" controller="OutputRollupSummaryApxCtrl">
    <aura:attribute name="label" type="String"/>
    <aura:attribute name="value" type="String" default="Loading..."/>
    <aura:attribute name="query" type="String"/>
    <aura:attribute name="rollUpFieldAPIName" type="String"/>
    <aura:attribute name="rollupType" type="String" description="COUNT/SUM/MIN/MAX"/>
    <aura:attribute name="areMultipleFields" type="Boolean" default="false"/>
    <aura:attribute name="isAuthObjRec" type="Boolean" default="false"/>
    
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <c:LoadingSpinnerComp spinner="{!v.showSpinner}"/>
    <aura:if isTrue="{!v.areMultipleFields}">
            <div class="slds-form-element">
                <label class="slds-form-element__label" for="{!v.label}">{!v.label}</label>
                <div class="slds-form-element__control">
                    <ui:outputText value="{!v.value}"/>
                </div>
            </div>
        <aura:set attribute="else">
            <lightning:card >
                <p class="slds-p-horizontal_small">
                    <div class="slds-form-element">
                        <label class="slds-form-element__label" for="{!v.label}">{!v.label}</label>
                        <div class="slds-form-element__control">
                            <ui:outputText value="{!v.value}"/>
                        </div>
                    </div>
                </p>
            </lightning:card>
        </aura:set>
    </aura:if>
</aura:component>