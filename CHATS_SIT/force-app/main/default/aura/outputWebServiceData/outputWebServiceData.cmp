<aura:component implements="flexipage:availableForAllPageTypes,force:hasRecordId" controller="CHATSAuraUtility">
    <aura:attribute name="label" type="String"/>
    <aura:attribute name="value" type="String" default="Loading..."/>
    <aura:attribute name="endPoint" type="String"/>
    <aura:attribute name="method" type="String"/>
    <aura:attribute name="requestBody" type="String"/>
    <aura:attribute name="requiredParams" type="List"/>
    <aura:attribute name="areMultipleFields" type="Boolean"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:if isTrue="{!v.areMultipleFields}">
            <div class="slds-form-element">
                <label class="slds-form-element__label" for="{!v.label}">{!v.label}</label>
                <div class="slds-form-element__control">
                    <ui:outputText value="{!v.value}"/>
                </div>
            </div>
        <aura:set attribute="else">
            <lightning:card >
                <p class="slds-p-horizontal_small">
                    <div class="slds-form-element">
                        <label class="slds-form-element__label" for="{!v.label}">{!v.label}</label>
                        <div class="slds-form-element__control">
                            <ui:outputText value="{!v.value}"/>
                        </div>
                    </div>
                </p>
            </lightning:card>
        </aura:set>
    </aura:if>
</aura:component>