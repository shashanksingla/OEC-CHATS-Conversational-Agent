<aura:component controller="countyPlanTemplateController"
                implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickAction" access="global" >
	<aura:attribute name="recordId" type="Id" />
    <aura:attribute name="countyPlan" type="T_COUNTY_PLAN__c" />
    <force:recordData aura:id="recordLoader" recordId="{!v.recordId}"
                      fields="DTE_BEGIN_EFFEV__c,IND_COUNTY_PLAN_TEMPLT__c"
                      targetFields="{!v.countyPlan}"
                      recordUpdated="{!c.doInit}"/>
</aura:component>