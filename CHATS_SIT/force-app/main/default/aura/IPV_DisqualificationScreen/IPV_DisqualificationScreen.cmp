<aura:component implements="force:hasrecordId,force:hasSObjectName,flexipage:availableForRecordHome" extends="c:abstractSection" controller="IPVAllegationAPXCtrl">
    <aura:attribute name="ipvRec" type="IPV_Information__c" default="{}"/>
    <aura:attribute name="recordId" type="String" default=""/>
    <aura:attribute name="recordError" type="String" default=""/>
    <aura:attribute name="endDate" type="Date" default=""/>
    <aura:attribute name="beginDate" type="Date" default=""/>
    <aura:attribute name="lastOccurenceEndDate" type="Date" default=""/>
    <aura:attribute name="occurences" type="String" default=""/>
    <aura:attribute name="lstInvestigatoryFindings" type="List"/>
    <aura:attribute name="mapInvInfoValuetoLabel" type="Map"/>
    <aura:attribute name="mapOccurredValuetoLabel" type="Map"/>
    <aura:attribute name="mapInvInfoLabelToValue" type="Map"/>
    <aura:attribute name="mapOccurredLabelToValue" type="Map"/>
    <aura:attribute name="columns" type="List"/>
    <aura:attribute name="occurencesEdited" type="String" default=""/>
    <aura:attribute name="isReadOnly" type="Boolean" default="false"/>
    <aura:attribute name="isInitialised" type="Boolean" default="false"/>
    <aura:handler name="init" value="{!this}" action="{!c.getInitData}"/>
    <aura:handler name="change" value="{!v.beginDate}" action="{!c.verifyBeginDate}"/>
    <aura:handler name="change" value="{!v.occurencesEdited}" action="{!c.calculateEndDate}"/>
    <aura:handler name="change" value="{!v.ipvRec.Disqualification_determination_Date__c}" action="{!c.verifyDeterminationDate}"/>
    <aura:handler event="c:createInvestigatoryInfo" action="{!c.createInvestigatoryInfo}"/>
    <aura:attribute name="modalInv" type="Aura.Action"/>
    
    <aura:if isTrue="{!!empty(v.recordId)}">
        
        <aura:if isTrue="{!v.isReadOnly}">
            <force:recordData aura:id="forceRecordCmpDis"
                          recordId="{!v.recordId}"
                          fields="Investigation_Status_Date__c,Investigation_Status__c,Investigation_Begin_Date__c,Investigation_End_Date__c, Investigation_Result_Date__c,Investigation_Result_Status__c,Investigation_Created__c,Allegation_Result_Determination_Date__c, Disqualification_determination_Date__c,Disqualification_Begin_Date__c,Disqualification_End_Date__c,Disqualification_Result__c, Disqualification_Created__c,Number_of_occurrences__c,Number_of_CCCAP_Reviews__c,Reversal_Date__c, Reversal_Reason__c, Reversal_Created__c"
                          targetFields="{!v.ipvRec}"
                          mode="VIEW"
                          targetError="{!v.recordError}"/>
            <lightning:card >
                <aura:set attribute="title">
                </aura:set>
                <aura:set attribute="footer">
                </aura:set>
                <aura:set attribute="actions">
                </aura:set>
                <p class="slds-p-horizontal_small">
                    <lightning:accordion class="grey-header-bg" aura:id="accordion" allowMultipleSectionsOpen="true" activeSectionName="DisqualificationInformation">
                        <lightning:accordionSection name="DisqualificationInformation" label="Disqualification Information">
                            <lightning:layout  horizontalAlign="spread" multipleRows="true" class="slds-p_small height-setup">
                                <lightning:layoutItem flexibility="auto" padding="around-small" size="5" class="slds-border_bottom">
                                    <div class="slds-form-element">
                                        <label class="slds-form-element__label" for="Disqualification Result">Disqualification Result</label>
                                        <div class="slds-form-element__control">
                                            <aura:if isTrue="{!!empty(v.ipvRec.Disqualification_Result__c)}">
                                            <c:inputPicklist hideLabel="true"
                                                             value="{!v.ipvRec.Disqualification_Result__c}"
                                                             object="IPV_Information__c"
                                                             field="Disqualification_Result__c"
                                                             type="ReadOnly"/>
                                            </aura:if>                 
                                        </div>
                                    </div>
                                </lightning:layoutItem>
                                <lightning:layoutItem flexibility="auto" padding="around-small" size="5" class="slds-border_bottom">
                                    <div class="slds-form-element">
                                        <label class="slds-form-element__label" for="Disqualification Determination Date">Disqualification Determination Date</label>
                                        <div class="slds-form-element__control">
                                            <ui:outputDate value="{!v.ipvRec.Disqualification_determination_Date__c}" format="M/DD/YYYY" aura:id="Disqualification Determination Date"/>
                                        </div>
                                    </div>
                                </lightning:layoutItem>
                                <lightning:layoutItem flexibility="auto" padding="around-small" size="5" class="slds-border_bottom">
                                    <div class="slds-form-element">
                                        <label class="slds-form-element__label" for="Number of occurrences">Number of occurrences</label>
                                        <div class="slds-form-element__control">
                                            <lightning:formattedText  value="{!v.ipvRec.Number_of_occurrences__c}" aura:id="Number of occurrences"/>
                                        </div>
                                    </div>
                                </lightning:layoutItem>
                                <lightning:layoutItem flexibility="auto" padding="around-small" size="5" class="slds-border_bottom">
                                    <div class="slds-form-element">
                                        <label class="slds-form-element__label" for="Disqualification Begin Date">Disqualification Begin Date</label>
                                        <div class="slds-form-element__control">
                                            <ui:outputDate value="{!v.ipvRec.Disqualification_Begin_Date__c}" format="M/DD/YYYY" aura:id="Disqualification Begin Date"/>
                                        </div>
                                    </div>
                                </lightning:layoutItem>
                                
                                <lightning:layoutItem flexibility="auto" padding="around-small" size="5" class="slds-border_bottom">
                                    <div class="slds-form-element">
                                        <label class="slds-form-element__label" for="Disqualification End Date">Disqualification End Date</label>
                                        <div class="slds-form-element__control">
                                            <ui:outputDate value="{!v.ipvRec.Disqualification_End_Date__c}" format="M/DD/YYYY" aura:id="Disqualification End Date" />
                                        </div>
                                    </div>
                                </lightning:layoutItem>
                                <lightning:layoutItem flexibility="auto" padding="around-small" size="5">
                                    
                                </lightning:layoutItem>
                                
                            </lightning:layout>
                        </lightning:accordionSection>
                    </lightning:accordion>
                </p>
            </lightning:card>
            <aura:set attribute="else">
                <force:recordData aura:id="forceRecordCmpDis"
                          recordId="{!v.recordId}"
                          fields="Disqualification_determination_Date__c,Disqualification_Begin_Date__c,Disqualification_End_Date__c,Disqualification_Result__c,Disqualification_Created__c,Number_of_occurrences__c,Investigation_Status__c,Number_of_CCCAP_Reviews__c"
                          targetFields="{!v.ipvRec}"
                          mode="EDIT"
                          targetError="{!v.recordError}"/>
                <lightning:layout  horizontalAlign="spread" multipleRows="true" class="slds-p_small height-setup">
                    <lightning:layoutItem flexibility="auto" padding="around-small" size="5">
                        <div class="slds-form-element">
                            <c:inputPicklist label="Disqualification Result" aura:id="input-field"
                                             value="{!v.ipvRec.Disqualification_Result__c}"
                                             object="IPV_Information__c"
                                             field="Disqualification_Result__c"
                                             showNone="true"
                                             required="true"/>
                            <c:fieldLevelMessage aura:id="IPV_Information__c-Disqualification_Result__c"/>
                        </div>
                    </lightning:layoutItem>
                    <lightning:layoutItem flexibility="auto" padding="around-small" size="5">
                        <div class="slds-form-element">
                            <c:inputDate aura:id="input-field" label="Disqualification Determination Date"
                                         value="{!v.ipvRec.Disqualification_determination_Date__c}" required="{!v.ipvRec.Disqualification_Result__c!='4'}" />
                            <c:fieldLevelMessage aura:id="IPV_Information__c-Disqualification_determination_Date__c"/>
                        </div>
                    </lightning:layoutItem>
                    <lightning:layoutItem flexibility="auto" padding="around-small" size="5">
                        <div class="slds-form-element">
                            <aura:if isTrue="{!v.occurences =='1' &amp;&amp; v.ipvRec.Disqualification_Created__c==false}">
                                <c:inputPicklist label="Number of occurences" aura:id="input-field"
                                                 value="{!v.occurencesEdited}"
                                                 object="IPV_Information__c"
                                                 field="Number_of_occurrences__c"
                                                 showNone="true"
                                                 required="{!v.ipvRec.Disqualification_Result__c=='4'?false:true}"
                                                 disabled="{!v.ipvRec.Disqualification_Result__c=='4'?true:false}"/>
                                <c:fieldLevelMessage aura:id="IPV_Information__c-Number_of_occurrences__c"/>
                                <aura:set attribute="else">
                                    <div class="slds-form-element">
                                        <label class="slds-form-element__label" for="Number of occurences">Number of occurences</label>
                                        <div class="slds-form-element__control">
                                            <lightning:formattedText  value="{!v.occurencesEdited}"/>
                                        </div>
                                    </div>
                                </aura:set>
                            </aura:if>
                        </div>
                    </lightning:layoutItem>
                    <lightning:layoutItem flexibility="auto" padding="around-small" size="5">
                        <div class="slds-form-element">
                            <c:inputDate aura:id="input-field" label="Disqualification Begin Date"
                                         value="{!v.beginDate}" required="{!v.ipvRec.Disqualification_Result__c=='4'?false:true}" disabled="{!v.ipvRec.Disqualification_Result__c=='4'?true:false}"/>
                            <c:fieldLevelMessage aura:id="IPV_Information__c-Disqualification_Begin_Date__c"/>
                        </div>
                    </lightning:layoutItem>
                    <lightning:layoutItem flexibility="auto" padding="around-small" size="5">
                        <div class="slds-form-element">
                            <label class="slds-form-element__label" for="Disqualification End Date">Disqualification End Date</label>
                            <div class="slds-form-element__control">
                                &nbsp;&nbsp;&nbsp;<ui:outputDate value="{!v.endDate}" format="MM/DD/YYYY" aura:id="Disqualification End Date" />
                            </div>
                            <c:fieldLevelMessage aura:id="IPV_Information__c-Disqualification_End_Date__c"/>
                        </div>
                    </lightning:layoutItem>
                    <lightning:layoutItem flexibility="auto" padding="around-small" size="5" >
                    </lightning:layoutItem>
                    <lightning:layoutItem flexibility="auto" padding="around-small" size="5" >
                        
                        <lightning:layoutItem flexibility="auto" padding="around-small" size="5" >
                            <lightning:button label="Save" variant="brand" onclick="{!c.handleSaveRecord}" />
                            <lightning:button label="Cancel" variant="brand" onclick="{!c.handleCancel}" />
                        </lightning:layoutItem>
                    </lightning:layoutItem>
                    <lightning:layoutItem flexibility="auto" padding="around-small" size="5" >
                    </lightning:layoutItem>
                    <lightning:layoutItem flexibility="auto" padding="around-small" size="5" >
                        <lightning:button label="Create Investigatory Finding" variant="brand" onclick="{!c.createInvestigatoryFinding}"/>
                    </lightning:layoutItem>
                </lightning:layout>
            </aura:set>
        </aura:if>
        <lightning:overlayLibrary aura:id="overlayLib"/>
        <div class="slds-p-horizontal_small slds-m-top--large">
            <lightning:datatable data="{!v.lstInvestigatoryFindings}"
                                     columns="{!v.columns}"
                                     keyField="id"
                                     onrowselection="{! c.getSelectedName }"
                                     onrowaction="{!c.handleRowAction}"
                                     hideCheckboxColumn="true"
                                     wrapTextMaxLines="2"/>
        </div>
    </aura:if>
</aura:component>