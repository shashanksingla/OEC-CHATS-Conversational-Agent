<aura:component >
    <aura:attribute name="caseRec" type="T_SBSD_CASE__c"/>
    <aura:attribute name="caseEligibility" type="batchsit_t_fcompsn_eligty__x"/>
    <aura:attribute name="caseEligibilityRun" type="batchsit_t_eligty_run__x"/>
    <aura:attribute name="caseEligibilityDetails" type="batchsit_t_fcompsn_eligty_detail__x"/>
    <aura:attribute name="indivEligIdToWrapper" type="Map"/>
    <aura:attribute name="householdIneligibilityFailure" type="batchsit_t_fcompsn_failr__x[]"/>  
    <aura:attribute name="showOverrideButton" type="Boolean" default="true"/>
    <lightning:overlayLibrary aura:id="overlayLib"/>
    <tr>
        <td>
            <div class="slds-truncate" title="Program">
                <c:inputPicklist hideLabel="true"
                                 value="{!v.caseEligibility.cde_prog__c}"
                                 object="Field_Utility__c"
                                 field="R00373__c"
                                 type="ReadOnly"
                                />            
            </div>
        </td>
        <td>
            <div class="slds-truncate" title="Eligibility Begin Date"><c:outputField label="Eligibility Begin Date" value="{!v.caseEligibilityDetails.dte_begin_effv__c}" type="UIDATE" hideLabel="true"/></div>
        </td>
        <td>
            <div class="slds-truncate" title="Eligibility End Date"><c:outputField label="Eligibility Begin Date" value="{!v.caseEligibilityDetails.dte_end_effv__c}" type="UIDATE" hideLabel="true"/></div>
        </td>
        <td>
            <div class="slds-truncate" title="Eligibility Status">
                <c:inputPicklist hideLabel="true"
                             value="{!v.caseEligibilityDetails.cde_status_eligty_family__c}"
                             object="Field_Utility__c"
                             field="R00376__c"
                             type="ReadOnly"
                             />
            </div>
        </td>
        <td>
            <div class="slds-truncate" title="Override Reason">
            	<c:inputPicklist hideLabel="true"
                	             value="{!empty(v.caseEligibilityDetails.dte_end_effv__c)? v.caseEligibility.cde_reason_ovrd__c : ''}"
                    	         object="Field_Utility__c"
                        	     field="R00375__c"
                            	 type="ReadOnly"
                                 />
            </div>
        </td>
        <td>
            <div class="slds-cell-wrap" title="Override Comment"><c:outputField label="Override Comments" value="{!empty(v.caseEligibilityDetails.dte_end_effv__c)? v.caseEligibility.txt_cmt_ovrd__c : ''}" type="STRING" hideLabel="true"/></div>
        </td>

    </tr>
    
     <!--
    <lightning:layout multipleRows="true" horizontalAlign="space">
       
        <lightning:layoutItem flexibility="auto" size="12" padding="around-small">
            <lightning:layoutItem flexibility="auto" size="6" >
