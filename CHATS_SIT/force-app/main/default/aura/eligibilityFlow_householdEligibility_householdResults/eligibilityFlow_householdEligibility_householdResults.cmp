                                 value="{!v.caseEligibility.cde_prog__c}"
                                 object="Field_Utility__c"
                                 field="R00373__c"
                                 type="ReadOnly"
                                 />
            </lightning:layoutItem>
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
            <c:outputField label="Run Date"
                           value="{!v.caseEligibilityRun.dte_run_eligty__c}" type="DATE"/>
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
            <c:outputField label="Eligibility Begin Date"
                           value="{!v.caseEligibilityDetails.dte_begin_effv__c}" type="DATE"/>
