<aura:component >
    <aura:attribute name="householdIneligibilityFailure" type="batchsit_t_fcompsn_failr__x[]"/> 
    <aura:attribute name="householdEligibilityId" type="String"/>
    <aura:attribute name="caseRec" type="T_SBSD_CASE__c"/>
    <aura:attribute name="eligConfirmed" type="Boolean" default="false"/>
    <aura:attribute name="ineligReasons" type="T_INELIG_REASON__c[]"/>
    
    <h2 class="slds-section__title slds-p-left--small slds-p-top--small slds-border_top">Household Ineligibility Reasons</h2>
    <div class="slds-p-top--small">
        <aura:iteration items="{!v.householdIneligibilityFailure}" var="eachFailrReason">
            <p class="slds-p-left--large slds-p-bottom--small">
                <c:inputPicklist value="{!eachFailrReason.cde_reason_failr_fcompsn__c}"
                                 object="Field_Utility__c"
                                 field="R00378__c"
                                 type="ReadOnly"
                                 hideLabel="true"
                                 />
            </p>
        </aura:iteration>
    </div>
    <lightning:layout >
        <lightning:overlayLibrary aura:id="overlayLib"/>
        <aura:if isTrue="{!!v.eligConfirmed}">
            <lightning:layoutItem flexibility="auto" size="1" padding="around-small">
                <lightning:button label="Update" onclick="{!c.showIneligibilityReasons}" variant="brand"/>    
            </lightning:layoutItem>
        </aura:if>
        <lightning:layoutItem flexibility="auto" size="11" padding="around-small"></lightning:layoutItem>
    </lightning:layout>
</aura:component>