            </aura:if>
            <aura:if isTrue="{!v.countyRatePlanRec.RT_Q8_6__c =='2'}">
                <lightning:layoutItem flexibility="auto" padding="around-small" size="6">                
                    <lightning:textarea name="input-name" label="Explain the method your county used to determine the Evening rates."
                                        value="{!v.countyRatePlanRec.RT_Q2_d__c}" required="{!v.countyRatePlanRec.RT_Q8_6__c =='2' ?true:false}"
                                        aura:id="input-field"/>
                    <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-RT_Q2_d__c"/>
                </lightning:layoutItem>
            </aura:if>
        </aura:if>
        <aura:if isTrue="{!!v.isRT_Q2_eReadOnly}"  >
            <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                <c:inputPicklist label="8.7 Please explain how your county determined the reimbursement rate for Disability Care." aura:id="input-field"
                                value="{!v.countyRatePlanRec.RT_Q8_7__c}"
                                object="T_COUNTY_RATE__c"
                                field="RT_Q8_7__c"
                                showNone="true"
                                required="{!!v.isRT_Q2ReadOnly}"/>
                <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-RT_Q8_7__c"/>
                <lightning:helptext content="When Percent of the State-Established Regular Rate for each age band is selected, the system will auto populate rates using the percentage entered. Other Method, not to include a percentage of the State-Established Regular Rate for each age band, the county will manually enter rate fields for each age band."/>
            </lightning:layoutItem>
            <aura:if isTrue="{!v.countyRatePlanRec.RT_Q8_7__c =='1'}">
                <lightning:layoutItem flexibility="auto" padding="around-small" size="6">                
                    <lightning:input type="number" label="Please enter the percentage of the State-Established Regular Rate for Disability."
                                        min="125" max="200" messageWhenRangeOverflow="{!v.incorrectPercent}" messageWhenRangeUnderflow="{!v.incorrectPercent}"
                                        value="{!v.countyRatePlanRec.RT_Q8_7P__c}" required="{!v.countyRatePlanRec.RT_Q8_7__c =='1' ?true:false}"
                                        fieldLevelHelp="Allowed percentage from 125% to 200% of Full Time School Age Level 1 State-Established rate. Please select Other if county chooses to enter rates outside of this range."
                                        aura:id="input-field"/>
                    <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-RT_Q8_7P__c"/>                
                </lightning:layoutItem>
            </aura:if>
            <aura:if isTrue="{!v.countyRatePlanRec.RT_Q8_7__c =='2'}">
                <lightning:layoutItem flexibility="auto" padding="around-small" size="6">                
                    <lightning:textarea name="input-name" label="Explain the method your county used to determine the Disability rates."
                                        value="{!v.countyRatePlanRec.RT_Q2_e__c}" required="{!v.countyRatePlanRec.RT_Q8_7__c =='2' ?true:false}"
                                        aura:id="input-field"/>
                    <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-RT_Q2_e__c"/>                
                </lightning:layoutItem>
            </aura:if>
        </aura:if>
        <aura:if isTrue="{!v.disabilityIncluded}">
            <aura:if isTrue="{!v.isDateAfter_Mar2025}">
                <lightning:layoutItem flexibility="auto" padding="around-small" size="6">             
                    <lightning:textarea name="input-name" label="List the title of the role responsible for approving the use of disability in your county"
                                        value="{!v.countyRatePlanRec.RT_Q1__c}" required="{!v.disabilityIncluded}"
                                        aura:id="input-field"/>     
                    <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-RT_Q1__c"/>     
                </lightning:layoutItem>
                <lightning:layoutItem flexibility="auto" padding="around-small" size="6">             
                    <lightning:textarea name="input-name" label="How does the county ensure that the provider can meet the child's additional care needs to be approved to be paid the disability rate? 
                                        The county must accept: 
                                        ● Child Eligibility: individual health care plan (IHCP), individual
                                        education plan (IEP), physician’s/professional’s statement,
                                        child welfare, or individualized family service plan (IFSP)
                                        ● Provider Eligibility: provider-created individualized care plan
                                        (ICP) for children with additional care needs based upon the
                                        Individual Education Plan (IEP), or Individual Health Care Plan
                                        (IHCP)"
                                        value="{!v.countyRatePlanRec.RT_Q1_1__c}" required="{!v.disabilityIncluded}"
                                        aura:id="input-field"/>
                    <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-RT_Q1_1__c"/>     
                </lightning:layoutItem>
                <aura:set attribute="else">
                    <lightning:layoutItem flexibility="auto" padding="around-small" size="6">             
                        <lightning:textarea name="input-name" label="Please indicate how your county determines if a provider will be reimbursed for this additional care rate."
                                            value="{!v.countyRatePlanRec.RT_Q1__c}" required="{!v.disabilityIncluded}"
                                            aura:id="input-field"/>     
                        <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-RT_Q1__c"/>     
                    </lightning:layoutItem>
                </aura:set>
            </aura:if>
        </aura:if>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <br></br>
        </lightning:layoutItem>
        <aura:if isTrue="{!!v.isRT_Q2_fReadOnly}"  >
            <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                <c:inputPicklist label="8.8 Please explain how your county determined the reimbursement rate for Out of County Care." aura:id="input-field"
                                value="{!v.countyRatePlanRec.RT_Q8_8__c}"
                                object="T_COUNTY_RATE__c"
                                field="RT_Q8_8__c"
                                showNone="true"
                                required="{!!v.isRT_Q2ReadOnly}"/>
                <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-RT_Q8_8__c"/>
                <lightning:helptext content="When Percent of the State-Established Regular Rate for each age band is selected, the system will auto populate rates using the percentage entered. Other Method, not to include a percentage of the State-Established Regular Rate for each age band, the county will manually enter rate fields for each age band."/>
            </lightning:layoutItem>
            <aura:if isTrue="{!v.countyRatePlanRec.RT_Q8_8__c =='1'}">
                <lightning:layoutItem flexibility="auto" padding="around-small" size="6">                
                    <lightning:input type="number" label="Please enter the percentage of the State-Established Regular Rate for Out of County care."
                                        min="101" max="200" messageWhenRangeOverflow="{!v.incorrectPercent}" messageWhenRangeUnderflow="{!v.incorrectPercent}"
                                        value="{!v.countyRatePlanRec.RT_Q8_8P__c}" required="{!v.countyRatePlanRec.RT_Q8_8__c =='1' ?true:false}"
                                        fieldLevelHelp="Allowed percentage from 101% to 200% of Full Time School Age Level 1 State-Established rate.  Please select Other if county chooses to enter rates outside of this range."
                                        aura:id="input-field"/>
                    <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-RT_Q8_8P__c"/>                
                </lightning:layoutItem>
            </aura:if>
            <aura:if isTrue="{!v.countyRatePlanRec.RT_Q8_8__c =='2'}">
                <lightning:layoutItem flexibility="auto" padding="around-small" size="6">                
                    <lightning:textarea name="input-name" label="Explain the method your county used to determine the Out of County rates."
                                        value="{!v.countyRatePlanRec.RT_Q2_f__c}" required="{!v.countyRatePlanRec.RT_Q8_8__c =='2' ?true:false}"
                                        aura:id="input-field"/>
                    <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-RT_Q2_f__c"/>                
                </lightning:layoutItem>
            </aura:if>
        </aura:if>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="12">
        </lightning:layoutItem>
        <aura:if isTrue="{!v.isDateAfter_Mar2025}">
            <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
                <lightning:textarea name="input-name" label="9. Understanding that Qualified Exempt Provider Rates should not
                                        exceed 75% of tier 1 licensed home provider rates for corresponding
                                        age bands, please explain how your county determined the
                                        reimbursement rate for Qualified Exempt Providers. If the rate is based
                                        on the Regular, please explain how the county calculated the rates for
                                        Qualified Exempt Providers.
                                        ● (ex: _________ County will be maintaining rates from
                                        xx-xx-xxxx and will ensure that the rate is not higher than 75% of
                                        the quality Tier 1 rate for licensed home providers at the
                                        youngest age band OR
                                        ● ___________County determined the Qualified Exempt Rate by
                                        ______ to ensure that the rate is not higher than 75% of the
                                        quality Tier 1 rate for licensed home providers at the youngest
                                        age band and that it will not deter Qualified Exempt providers
                                        from becoming licensed."
                                        value="{!v.countyRatePlanRec.RT_Q2_g__c}" required="true"
                                        aura:id="input-field"/>
                    <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-RT_Q2_g__c"/>    
            </lightning:layoutItem>
            <aura:set attribute="else">
                <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
                    <lightning:textarea name="input-name" label="9. Please explain how your county determined the reimbursement rate for Qualified Exempt Providers"
                                    value="{!v.countyRatePlanRec.RT_Q2_g__c}" required="true"
                                    aura:id="input-field"/>
                    <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-RT_Q2_g__c"/>
                </lightning:layoutItem>
                <lightning:helptext content="When Percent of the State-Established Regular Rate for each age band is selected, the system will auto populate rates using the percentage entered. Other Method, not to include a percentage of the State-Established Regular Rate for each age band, the county will manually enter rate fields for each age band."/>
            </aura:set>
        </aura:if>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="12">
        </lightning:layoutItem>
        
        <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
            <c:inputRadioGroupForPicklist label="10. Does your county have a county owned facility?" aura:id="input-field"
                                          value="{!v.countyRatePlanRec.PAYMENT_Q15_1__c}" 
                                          object="T_COUNTY_RATE__c"
                                          field="PAYMENT_Q15_1__c" required="true" isfullSize="true"/>
            <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-PAYMENT_Q15_1__c"/>
        </lightning:layoutItem>
        <aura:if isTrue="{!v.countyRatePlanRec.PAYMENT_Q15_1__c =='Y'}">
            <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                <lightning:textarea name="input-name" label="10.1 What is your county's policy for maintaining arms length with a county-owned facility?"
                                    value="{!v.countyRatePlanRec.PAYMENT_Q15__c}" required="{!v.countyRatePlanRec.PAYMENT_Q15_1__c =='Y' ?true:false}"
                                    aura:id="input-field"/>
                <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-PAYMENT_Q15__c"/>       
            </lightning:layoutItem>
        </aura:if>
        <aura:if isTrue="{!v.isDateAfter_Mar2025}">
            <lightning:layoutItem flexibility="auto" size="12" padding="around-small">
                <c:inputMultiSelectCombobox label="11. Understanding that CHATS functionality allows a new rate schedule to be entered in CHATS as of the first of a future month, how does your county adjust existing Provider Rates when a Provider reports a change to their Private Pay Rates?" aura:id="input-field"
                                            value="{!v.countyRatePlanRec.PAYMENT_Q16__c}"
                                            object="T_COUNTY_RATE__c"
                                            field="PAYMENT_Q16__c"
                                            required="true"/>
                <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-PAYMENT_Q16__c"/>
            </lightning:layoutItem>
            <aura:set attribute="else">
                <lightning:layoutItem flexibility="auto" size="12" padding="around-small">
                    <c:inputMultiSelectCombobox label="11. How does your county adjust existing Provider Rates when a Provider reports a change to their Private Pay Rates?" aura:id="input-field"
                                                value="{!v.countyRatePlanRec.PAYMENT_Q16__c}"
                                                object="T_COUNTY_RATE__c"
                                                field="PAYMENT_Q16__c"
                                                required="true"/>
                    <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-PAYMENT_Q16__c"/>
                </lightning:layoutItem>
            </aura:set>
        </aura:if>

    </lightning:layout>
    <lightning:layout multipleRows="true">        
        <lightning:layoutItem flexibility="auto" padding="around-small" size="12">
            <aura:if isTrue="{!v.isDateAfter_Mar2025}">
                <h3 class="slds-section__title"><B>Attendance Tracking System Policy: Non-cooperation of the Attendance Tracking System (ATS) for Providers</B></h3>
                <aura:set attribute="else">
                    <h3 class="slds-section__title"><B>Attendance Tracking System</B></h3>
                </aura:set>
            </aura:if>
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <aura:if isTrue="{!v.isDateAfter_Mar2025}">
                <c:inputMultiSelectCombobox label="12. Whats ATS information/ resources are provided to CCCAP Providers?" aura:id="input-field"
                                value="{!v.countyRatePlanRec.PAYMENT_Q17_1_1__c}"
                                object="T_COUNTY_RATE__c"
                                field="PAYMENT_Q17_1_1__c"
                                required="true"/>    
                <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-PAYMENT_Q17_1_1__c"/>
                <aura:set attribute="else">
                    <lightning:textarea name="input-name" label="12. Briefly describe your county policy regarding non-cooperation of the Attendance Tracking System (ATS) for providers?"
                                value="{!v.countyRatePlanRec.PAYMENT_Q17_1__c}" required="true"
                                aura:id="input-field"/>
                    <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-PAYMENT_Q17_1__c"/> 
                </aura:set>
            </aura:if>                        
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <aura:if isTrue="{!v.isDateAfter_Mar2025}">
                    <c:inputMultiSelectCombobox label="12.1 What actions does your county take to support providers prior to determining that non-cooperation of ATS (refusal to use ATS at all) has occurred?" aura:id="input-field"
                                        value="{!v.countyRatePlanRec.PAYMENT_Q17_2__c}"
                                        object="T_COUNTY_RATE__c"
                                        field="PAYMENT_Q17_2__c"
                                        required="true"/>    
                    <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-PAYMENT_Q17_2__c"/>
                <aura:set attribute="else">
                    <c:inputMultiSelectCombobox label="12.1 What actions does your county take to support providers prior to determining non-cooperation of ATS has occurred?" aura:id="input-field"
                                        value="{!v.countyRatePlanRec.PAYMENT_Q17_2__c}"
                                        object="T_COUNTY_RATE__c"
                                        field="PAYMENT_Q17_2__c"
                                        required="true"/>    
                    <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-PAYMENT_Q17_2__c"/>
                </aura:set>
            </aura:if>
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
            <c:inputPicklist label="12.2 Does your county close Fiscal Agreements with providers when it has been determined that non-cooperation of ATS has occurred?" aura:id="input-field"
                             value="{!v.countyRatePlanRec.PAYMENT_Q17_3__c}"
                             object="T_COUNTY_RATE__c"
                             field="PAYMENT_Q17_3__c"
                             showNone="true"
                             required="true"/>
            <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-PAYMENT_Q17_3__c"/>
        </lightning:layoutItem>
        <aura:if isTrue="{!v.isDateAfter_Mar2025}">
            <aura:if isTrue="{!v.countyRatePlanRec.PAYMENT_Q17_3__c =='N'}">
                <lightning:layoutItem flexibility="auto" padding="around-small" size="6">                
                    <lightning:textarea name="input-name" label="If no, what action is taken if provider non-cooperation (refusal to use ATS at all) continues?"
                                        value="{!v.countyRatePlanRec.PAYMENT_Q17_3_1__c}" required="{!v.countyRatePlanRec.PAYMENT_Q17_3__c =='N' ?true:false}"
                                        aura:id="input-field"/>
                    <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-PAYMENT_Q17_3_1__c"/>                
                </lightning:layoutItem>
            </aura:if>
        </aura:if>
        <lightning:layoutItem flexibility="auto" size="12" padding="around-small">
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputMultiSelectCombobox label="12.3 How does your county issue provider correspondences?" aura:id="input-field"
                                        value="{!v.countyRatePlanRec.PAYMENT_Q17_4__c}"
                                        object="T_COUNTY_RATE__c"
                                        field="PAYMENT_Q17_4__c"
                                        required="true"/>
            <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-PAYMENT_Q17_4__c"/>
        </lightning:layoutItem>
        <aura:if isTrue="{!v.isPAYMENT_Q17_OtherRequired}">
            <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
                <lightning:input type="text" name="input-name" label="Please describe Other provider correspondence issuance methods used" aura:id="input-field"
                                 value="{!v.countyRatePlanRec.PAYMENT_Q17_OTHER__c}" 
                                 required="{!v.isPAYMENT_Q17_OtherRequired}"/>    
                <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-PAYMENT_Q17_OTHER__c"/>
            </lightning:layoutItem>
        </aura:if>
    </lightning:layout>    
</aura:component>