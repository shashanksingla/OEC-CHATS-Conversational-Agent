                <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-RT_Q8_5__c"/>
                <lightning:helptext content="When Percent of the State-Established Regular Rate for each age band is selected, the system will auto populate rates using the percentage entered. Other Method, not to include a percentage of the State-Established Regular Rate for each age band, the county will manually enter rate fields for each age band."/>
            </lightning:layoutItem>
            <aura:if isTrue="{!v.countyRatePlanRec.RT_Q8_5__c =='1'}">
