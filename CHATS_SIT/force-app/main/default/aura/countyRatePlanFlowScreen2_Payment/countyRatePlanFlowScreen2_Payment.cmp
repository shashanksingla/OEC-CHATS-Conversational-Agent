                                        value="{!v.countyRatePlanRec.RT_Q2_c__c}" required="{!v.countyRatePlanRec.RT_Q8_5__c =='2' ?true:false}"
                                        aura:id="input-field"/>
                    <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-RT_Q2_c__c"/>                
