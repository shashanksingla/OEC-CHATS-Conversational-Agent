            <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                <c:inputPicklist label="8.5 Please explain how your county determined the reimbursement rate for Weekend Care." aura:id="input-field"
                                value="{!v.countyRatePlanRec.RT_Q8_5__c}"
                                object="T_COUNTY_RATE__c"
