                    <lightning:input type="number" label="Please enter the percentage of the State-Established Regular Rate for Evening rates."
                                        min="101" max="200" messageWhenRangeOverflow="{!v.incorrectPercent}" messageWhenRangeUnderflow="{!v.incorrectPercent}"
                                        value="{!v.countyRatePlanRec.RT_Q8_6P__c}" required="{!v.countyRatePlanRec.RT_Q8_6__c =='1' ?true:false}"
                                        fieldLevelHelp="Allowed percentage from 101% to 200% of Full Time School Age Level 1 State-Established rate. Please select Other if county chooses to enter rates outside of this range."
                                        aura:id="input-field"/>
                    <c:fieldLevelMessage aura:id="T_COUNTY_RATE__c-RT_Q8_6P__c"/>                
