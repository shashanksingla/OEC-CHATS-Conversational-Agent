                                value="{!v.countyRatePlanRec.RT_Q8_6__c}"
                                object="T_COUNTY_RATE__c"
                                field="RT_Q8_6__c"
                                showNone="true"
                                required="{!!v.isRT_Q2ReadOnly}"/>
