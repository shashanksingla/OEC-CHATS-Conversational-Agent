<aura:component controller="APXCreateCountyRatesController">
    <aura:attribute name="countyRatePlan" type="T_COUNTY_RATE__c" description="stores the county rate plan detail displayed in header."/>
    <aura:attribute name="recordId" type="String" description="stores the county rate plan Id, used to query countyRatePlan."/>
    <aura:dependency resource="markup://force:navigateToSObject" type="EVENT"/>
    <aura:attribute name="mapCountyRateAmount" type="map" default="{}" description="stores the list of CountyRateAmount records to be upserted as map."/>
    <aura:attribute name="mapExistingCountyRateAmount" type="map" default="{}" description="stores the list of existing CountyRateAmount records."/>

    <aura:attribute name="tabNo" type="Integer" default="0" description="stores the current tab number."/>
    <aura:attribute name="providerType" type="String" default="HOM" description="stores the providerType api name, used to map it with backend picklist value."/>
    <aura:attribute name="providerTypeLabel" type="String" default="Home" description="stores the providerType label, used to show the current tab name above the table."/>
    <aura:attribute name="lstProviderType" type="List" default="['HOM','CEN','EXE']" description="stores the list of provider type."/>
    <aura:attribute name="mapProviderType" type="Map" default="{'HOM':'Home','CEN':'Center','EXE':'Exempt'}" description="stores the mapping of provider type as backend picklist values."/>
    
    <aura:attribute name="careUnit" type="String" default="3" description="stores the careUnit."/>

    <aura:attribute name="showSpinner" type="Boolean" default="true" description="Flag to show/hide spinner."/>
    
    <aura:attribute name="lstError" type="List" description="List of errors to be displayed at the top of the table."/>
    <aura:attribute name="showError" type="Boolean" default="false" description="Flag to show/hide lstError."/>
    
    <aura:attribute name="status" type="String"/>
    <aura:attribute name="mapStatus" type="Map" 
                    default="{'PEN':'Draft','SUB':'Submitted','APV':'Approved',
                             'NRV':'Need Revision'}"
                    description="stores the mapping of County rate plan status as backend picklist values."/>

    
    <aura:handler event="c:createCountyRateEvent" action="{!c.updateMapCountyRateAmount}"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    <c:LoadingSpinnerComp spinner="{!v.showSpinner}"/>
    <aura:if isTrue="{!v.countyRatePlan!=null}">
        <article class="slds-card">
            <div class="slds-card__header slds-grid">
                <header class="slds-media slds-media_center slds-has-flexi-truncate">
                    <div class="slds-media__body">
                        <h2>
                            <a href="javascript:void(0);" class="slds-card__header-link slds-truncate">
                                <span class="slds-text-heading_small">County Rate Plan</span>
                            </a>
                        </h2>
                    </div>
                </header>
            </div>
            <div class="slds-card__body slds-card__body_inner">
                <c:countyRatePlanHeader countyRatePlan="{!v.countyRatePlan}" status="{!v.status}"/>
            </div>
            <div class="slds-card__header slds-grid">
                <header class="slds-media slds-media_center slds-has-flexi-truncate">
                    <div class="slds-media__body">
                        <h2>
                            <a href="javascript:void(0);" class="slds-card__header-link slds-truncate" title="[object Object]">
                                <span class="slds-text-heading_small">County Base Rate Ceilings (FT): {!v.providerTypeLabel}</span>
                            </a>
                        </h2>
                        <div class="slds-text-body_small">Please enter your county's Full-Time rate ceilings for {!v.providerTypeLabel} care facilities</div>
                    </div>
                </header>
            </div>
            <div class="slds-card__body slds-card__body_inner">
                <aura:if isTrue="{!v.showSpinner!=true}">
                    <aura:if isTrue="{!v.showError}">
                        <div class="slds-notify slds-notify_alert slds-theme_alert-texture slds-theme_error" role="alert">
                            <span class="slds-assistive-text">error</span>
                            <span class="slds-icon_container slds-icon-utility-ban slds-m-right_x-small" title="Description of icon when needed">
                            </span>
                            <ul>
                                <aura:iteration items="{!v.lstError}" var="error">
                                    <h2><li>{!error}</li></h2>
                                </aura:iteration>
                            </ul>
                            <button class="slds-button slds-button_icon slds-notify__close slds-button_icon-inverse" title="Close">
                                <span class="slds-assistive-text">Close</span>
                            </button>
                        </div>     
                    </aura:if>
                    
                    <c:countyRateTable countyRatePlan="{!v.countyRatePlan}" 
                                       careUnit="{!v.careUnit}" 
                                       providerType="{!v.providerType}" 
                                       mapExistingCountyRateAmount="{!v.mapExistingCountyRateAmount}" 
                                       />
                </aura:if>
            </div>
            <footer class="slds-card__footer">
                <div class="slds-button-group" role="group">
                    <aura:if isTrue="{!v.tabNo!=0}">
                        <lightning:button variant="neutral" 
                                          label="Back" 
                                          onclick="{! c.doBack }" 
                                          disabled="{!v.tabNo==0}"/>
                    </aura:if>
                    <lightning:button variant="brand" 
                                      label="{!v.tabNo!=v.lstProviderType.length-1?'Save As Draft':'Finish'}" 
                                      onclick="{!c.doSave}" 
                                      />
                    <aura:if isTrue="{!v.tabNo!=v.lstProviderType.length-1}">
                        <lightning:button variant="neutral" 
                                          label="Next" 
                                          onclick="{! c.doNext }" 
                                          />
                    </aura:if>
                </div>
            </footer>
        </article>
        <aura:set attribute="else">
            <aura:if isTrue="{!v.showSpinner==false}">
                <div class="slds-notify slds-notify_alert slds-theme_alert-texture slds-theme_error" role="alert">
                    <span class="slds-assistive-text">error</span>
                    <span class="slds-icon_container slds-icon-utility-ban slds-m-right_x-small" title="Description of icon when needed">
                    </span>
                    <h1>
                        No County Rate Plan Record Found. Please check.
                    </h1>
                    <button class="slds-button slds-button_icon slds-notify__close slds-button_icon-inverse" title="Close">
                        <span class="slds-assistive-text">Close</span>
                    </button>
                </div>     
            </aura:if>
        </aura:set>
    </aura:if>
</aura:component>