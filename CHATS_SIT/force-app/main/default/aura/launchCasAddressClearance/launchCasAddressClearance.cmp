<aura:component implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:lightningQuickAction,force:hasRecordId" controller="AddressClearanceController"  access="global" >
    
    <!-- List of attribute definition -->
    <aura:attribute name="caseAddressIdList" type="List"/>
    <aura:attribute name="caseAddressTracker" type="List"/>
    <aura:handler name="init" value="{!this}" action="{!c.onInit}"/>    
    <aura:attribute name="recordError" type="String"/> 
    <aura:attribute name="showSpinner" type="Boolean"/>
    
    <!-- Bug 2421 and 2426 fix -->
    <aura:attribute name="execSource" type="String" default="Case"/>
    <!-- End of Bug 2421 and 2426 fix -->
    
    <c:LoadingSpinnerComp spinner="{!v.showSpinner}"/>  
    
    <aura:if isTrue="{!!v.caseAddressTracker.length>0}">
        <div class="recordError">
            <ui:message title="Error" severity="error" closable="true">
                No Matching Case Address Reords Found
            </ui:message>
        </div>
    </aura:if>
    
    <!-- Load the address and the potential address suggestions when invoked from a manual case creation process--> 
    <aura:if isTrue="{!v.execSource == 'ManualCase'}">
        <aura:iteration items="{!v.caseAddressTracker}" var="caseAddressUnit" indexVar="index"> 
            <span>
                <c:caseAddressClearance caseRec="{!caseAddressUnit.caseAddress}" 
                                        selectedValidAddress="{!caseAddressUnit.selectedValidAddress}"
                                        skipUpdate="{!caseAddressUnit.unvalidatedAddress}"
                                        index="{!index}"
                                        aura:id="{!'caseAddress' + index}"
                                        caseAddressTracker="{!v.caseAddressTracker}"
                                        execSource="{!v.execSource}"
                                        multipleAddress="{!v.caseAddressTracker.length > 1}"/>   
            </span>
            <br/> 
        </aura:iteration>
    </aura:if>
    
    <!-- Load the address and the potential address suggestions when invoked from a case screen--> 
    <aura:if isTrue="{!v.execSource == 'Case'}">
        <aura:iteration items="{!v.caseAddressTracker}" var="caseAddressUnit" indexVar="index"> 
            <span>
                <c:caseAddressClearance recordId="{!caseAddressUnit.Id}" 
                                        caseId="{!v.recordId}"
                                        selectedValidAddress="{!caseAddressUnit.selectedValidAddress}"
                                        skipUpdate="{!caseAddressUnit.unvalidatedAddress}"
                                        index="{!index}"
                                        aura:id="{!'caseAddress' + index}"
                                        caseAddressTracker="{!v.caseAddressTracker}"
                                        execSource="{!v.execSource}"
                                        multipleAddress="{!v.caseAddressTracker.length > 1}"/>
            </span>
            <br/> 
        </aura:iteration>
    </aura:if>
    
</aura:component>