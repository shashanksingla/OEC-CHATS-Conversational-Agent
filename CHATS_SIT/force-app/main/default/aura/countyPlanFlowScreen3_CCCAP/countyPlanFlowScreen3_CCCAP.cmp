            <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                <lightning:textarea name="input-name" label="6. Provide a brief overview of how your county ensures equal access to child care for families receiving CCCAP"
                                    value="{!v.countyPlanRec.CCCAP_Q9__c}" required="true"
                                    aura:id="input-field"
                                    length="1000"/>
                <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-CCCAP_Q9__c"/>           
            </lightning:layoutItem>
            <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                <c:inputRadioGroupForPicklist label="7. Client Orientation: Is a child care group orientation required as part of your application process?" 
                                              aura:id="input-field"
                                              value="{!v.countyPlanRec.CCCAP_Q10__c}"
                                              object="T_COUNTY_PLAN__c"
                                              field="CCCAP_Q10__c" required="true" isfullSize="true"/>
                <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-CCCAP_Q10__c"/>           
            </lightning:layoutItem>
            <aura:if isTrue="{!v.countyPlanRec.CCCAP_Q10__c=='Y'}">
                <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                    <lightning:textarea name="input-name" label="7.1 If yes, what is your county's policy for gathering additional information needed to complete the application process?"
                                        value="{!v.countyPlanRec.CCCAP_Q10_1__c}" 
