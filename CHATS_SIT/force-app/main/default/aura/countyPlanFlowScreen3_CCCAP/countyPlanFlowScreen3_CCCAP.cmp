                                                value="{!v.countyPlanRec.CCCAP_Q11_1__c}"
                                                object="T_COUNTY_PLAN__c"
                                                field="CCCAP_Q11_1__c" 
                                                required="{!v.countyPlanRec.CCCAP_Q11__c=='Y'?true:false}"/>
                    <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-CCCAP_Q11_1__c"/>
                </aura:if>
            </lightning:layoutItem>
            <aura:if isTrue="{!v.countyPlanRec.CCCAP_Q11__c=='Y'}">
