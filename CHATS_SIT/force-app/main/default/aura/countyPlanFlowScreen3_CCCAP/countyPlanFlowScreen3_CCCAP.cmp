                                        aura:id="input-field"
                                        value="{!v.countyPlanRec.CCCAP_Q11_2__c}" 
                                        required="{!v.countyPlanRec.CCCAP_Q11__c=='Y'?true:false}"
                                        length="1000"/>
                    <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-CCCAP_Q11_2__c"/>
                </lightning:layoutItem>
            </aura:if>
            <lightning:layoutItem flexibility="auto" size="6" padding="around-small"/>
            <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                <c:inputMultiSelectCombobox label="9. Check the state-prescribed forms your county has changed below, or list them in the 'Other' text box. Please mail or email a copy of each changed form to State CCCAP for approval.  Select all that apply." 
