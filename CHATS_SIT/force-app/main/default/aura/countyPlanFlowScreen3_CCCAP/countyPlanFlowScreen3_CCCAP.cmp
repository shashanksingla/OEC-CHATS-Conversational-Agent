                                        aura:id="input-field"/>
                    <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-CCCAP_Q10_2__c"/>
                </lightning:layoutItem>
            </aura:if>
            <lightning:layoutItem flexibility="auto" size="6" padding="around-small"/>
            <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                <c:inputRadioGroupForPicklist label="8. Provider Orientation: Is a child care orientation required for providers?" 
                                              aura:id="input-field"
                                              value="{!v.countyPlanRec.CCCAP_Q11__c}"
                                              object="T_COUNTY_PLAN__c"
                                              field="CCCAP_Q11__c" 
                                              required="true"
                                              isfullSize="true"/>
                <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-CCCAP_Q11__c"/>           
            </lightning:layoutItem>
            <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                <aura:if isTrue="{!v.countyPlanRec.CCCAP_Q11__c=='Y'}">
