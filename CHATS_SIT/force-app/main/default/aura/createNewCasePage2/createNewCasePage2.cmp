<aura:component extends="c:abstractSection">
    <aura:attribute name="caseRec" type="T_SBSD_CASE__c"
                    default="{'sobjectType':'T_SBSD_CASE__c'}"/>
    <aura:attribute name="fieldValidationErrors" type="List"/>
    <aura:handler name="change" value="{!v.fieldValidationErrors}" action="{!c.handleFieldLevelValidation}"/>
    <aura:method name="callValidateCurrentPage" action="{!c.handleValidateCurrentPage}" access="PUBLIC"/>
    <lightning:layout multipleRows="true" horizontalAlign="space">
        <lightning:layoutItem flexibility="auto" padding="around-small" size="12">
            <h3 class="slds-section__title">Other Case Information</h3>
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.IND_INCOME_FED_OTHER__c}"
                                          label="Household receives COWks/TANF/Cash Asst?"
                                          field="IND_INCOME_FED_OTHER__c" 
                                          object="T_SBSD_CASE__c"
                                          required="true"
                                          aura:id="input-field"/> 
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.IND_INCOME_FED_OTHER_ADDL__c}"
                                          label="If not, would you like information?"
                                          field="IND_INCOME_FED_OTHER_ADDL__c" 
                                          object="T_SBSD_CASE__c"
                                          required="true"
                                          aura:id="input-field"/>            
        </lightning:layoutItem>        
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.IND_HEAD_START__c}"
                                          label="Household receives Head Start/Early HS?"
                                          field="IND_HEAD_START__c" 
                                          object="T_SBSD_CASE__c"
                                          required="true"
                                          aura:id="input-field"/> 
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.IND_HEAD_START_ADDL__c}"
                                          label="If not, would you like information?"
                                          field="IND_HEAD_START_ADDL__c" 
                                          object="T_SBSD_CASE__c"
                                          required="true"
                                          aura:id="input-field"/>            
        </lightning:layoutItem>        
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.IND_LEAP__c}"
                                          label="Household receives LEAP?"
                                          field="IND_LEAP__c" 
                                          object="T_SBSD_CASE__c"
                                          required="true"
                                          aura:id="input-field"/>            
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.IND_LEAP_ADDL__c}"
                                          label="If not, would you like information?"
                                          field="IND_LEAP_ADDL__c" 
                                          object="T_SBSD_CASE__c"
                                          required="true"
                                          aura:id="input-field"/>            
        </lightning:layoutItem>        
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.IND_FS_RCVNG__c}"
                                          label="Household receives SNAP?"
                                          field="IND_FS_RCVNG__c" 
                                          object="T_SBSD_CASE__c"
                                          required="true"
                                          aura:id="input-field"/>            
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.IND_FS_RCVNG_ADDL__c}"
                                          label="If not, would you like information?"
                                          field="IND_FS_RCVNG_ADDL__c" 
                                          object="T_SBSD_CASE__c"
                                          required="true"
                                          aura:id="input-field"/>            
        </lightning:layoutItem>        
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.IND_WIC__c}"
