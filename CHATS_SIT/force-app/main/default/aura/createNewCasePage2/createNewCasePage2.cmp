        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.IND_IDEA_3_5_ADDL__c}"
                                          label="If not, would you like information?"
                                          field="IND_IDEA_3_5_ADDL__c" 
                                          object="T_SBSD_CASE__c"
                                          required="true"
                                          aura:id="input-field"/>            
        </lightning:layoutItem>        
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.IND_IDEA_0_3__c}"
                                          label="Participates in Early Intervention CO?"
                                          field="IND_IDEA_0_3__c" 
