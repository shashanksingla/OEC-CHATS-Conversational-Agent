                                          required="true"
                                          aura:id="input-field"/>            
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.IND_IDEA_0_3_ADDL__c}"
                                          label="If not, would you like information?"
                                          field="IND_IDEA_0_3_ADDL__c" 
                                          object="T_SBSD_CASE__c"
                                          required="true"
                                          aura:id="input-field"/>            
        </lightning:layoutItem>        
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.IND_PENSION__c}"
                                          label="Household receives Old Age Pension?"
                                          field="IND_PENSION__c" 
                                          object="T_SBSD_CASE__c"
                                          required="true"
                                          aura:id="input-field"/>            
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.IND_PENSION_ADDL__c}"
                                          label="If not, would you like information?"
                                          field="IND_PENSION_ADDL__c" 
                                          object="T_SBSD_CASE__c"
                                          required="true"
