                                          label="If not, would you like information?"
                                          field="IND_FOOD_PGM_ADDL__c" 
                                          object="T_SBSD_CASE__c"
                                          required="true"
                                          aura:id="input-field"/>            
        </lightning:layoutItem>        
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.IND_CHP__c}"
                                          label="Household receives Medicaid/CHP+?"
                                          field="IND_CHP__c" 
                                          object="T_SBSD_CASE__c"
                                          required="true"
                                          aura:id="input-field"/>            
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.IND_CHP_ADDL__c}"
                                          label="If not, would you like information?"
                                          field="IND_CHP_ADDL__c" 
                                          object="T_SBSD_CASE__c"
                                          required="true"
                                          aura:id="input-field"/>            
        </lightning:layoutItem>        
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.CDE_ASST_HSNG__c}"
                                          label="Household receives Voucher/Cash Asst?"
                                          field="CDE_ASST_HSNG__c" 
                                          object="T_SBSD_CASE__c"
                                          required="true"
                                          aura:id="input-field"/>            
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.IND_ASST_HSNG_ADDL__c}"
                                          label="If not, would you like information?"
                                          field="IND_ASST_HSNG_ADDL__c" 
                                          object="T_SBSD_CASE__c"
                                          required="true"
                                          aura:id="input-field"/>            
        </lightning:layoutItem>        
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.IND_REFUGEE__c}"
                                          label="Household receives Refugee Medical Asst?"
                                          field="IND_REFUGEE__c" 
                                          object="T_SBSD_CASE__c"
                                          required="true"
                                          aura:id="input-field"/>            
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
