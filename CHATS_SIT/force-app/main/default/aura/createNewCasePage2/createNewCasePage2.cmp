        <lightning:layoutItem flexibility="auto" padding="around-small" size="6">
            <c:inputRadioGroupForPicklist value="{!v.caseRec.IND_SSI__c}"
                                          label="Household receives SSI?"
                                          field="IND_SSI__c" 
