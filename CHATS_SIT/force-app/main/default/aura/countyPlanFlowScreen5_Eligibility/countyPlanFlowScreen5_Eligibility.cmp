        <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
            <c:inputRadioGroupForPicklist label="16. Do you require any forms for the waitlist?" aura:id="input-field"
                value="{!v.countyPlanRec.ELIGIBILITY_Q12__c}" object="T_COUNTY_Plan__c" field="ELIGIBILITY_Q12__c"
