    <lightning:layout multipleRows="true">
        <lightning:layoutItem flexibility="auto" padding="around-small" size="12">
            <h3 class="slds-section__title"><B>Enrollment Freeze</B></h3>
            <h1 class="slds-section__title">Please complete the following questions related to your county's enrollment
                freeze policies.(Question is not applicable until 7/1/19)</h1>
        </lightning:layoutItem>

        <aura:if isTrue="{!!v.jsActivated}">
            <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                <c:inputRadioGroupForPicklist label="{!$Label.c.CP_ELIGIBILITY_Q10_Label}" aura:id="input-field"
                    value="{!v.countyPlanRec.ELIGIBILITY_Q10__c}" object="T_COUNTY_PLAN__c" field="ELIGIBILITY_Q10__c"
                    required="true" onChange="{!c.handleCheckWaitlistEnrolmentFreeze}" />
                <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-ELIGIBILITY_Q10__c" />
            </lightning:layoutItem>
            <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                <aura:if isTrue="{!v.countyPlanRec.ELIGIBILITY_Q10__c=='Y'?true:false}">
                    <c:inputRadioGroupForPicklist label="{!$Label.c.CP_ELIGIBILITY_Q10_1_Label}" aura:id="input-field"
                        value="{!v.countyPlanRec.ELIGIBILITY_Q10_1__c}" object="T_COUNTY_PLAN__c"
                        field="ELIGIBILITY_Q10_1__c" required="{!v.countyPlanRec.ELIGIBILITY_Q10__c=='Y'?true:false}" />
                    <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-ELIGIBILITY_Q10_1__c" />
                </aura:if>
            </lightning:layoutItem>
            <lightning:layoutItem flexibility="auto" size="12" padding="around-small">
                <lightning:layoutItem flexibility="auto" size="6">
                    <aura:if isTrue="{!v.countyPlanRec.ELIGIBILITY_Q10__c=='Y'?true:false}">
                        <lightning:textarea name="input-name" label="{!$Label.c.CP_ELIGIBILITY_Q10_2_Label}"
                            aura:id="input-field" value="{!v.countyPlanRec.ELIGIBILITY_Q10_2__c}"
                            required="{!v.countyPlanRec.ELIGIBILITY_Q10_1__c=='2'?true:false}" length="900" />

                        <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-ELIGIBILITY_Q10_2__c" />
                    </aura:if>
                </lightning:layoutItem>
            </lightning:layoutItem>
            <aura:set attribute="else">
                <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                    <c:inputRadioGroupForPicklist label="{!$Label.c.CP_ELIGIBILITY_Q10_Label_JS}" aura:id="input-field"
                        value="{!v.countyPlanRec.ELIGIBILITY_Q10__c}" object="T_COUNTY_PLAN__c"
                        field="ELIGIBILITY_Q10__c" required="true" onChange="{!c.handleCheckWaitlistEnrolmentFreeze}" />
                    <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-ELIGIBILITY_Q10__c" />
                </lightning:layoutItem>
                <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                    <aura:if isTrue="{!v.countyPlanRec.ELIGIBILITY_Q10__c=='Y'?true:false}">
                        <c:inputRadioGroupForPicklist label="{!$Label.c.CP_ELIGIBILITY_Q10_1_Label_JS}"
                            aura:id="input-field" value="{!v.countyPlanRec.ELIGIBILITY_Q10_1__c}"
                            object="T_COUNTY_PLAN__c" field="ELIGIBILITY_Q10_1__c"
                            required="{!v.countyPlanRec.ELIGIBILITY_Q10__c=='Y'?true:false}" isfullSize="true" />
                        <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-ELIGIBILITY_Q10_1__c" />
                    </aura:if>
                </lightning:layoutItem>
                <lightning:layoutItem flexibility="auto" size="12" padding="around-small">
                    <lightning:layoutItem flexibility="auto" size="6">
                        <aura:if isTrue="{!v.countyPlanRec.ELIGIBILITY_Q10__c=='Y'?true:false}">
                            <lightning:textarea name="input-name" label="{!$Label.c.CP_ELIGIBILITY_Q10_2_Label_JS}"
                                aura:id="input-field" value="{!v.countyPlanRec.ELIGIBILITY_Q10_2__c}"
                                required="{!v.countyPlanRec.ELIGIBILITY_Q10_1__c=='2'?true:false}" length="900" />

                            <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-ELIGIBILITY_Q10_2__c" />
                        </aura:if>
                    </lightning:layoutItem>
                </lightning:layoutItem>
                <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                    <c:inputMultiSelectCombobox
                        label="18. In addition to the State-approved abbreviated application and/or redetermination forms, please list all of the forms and submit them to State CCCAP for approval."
                        aura:id="input-field" value="{!v.countyPlanRec.ELIGIBILITY_Q20_new__c}" object="T_COUNTY_Plan__c"
                        field="ELIGIBILITY_Q20_new__c" required="{!v.countyPlanRec.ELIGIBILITY_Q10__c=='Y'?true:false}"/>
                    <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-ELIGIBILITY_Q20_new__c"/>           
                </lightning:layoutItem>
                <aura:if isTrue="{!v.isQ20_OtherRequired}">
                    <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                        <lightning:textarea name="input-name" label="If other, please specify." length="1000"
                                    value="{!v.countyPlanRec.ELIGIBILITY_Q20_other__c}" required="{!v.isQ20_OtherRequired}" aura:id="input-field"/>
                        <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-ELIGIBILITY_Q20_other__c" />
                    </lightning:layoutItem>
                </aura:if>
                <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                    <c:inputRadioGroupForPicklist
                        label="18.1 Will your county have families reinstate their intent to remain on the freeze list every twelve (12) months?"
                        aura:id="input-field" value="{!v.countyPlanRec.ELIGIBILITY_Q20_1__c}" object="T_COUNTY_Plan__c"
                        field="ELIGIBILITY_Q20_1__c" required="{!v.countyPlanRec.ELIGIBILITY_Q10__c=='Y'?true:false}" isfullSize="true"/>
                    <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-ELIGIBILITY_Q20_1__c"/>           
                </lightning:layoutItem>
            </aura:set>

        </aura:if>
    </lightning:layout>
    <lightning:layout multipleRows="true">
        <lightning:layoutItem flexibility="auto" padding="around-small" size="12">
            <h3 class="slds-section__title"><B>Protective Services</B></h3>
            <h1 class="slds-section__title">Please complete the following questions related to your county's protective
                services policies.</h1>
        </lightning:layoutItem>
        <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
            <aura:if isTrue="{!!v.jsActivated}">
                <c:inputRadioGroupForPicklist
                    label="10. Does your county elect to cover the cost of Child Welfare Child Care under Protective Services Child Care? (Current county policy/procedure must be submitted to the State Department for review and approval)"
                    aura:id="input-field" value="{!v.countyPlanRec.ELIGIBILITY_Q11__c}" object="T_COUNTY_PLAN__c"
                    field="ELIGIBILITY_Q11__c" required="true" isfullSize="true"/>
                <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-ELIGIBILITY_Q11__c" />
                <aura:set attribute="else">
                    <c:inputRadioGroupForPicklist
                        label="19. Does your county elect to cover the cost of Child Welfare Child Care under Protective Services Child Care (PSCC)?"
                        aura:id="input-field" value="{!v.countyPlanRec.ELIGIBILITY_Q11__c}" object="T_COUNTY_PLAN__c"
                        field="ELIGIBILITY_Q11__c" required="true" isfullSize="true"/>
                    <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-ELIGIBILITY_Q11__c" />
                </aura:set>
            </aura:if>
        </lightning:layoutItem>
        <aura:if isTrue="{!v.countyPlanRec.ELIGIBILITY_Q11__c=='Y'?true:false}">
            <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                <c:inputRadioGroupForPicklist
                    label="If yes, does your county waive the child's countable income on a case-by-case basis?"
                    aura:id="input-field" value="{!v.countyPlanRec.ELIGIBILITY_Q11_1__c}" object="T_COUNTY_PLAN__c"
                    field="ELIGIBILITY_Q11_1__c" required="{!v.countyPlanRec.ELIGIBILITY_Q11__c=='Y'?true:false}" isfullSize="true"/>
                <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-ELIGIBILITY_Q11_1__c" />
            </lightning:layoutItem>
        </aura:if>
        <aura:if isTrue="{!v.countyPlanRec.ELIGIBILITY_Q11_1__c=='Y'?true:false}">
            <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                <lightning:input type="text" name="input-name" label="If yes, please explain when income is waived"
                    value="{!v.countyPlanRec.ELIGIBILITY_Q11_1D__c}" aura:id="input-field" required="{!v.countyPlanRec.ELIGIBILITY_Q11_1__c=='Y'?true:false}" />
                <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-ELIGIBILITY_Q11_1D__c" />
            </lightning:layoutItem>
        </aura:if>
        <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
            <lightning:input type="text" name="input-name" label="20. What population will the county cover with PSCC?"
                value="{!v.countyPlanRec.ELIGIBILITY_Q14__c}" aura:id="input-field" required="{!v.countyPlanRec.ELIGIBILITY_Q11__c=='Y'?true:false}" />
            <c:fieldLevelMessage aura:id="T_COUNTY_PLAN__c-ELIGIBILITY_Q14__c" />
        </lightning:layoutItem>
    </lightning:layout>
</aura:component>