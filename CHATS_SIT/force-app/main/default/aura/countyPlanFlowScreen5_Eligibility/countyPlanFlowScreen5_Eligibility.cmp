            </lightning:layoutItem> -->
            <aura:set attribute="else">
                <lightning:layoutItem flexibility="auto" size="6" padding="around-small">
                    <c:inputRadioGroupForPicklist label="{!$Label.c.CP_ELIGIBILITY_Q9_Label_JS}" aura:id="input-field"
                        value="{!v.countyPlanRec.ELIGIBILITY_Q9__c}" object="T_COUNTY_PLAN__c" field="ELIGIBILITY_Q9__c"
