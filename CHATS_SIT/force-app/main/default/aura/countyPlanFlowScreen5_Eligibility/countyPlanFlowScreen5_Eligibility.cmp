                <aura:if isTrue="{!v.countyPlanRec.ELIGIBILITY_Q9__c=='Y'?true:false}">
                    <lightning:textarea name="input-name" label="{!$Label.c.CP_IF_OTHER_PLS_SPECIFY}"
                        aura:id="input-field" value="{!v.countyPlanRec.ELIGIBILITY_Q9_4_2__c}"
