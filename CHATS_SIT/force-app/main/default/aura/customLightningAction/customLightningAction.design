<design:component >
	<design:attribute name="buttonLabel" label="Button Label" />
    <design:attribute name="showConfirmMsgModal" label="Show Confirm Box?" 
                      datasource="Always, Conditional, Never, ValidatePriorToRedirecting"
                      required="true"/>
    <design:attribute name="title" label="Confirm Box Title"/>
    <design:attribute name="callApexMethodOnYesButtonClick" label="If Always, Do you want to execute apex method on Yes Option Click?"/>
    <design:attribute name="showConfirmApexMethodName" label="If Conditional, Enter the name of the Method in CustomLightningActionApxCtrl.cls to be called"/>

    <design:attribute name="confirmMsg" label="Enter Confirmation Message"/>
    
    <design:attribute name="callApexOrLaunchComponent"
                      label="Call apex or load component or fire an event"
                      datasource="Apex, Component, Event, Standard Screen, Flow"/>
    
    <design:attribute name="apexMethodName" 
                      label="If Apex, Enter the name of the Method in CustomLightningActionApxCtrl.cls to be called"/>
    
    <design:attribute name="eventName" 
                      label="If Event, Enter the name of the Event"/>
    
    <design:attribute name="componentName" label="If Component, Enter the Name" />
    <design:attribute name="componentLoadType" label="Component Load Type" 
                      datasource="Modal, Redirect" default="Redirect"/>
    <design:attribute name="callApexBeforeComponent" label="Call Apex before Component?"/>

    <design:attribute name="flowName" label="If Flow, Enter the name of the Flow"/>
    
    <design:attribute name="recordIdAttribute" label="Record Id Holder Attribute" default="recordId"/>
    <design:attribute name="componentAttributes" label="Component Attributes(For Multiple, put separated by :)"/>
    <design:attribute name="componentAttributesValues" label="Component Attributes Values(For Multiple, put separated by :)"/>
    <design:attribute name="modalHeader" label="Modal Header"/>
    <design:attribute name="isMsgUnescapedHtml" label="If Unescaped Confirmation Message"/>
    <design:attribute name="objectAPIName" label="Object API Name" />
    
</design:component>