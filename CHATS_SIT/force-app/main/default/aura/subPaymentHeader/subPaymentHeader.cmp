<aura:component implements="force:hasrecordId,force:hasSObjectName,flexipage:availableForRecordHome"
                extends="c:abstractComponent" 
                controller="subPaymentSearch" access="global">
    <aura:attribute name="auth" type="T_AUTH__c"/>    
    <!--<aura:attribute name="subPaymt" type="batchsit_t_sub_pmt__x"
                    default="{'sobjectType':'batchsit_t_sub_pmt__x'}"/>-->
    <aura:attribute name="subPaymentData" type="Map"/>
    <aura:attribute name="childRecord" type="SObject"/>
    <aura:attribute name="recordError" type="String"/>
    <aura:attribute name="fields" type="List"/>
    <aura:attribute name="relationshipToCase" type="String"/> 
    <aura:attribute name="picklistData" type="Object"/>
    <aura:attribute name="isVacantSlotPayment" type="Boolean" default="false" />
    <aura:handler name="init" value="{!this}" action="{!c.mapPicklistValues}"/>
      
    <!--<aura:if isTrue="{!v.sObjectName =='batchsit_t_sub_pmt__x'}">
        <force:recordData aura:id="forceSubPaymtRecordCmp"
                          recordId="{!v.recordId}"
                          fields="Id,idn_auth__c,idn_auth__r.NAM_FIRST__c,
                                  idn_auth__r.CDE_COUNTY__r.Name,idn_auth__r.NAM_LAST__c,idn_auth__r.IDN_CASE__r.Name,
                                  cde_status_pmt_sub__c, amt_total_pmt_sub__c, amt_copay_pmt_sub__c, amt_rate_pmt_sub__c"
                          mode="EDIT"
                          targetFields="{!v.subPaymt}"
                          targetError="{!v.recordError}" />
    </aura:if>-->
    <div class="slds-p-around--none slds-panel__section">
        <div class="slds-grid slds-grid slds-wrap slds-grid--pull-padded">
            <div class="slds-p-horizontal--small slds-size--1-of-2">
                <div class="slds-form-element slds-hint-parent slds-has-divider--bottom slds-p-around--x-small hasDiv">
                    <label class="slds-form-element__label">ID</label>
                    <div class="slds-form-element__control" style="min-height: 18px;">
                        <ui:outputText value="{!v.subPaymentData.idn_pmt_sub__c}" aura:id="spId"/>                              
                    </div>
                </div>
            </div>
            <aura:if isTrue="{!!v.isVacantSlotPayment}">
            <div class="slds-p-horizontal--small slds-size--1-of-2">
                <div class="slds-form-element slds-hint-parent slds-has-divider--bottom slds-p-around--x-small hasDiv">
                    <label class="slds-form-element__label">Authorization ID</label>
                    <div class="slds-form-element__control" style="min-height: 18px;">
                        <a class="textUnderline outputLookupLink slds-truncate forceOutputLookup" data-refid="recordId" data-recordid="{!v.subPaymentData.idn_auth__r.Id}" data-special-link="true" href="{!'/one/one.app?source=aloha#/sObject/'+v.subPaymentData.idn_auth__r.Id+'/view'}" target = "_self" rel="noreferrer" title="" data-aura-class="forceOutputLookup" >
                            {!v.subPaymentData.idn_auth__r.Name}
                        </a>                              
                    </div>
                </div>
            </div>
            </aura:if>
            <div class="slds-p-horizontal--small slds-size--1-of-2">
                <div class="slds-form-element slds-hint-parent slds-has-divider--bottom slds-p-around--x-small hasDiv">
                    <label class="slds-form-element__label">Payment ID</label>
                    <div class="slds-form-element__control" style="min-height: 18px;">
                        <a class="textUnderline outputLookupLink slds-truncate forceOutputLookup" data-refid="recordId" data-recordid="{!v.subPaymentData.idn_pmt__r.Id}" data-special-link="true" href="{!'/one/one.app?source=aloha#/sObject/'+v.subPaymentData.idn_pmt__r.Id+'/view'}" target = "_self" rel="noreferrer" title="" data-aura-class="forceOutputLookup" >
                            {!v.subPaymentData.idn_pmt__r.Name}
                        </a>                              
                    </div>
                </div>
            </div>
            <div class="slds-p-horizontal--small slds-size--1-of-2">
                <div class="slds-form-element slds-hint-parent slds-has-divider--bottom slds-p-around--x-small hasDiv">
                    <label class="slds-form-element__label">Service Period ID</label>
                    <div class="slds-form-element__control" style="min-height: 18px;">
                        <a class="textUnderline outputLookupLink slds-truncate forceOutputLookup" data-refid="recordId" data-recordid="{!v.subPaymentData.idn_period_serv__r.Id}" data-special-link="true" href="{!'/one/one.app?source=aloha#/sObject/'+v.subPaymentData.idn_period_serv__r.Id+'/view'}" target = "_self" rel="noreferrer" title="" data-aura-class="forceOutputLookup" >
                            {!v.subPaymentData.idn_period_serv__r.Name}
                        </a>                              
                    </div>
                </div>
            </div>
            <aura:if isTrue="{!!v.isVacantSlotPayment}">
                <div class="slds-p-horizontal--small slds-size--1-of-2">
                    <div class="slds-form-element slds-hint-parent slds-has-divider--bottom slds-p-around--x-small hasDiv">
                        <label class="slds-form-element__label">Total Sub Payment Parent Fee</label>
                        <div class="slds-form-element__control" style="min-height: 18px;">
                            <ui:outputText value="{!v.subPaymentData.amt_copay_pmt_sub__c}" aura:id="copayAmt"/>                              
                        </div>
                    </div>
                </div> 
                <div class="slds-p-horizontal--small slds-size--1-of-2">
                    <div class="slds-form-element slds-hint-parent slds-has-divider--bottom slds-p-around--x-small hasDiv">
                        <label class="slds-form-element__label">Total Sub Payment Rate Paid</label>
                        <div class="slds-form-element__control" style="min-height: 18px;">
                            <ui:outputText value="{!v.subPaymentData.amt_rate_pmt_sub__c}" aura:id="ratePaid"/>                              
                        </div>
                    </div>
                </div>
                <div class="slds-p-horizontal--small slds-size--1-of-2">
                    <div class="slds-form-element slds-hint-parent slds-has-divider--bottom slds-p-around--x-small hasDiv">
                        <label class="slds-form-element__label">Total Sub Payment Amount</label>
                        <div class="slds-form-element__control" style="min-height: 18px;">
                            <ui:outputText value="{!v.subPaymentData.amt_total_pmt_sub__c}" aura:id="totalAmt"/>                            
                        </div>
                    </div>
                </div>
            </aura:if>
            <div class="slds-p-horizontal--small slds-size--1-of-2">
                <div class="slds-form-element slds-hint-parent slds-has-divider--bottom slds-p-around--x-small hasDiv">
                    <label class="slds-form-element__label">Total Sub Payment Slot Contract Amount</label>
                    <div class="slds-form-element__control" style="min-height: 18px;">
                        <ui:outputText value="{!v.subPaymentData.amt_slot_pmt_sub__c}" aura:id="totalSlotAmt"/>                            
                    </div>
                </div>
            </div>
            <div class="slds-p-horizontal--small slds-size--1-of-2">
                <div class="slds-form-element slds-hint-parent slds-has-divider--bottom slds-p-around--x-small hasDiv">
                    <label class="slds-form-element__label">County</label>
                    <div class="slds-form-element__control" style="min-height: 18px;">
                        <lightning:formattedText value="{! if(empty(v.subPaymentData.idn_auth__r.CDE_COUNTY__r.Name), v.subPaymentData.idn_slot_contract__r.CDE_COUNTY__r.Name, v.subPaymentData.idn_auth__r.CDE_COUNTY__r.Name)}" aura:id="county"/>                              
                    </div>
                </div>
            </div>
            <div class="slds-p-horizontal--small slds-size--1-of-2">
                <div class="slds-form-element slds-hint-parent slds-has-divider--bottom slds-p-around--x-small hasDiv">
                    <label class="slds-form-element__label">Sub Payment Status</label>
                    <div class="slds-form-element__control" style="min-height: 18px;">
                        <lightning:formattedText value="{!v.subPaymentData.cde_status_pmt_sub__c}" aura:id="statusCode"/>                            
                    </div>
                </div>
            </div>
            <aura:if isTrue="{!!v.isVacantSlotPayment}">
            <div class="slds-p-horizontal--small slds-size--1-of-2">
                <div class="slds-form-element slds-hint-parent slds-has-divider--bottom slds-p-around--x-small hasDiv">
                    <label class="slds-form-element__label">Child First Name</label>
                    <div class="slds-form-element__control" style="min-height: 18px;">
                        <lightning:formattedText value="{!v.subPaymentData.idn_auth__r.NAM_FIRST__c}" aura:id="cfirstName"/>                              
                    </div>
                </div>
            </div>
            <div class="slds-p-horizontal--small slds-size--1-of-2">
                <div class="slds-form-element slds-hint-parent slds-has-divider--bottom slds-p-around--x-small hasDiv">
                    <label class="slds-form-element__label">Child Last Name</label>
                    <div class="slds-form-element__control" style="min-height: 18px;">
                        <lightning:formattedText value="{!v.subPaymentData.idn_auth__r.NAM_LAST__c}" aura:id="clastName"/>                            
                    </div>
                </div>
            </div>
             <div class="slds-p-horizontal--small slds-size--1-of-2">
                <div class="slds-form-element slds-hint-parent slds-has-divider--bottom slds-p-around--x-small hasDiv">
                    <label class="slds-form-element__label">Case Id</label>
                    <div class="slds-form-element__control" style="min-height: 18px;">
                        <lightning:formattedText value="{!v.subPaymentData.idn_auth__r.IDN_CASE__r.Name}" aura:id="clastName"/>                            
                    </div>
                </div>
            </div>
            </aura:if>
            <div class="slds-p-horizontal--small slds-size--1-of-2">
                <div class="slds-form-element slds-hint-parent slds-has-divider--bottom slds-p-around--x-small hasDiv">
                    <label class="slds-form-element__label">Slot Contract ID</label>
                    <div class="slds-form-element__control" style="min-height: 18px;">
                        <a class="textUnderline outputLookupLink slds-truncate forceOutputLookup" data-refid="recordId" data-recordid="{!v.subPaymentData.idn_slot_contract__r.Id}" data-special-link="true" href="{!'/one/one.app?source=aloha#/sObject/'+v.subPaymentData.idn_slot_contract__r.Id+'/view'}" target = "_self" rel="noreferrer" title="" data-aura-class="forceOutputLookup" >
                            {!v.subPaymentData.idn_slot_contract__r.Name}
                        </a>                              
                    </div>
                </div>
            </div>
        </div>
    </div>
</aura:component>