<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property name="componentTitle"        type="String"  label="Component Title"               default="Linked Records"/>
            <property name="junctionObjectApiName" type="String"  label="Junction Object API Name"/>
            <property name="sourceField"           type="String"  label="Source Lookup Field API Name"/>
            <property name="relatedField"          type="String"  label="Related Lookup Field API Name"/>
            <property name="relatedObjectApiName"  type="String"  label="Related Object API Name"/>
            <property name="relatedObjectLabel"    type="String"  label="Related Object Label"          default="Record"/>
            <property name="iconName"              type="String"  label="SLDS Icon Name"                default="standard:record"/>
            <property name="relatedRecordNameField" type="String" label="Related Record Name Field"     default="Name"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>