    <validationRules>
        <fullName>Adr_Zip_Extn_Length_4</fullName>
        <active>true</active>
        <description>set Zip Extn address to length 4</description>

        <errorConditionFormula>AND(NOT(ISBLANK(ADR_ZIP_EXTN__c)),
     OR(LEN(ADR_ZIP_EXTN__c) &lt;&gt; 4,
        NOT(ISNUMBER(ADR_ZIP_EXTN__c))
       ) 
   )</errorConditionFormula>
        <errorDisplayField>ADR_ZIP_EXTN__c</errorDisplayField>
        <errorMessage>Zip Extension should be 4 digit number</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Adr_Zip_Main_Length_5</fullName>
        <active>true</active>
        <description>set Zip Address to length 5</description>
        <errorConditionFormula>AND(NOT(ISBLANK(ADR_ZIP__c)), 
OR(LEN(ADR_ZIP__c) &lt;&gt; 5, 
NOT(ISNUMBER(ADR_ZIP__c)) 
) 
)</errorConditionFormula>
        <errorDisplayField>ADR_ZIP__c</errorDisplayField>
        <errorMessage>Zip Address should be 5 digit number</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Fax_Nbr_Len_MustBe_10</fullName>
        <active>true</active>
        <description>Fax Number must be of length 10 digits</description>
        <errorConditionFormula>AND(NOT(ISBLANK(NBR_FAX__c)), 
OR(LEN(NBR_FAX__c) &lt;&gt; 10, 
NOT(ISNUMBER(NBR_FAX__c)) 
) 
)</errorConditionFormula>
        <errorDisplayField>NBR_FAX__c</errorDisplayField>
        <errorMessage>Fax Number must be of length 10 digits</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PhnNbrExtn_Len_MustBe_6</fullName>
        <active>true</active>
        <description>Phone Number extension length should be 6</description>
        <errorConditionFormula>AND(NOT(ISBLANK( NBR_PHONE_EXTN__c )), 
OR(LEN( NBR_PHONE_EXTN__c ) &lt;&gt; 6, 
NOT(ISNUMBER( NBR_PHONE_EXTN__c )) 
) 
)</errorConditionFormula>
        <errorDisplayField>NBR_PHONE_EXTN__c</errorDisplayField>
        <errorMessage>Phone Number Extension must be a 6 digit number</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PhnNbr_Len_MustBe_10</fullName>
        <active>true</active>
        <description>Phone Number must be 10 digit number</description>
        <errorConditionFormula>AND(NOT(ISBLANK( NBR_PHONE__c )), 
OR(LEN(NBR_PHONE__c) &lt;&gt; 10, 
NOT(ISNUMBER(NBR_PHONE__c)) 
) 
)</errorConditionFormula>
        <errorDisplayField>NBR_PHONE__c</errorDisplayField>
        <errorMessage>Phone Number must be 10 digit number</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
