<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Home_Phone_must_be_10_digits</fullName>
    <active>true</active>
    <description>Home Phone must be 10 digits</description>
    <errorConditionFormula>AND(NOT(ISBLANK(NBR_PHONE_HOME__c)),LEN(NBR_PHONE_HOME__c)!=10)</errorConditionFormula>
    <errorDisplayField>NBR_PHONE_HOME__c</errorDisplayField>
    <errorMessage>Home Phone must be 10 digits</errorMessage>
</ValidationRule>
