<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Phn_Nbr_Len_10</fullName>
    <active>true</active>
    <description>Validation to check Phone Number is of 10 digits</description>
    <errorConditionFormula>OR(  NOT(ISNUMBER( NBR_PHONE__c )) ,
    LEN( NBR_PHONE__c ) &lt;&gt; 10
)</errorConditionFormula>
    <errorDisplayField>NBR_PHONE__c</errorDisplayField>
    <errorMessage>Please provide the 10-digit Phone Number.</errorMessage>
</ValidationRule>
