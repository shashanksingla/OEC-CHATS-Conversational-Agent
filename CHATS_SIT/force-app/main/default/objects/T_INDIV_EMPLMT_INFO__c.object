    <validationRules>
        <fullName>Activity_Begin_Date_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>IDN_EMPLMT_INDIV__r.DTE_BEGIN_EFFV__c &gt; DTE_BEGIN_EFFV__c</errorConditionFormula>
        <errorDisplayField>DTE_BEGIN_EFFV__c</errorDisplayField>
        <errorMessage>Effective Begin Date cannot be before the Activity Effective Begin Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Activity_End_Date_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(IDN_EMPLMT_INDIV__r.DTE_END_EFFV__c &lt; DTE_END_EFFV__c, NOT(ISBLANK(IDN_EMPLMT_INDIV__r.DTE_END_EFFV__c) ))</errorConditionFormula>
        <errorDisplayField>DTE_END_EFFV__c</errorDisplayField>
        <errorMessage>Effective End Date cannot be after the Activity Effective End Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Begin_Date_Future_validation</fullName>
        <active>true</active>
        <description>Begin Date can not be more than 31 days in future.</description>
        <errorConditionFormula>DTE_BEGIN_EFFV__c &gt; Today()+31</errorConditionFormula>
        <errorDisplayField>DTE_BEGIN_EFFV__c</errorDisplayField>
        <errorMessage>Begin Date can not be more than 31 days in future</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>End_Date_Later_Than_Begin_Date</fullName>
        <active>true</active>
        <errorConditionFormula>NOT(IDN_EMPLMT_INDIV__r.IDN_CLIENT__r.Is_Peak_Data__c) &amp;&amp; NOT(IDN_EMPLMT_INDIV__r.IDN_CLIENT__r.Is_CBMS_Data__c) &amp;&amp; DTE_BEGIN_EFFV__c &gt; DTE_END_EFFV__c</errorConditionFormula>
        <errorDisplayField>DTE_END_EFFV__c</errorDisplayField>
        <errorMessage>Effective End Date must be greater than Effective Begin Date</errorMessage>
    </validationRules>
   <!--Commented as part of CCCAP-10798-->
       <!--validationRules>
        <fullName>MaternityMedicalLeaveNotGreaterThanToday</fullName>
        <active>false</active>
        <errorConditionFormula>AND(NOT(IDN_EMPLMT_INDIV__r.IDN_CLIENT__r.Is_Peak_Data__c),NOT(IDN_EMPLMT_INDIV__r.IDN_CLIENT__r.Is_CBMS_Data__c), TEXT(CDE_TYPE_INFO_EMPLMT__c) = &apos;ML&apos; , DTE_BEGIN_EFFV__c &gt; Today())</errorConditionFormula>
        <errorDisplayField>DTE_BEGIN_EFFV__c</errorDisplayField>
        <errorMessage>Effective Begin Date must be a past date for maternity/medical leave.</errorMessage>
    </validationRules-->
    
    <validationRules>
        <fullName>Required_Verified_for_ML</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT(IDN_EMPLMT_INDIV__r.IDN_CLIENT__r.Is_Peak_Data__c),NOT(IDN_EMPLMT_INDIV__r.IDN_CLIENT__r.Is_CBMS_Data__c),OR( TEXT(CDE_TYPE_INFO_EMPLMT__c )=&apos;ML&apos;, TEXT(CDE_TYPE_INFO_EMPLMT__c )=&apos;MPL&apos;), ISBLANK(TEXT( CDE_TYPE_VERIF__c )))</errorConditionFormula>
        <errorDisplayField>CDE_TYPE_VERIF__c</errorDisplayField>
        <errorMessage>When Temporary Break Type is medical or maternity/paternity, verified is a required field</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
