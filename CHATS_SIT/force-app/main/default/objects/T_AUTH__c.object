    <!-- Added as part of HF_CHATS_20_09_2018_1 -->
    <validationRules>
        <fullName>Age_Appropriate_Immunization</fullName>
        <active>true</active>
        <errorConditionFormula>AND( NOT($Permission.System_Administrator ),NOT(CONTAINS( LEFT(  OwnerId , 15) ,LEFT($Label.ByPass_Auth_validation, 15))),ISPICKVAL( CDE_REL_PROVR__c , &apos;1&apos;),OR(ISPICKVAL( CDE_IMM__c , &apos;NMD&apos;),ISPICKVAL( CDE_IMM__c , &apos;NRL&apos;),ISPICKVAL( CDE_IMM__c , &apos;NNW&apos;),ISPICKVAL( CDE_IMM__c , &apos;NW&apos;) ))</errorConditionFormula>
        <errorDisplayField>CDE_IMM__c</errorDisplayField>
        <errorMessage>&apos;Yes. Immunized&apos; value is required for Immunized if Provider Location / Relation to Child is selected as &apos;Out of home non-relative&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BeginDateCannotBeBeforeChildDOB</fullName>
        <active>true</active>
        <description>Authorization Begin Date cannot be before the Child Eligibility Begin date</description>
        <errorConditionFormula>AND(ISNEW(),DTE_BEGIN_EFFV_AUTH__c  &lt;  IDN_CLIENT__r.DTE_DOB__c)</errorConditionFormula>
        <errorDisplayField>DTE_BEGIN_EFFV_AUTH__c</errorDisplayField>
        <errorMessage>Authorization Begin Date cannot be before the Child&apos;s Date of Birth</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BeginDateCannotBeMoreThan4WeeksFuture</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT( ISCHANGED( DTE_BEGIN_SLOT__c ) ) , NOT ( ISCHANGED( IDN_SLOT_CONTRACT__c ) ),NOT($Permission.System_Administrator ),NOT(CONTAINS( LEFT(OwnerId , 15) ,LEFT($Label.ByPass_Auth_validation, 15))), DTE_BEGIN_EFFV_AUTH__c > (TODAY()+VALUE($Label.AllowedDays_Authorization_Begin_Date)))
</errorConditionFormula>
        <errorDisplayField>DTE_BEGIN_EFFV_AUTH__c</errorDisplayField>
        <errorMessage>Authorization Begin Date cannot be more than 60 days into the future.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Begin_Date_Cannot_Be_Updated</fullName>
        <active>true</active>
        <description>Begin Date Cannot be Updated Once the record has been created</description>
        <errorConditionFormula>ISCHANGED(DTE_BEGIN_EFFV_AUTH__c)</errorConditionFormula>
        <errorDisplayField>DTE_BEGIN_EFFV_AUTH__c</errorDisplayField>
        <errorMessage>Authorization Begin Date Cannot be updated Once the Record has been created</errorMessage>
    </validationRules>
    <!--Commented as part of CCCAP-10798-->
    <!--validationRules>
        <fullName>Begin_Date_Prior_Case_Redeterimnation</fullName>
        <active>false</active>
        <description>Authorization Begin Date cannot be greater than the Case Redetermination Due Date on the case</description>
        <errorConditionFormula>AND(ISNEW(),DTE_BEGIN_EFFV_AUTH__c &gt; Case_Redertimination_Date__c)</errorConditionFormula>
        <errorDisplayField>DTE_BEGIN_EFFV_AUTH__c</errorDisplayField>
        <errorMessage>Authorization Begin Date cannot be greater than the Case Redetermination Due Date on the case</errorMessage>
    </validationRules-->
    <validationRules>
        <fullName>Begin_Date_Prior_To_9_Days</fullName>
        <active>true</active>
        <errorConditionFormula>AND((ISNEW()) ,DTE_BEGIN_EFFV_AUTH__c  &lt; (TODAY()-9))</errorConditionFormula>
        <errorDisplayField>DTE_BEGIN_EFFV_AUTH__c</errorDisplayField>
        <errorMessage>Cannot be prior to {today + 9 days in the past}</errorMessage>
    </validationRules>    
    <validationRules>
        <fullName>Cannot_Update_Client_Or_Case</fullName>
        <active>true</active>
        <errorConditionFormula>AND(!ISNEW(),OR(ISCHANGED(IDN_CLIENT__c),ISCHANGED(IDN_CASE__c)))</errorConditionFormula>
        <errorMessage>Case or Client cannot be updated once the record is created.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Cannot_Update_Provider</fullName>
        <active>true</active>
        <errorConditionFormula>ISCHANGED( IDN_PROVR__c)</errorConditionFormula>
        <errorMessage>Provider Cannot be updated once the record is created</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Not_Allowed_Provider_Location_Relation</fullName>
        <active>true</active>
        <description>CHAT-250 Do not allow user to populate if IDN_PROVR does not belong to a quality exempt provider (EFACH) (T_CHATS_PROVR_STATUS.CDE_TYPE_PROVR = &apos;EFACH&apos; )&quot;</description>
        <errorConditionFormula>AND(NOT($Permission.System_Administrator ),NOT(CONTAINS( LEFT(  OwnerId , 15) ,LEFT($Label.ByPass_Auth_validation, 15))), IF((ISNEW()),AND(NOT(ISPICKVAL(CDE_REL_PROVR__c, &apos;&apos;)), NOT(ISPICKVAL(IDN_PROVR__r.CDE_TYPE_PROVR__c,&apos;EFACH&apos;))),
	AND((ISCHANGED(CDE_REL_PROVR__c)),NOT(ISPICKVAL(CDE_REL_PROVR__c, &apos;&apos;)), NOT(ISPICKVAL(IDN_PROVR__r.CDE_TYPE_PROVR__c,&apos;EFACH&apos;)))))</errorConditionFormula>
        <errorDisplayField>CDE_REL_PROVR__c</errorDisplayField>
        <errorMessage>Not allowed to populate if Provider ID does not belong to a Quality Exempt</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>provr_id_cannot_be_null_insert</fullName>
        <active>true</active>
        <description>check if provider id is passed while creating the new authorization</description>
        <errorConditionFormula>AND(ISNEW(),ISBLANK( IDN_PROVR__c ))</errorConditionFormula>
        <errorMessage>Error occurred while creating the Authorization. Please re-select the Provider ID and try again.</errorMessage>
    </validationRules> 
    <validationRules>
        <fullName>Req_Provider_Location_Relation</fullName>
        <active>true</active>
        <description>CHAT-250 Required if IDN_PROVR belongs to a quality exempt provider (EFACH) (T_CHATS_PROVR_STATUS.CDE_TYPE_PROVR = &apos;EFACH&apos; )</description>
        <errorConditionFormula>AND(NOT($Permission.System_Administrator),NOT(CONTAINS( LEFT(  OwnerId , 15) ,LEFT($Label.ByPass_Auth_validation, 15))), ISPICKVAL(CDE_REL_PROVR__c, &apos;&apos;),  ISPICKVAL(IDN_PROVR__r.CDE_TYPE_PROVR__c,&apos;EFACH&apos;) )</errorConditionFormula>
        <errorDisplayField>CDE_REL_PROVR__c</errorDisplayField>
        <errorMessage>Required if Provider ID belongs to a Quality Exempt</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_Immunization_How_Verified</fullName>
        <active>true</active>
        <description>Immunization How verified is required if Immunization How Verified is Written Verification.</description>
        <errorConditionFormula>AND(NOT($Permission.System_Administrator),NOT(CONTAINS( LEFT(  OwnerId , 15) ,LEFT($Label.ByPass_Auth_validation, 15))), ISPICKVAL(CDE_TYPE_VERIF__c , &apos;V&apos; ), ISBLANK(TEXT(CDE_SOURCE_VRFYD_IMMU__c)))</errorConditionFormula>
        <errorDisplayField>CDE_SOURCE_VRFYD_IMMU__c</errorDisplayField>
        <errorMessage>Immunization How verified is required if Immunization How Verified is Written Verification</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_Immunization_Verified</fullName>
        <active>true</active>
        <description>CHAT-245:  Immunization Verified T_AUTH CDE_TYPE_VERIF Y Required if CDE_IMM is not blank</description>
        <errorConditionFormula>AND(NOT($Permission.System_Administrator),NOT(CONTAINS( LEFT(  OwnerId , 15) ,LEFT($Label.ByPass_Auth_validation, 15))), !ISBLANK(TEXT( CDE_IMM__c )), ISBLANK(TEXT( CDE_TYPE_VERIF__c )))</errorConditionFormula>
        <errorDisplayField>CDE_TYPE_VERIF__c</errorDisplayField>
        <errorMessage>Immunization Verified is Required when Immunized is not blank</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_Immunized</fullName>
        <active>true</active>
        <description>CHAT-245: Immunized T_AUTH CDE_IMM Y Required if CDE_REL_PROVR is &apos;Out of Home, Non-Relative&apos;</description>
        <errorConditionFormula>AND(NOT($Permission.System_Administrator),NOT(CONTAINS( LEFT(  OwnerId , 15) ,LEFT($Label.ByPass_Auth_validation, 15))), ISBLANK(TEXT( CDE_IMM__c )) ,  ISPICKVAL( CDE_REL_PROVR__c , &apos;1&apos;) )</errorConditionFormula>
        <errorMessage>A value is required for Immunized if Provider Location / Relation to Child is selected as &apos;Out of home non-relative&apos;</errorMessage>
    </validationRules>
	<validationRules>
		<fullName>Req_Rel_Child_In_Care</fullName>
		<active>true</active>
		<description>CCCAP-12773 : Field is required if the ‘Provider Location/Relative Status’ is Out of Home Relative or In-Home Relative.</description>
		<errorConditionFormula>AND(NOT($Permission.System_Administrator),NOT(CONTAINS( LEFT( OwnerId , 15) ,LEFT($Label.ByPass_Auth_validation, 15))), OR(ISPICKVAL(CDE_REL_PROVR__c, &apos;2&apos;), ISPICKVAL(CDE_REL_PROVR__c, &apos;4&apos;)),ISPICKVAL(CDE_PRO_REL_CHLD__c, &apos;&apos;))</errorConditionFormula>
		<errorDisplayField>CDE_PRO_REL_CHLD__c</errorDisplayField>
		<errorMessage>Required if ‘Provider Location/Relative Status’ is Out of Home Relative or In-Home Relative.</errorMessage>
	</validationRules>
	<validationRules>
		<fullName>Req_Prov_In_Diff_Residence</fullName>
		<active>true</active>
		<description>CCCAP-12773 : Required field if the Provider Relationship to Child in Care is Brother or Sister</description>
		<errorConditionFormula>AND(NOT($Permission.System_Administrator),NOT(CONTAINS( LEFT( OwnerId , 15) ,LEFT($Label.ByPass_Auth_validation, 15))), OR(ISPICKVAL(CDE_PRO_REL_CHLD__c, &apos;B&apos;), ISPICKVAL(CDE_PRO_REL_CHLD__c, &apos;S&apos;)),ISPICKVAL(CDE_PROV_DIFF_RESI__c, &apos;&apos;))</errorConditionFormula>
		<errorDisplayField>CDE_PROV_DIFF_RESI__c</errorDisplayField>
		<errorMessage>Required if the &quot;Provider Relationship to Child in Care&quot; is Brother or Sister</errorMessage>
	</validationRules>
    <visibility>Public</visibility>  
</CustomObject>
