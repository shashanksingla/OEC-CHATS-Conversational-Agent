<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionOverrides>
        <actionName>CancelEdit</actionName>
        <type>Default</type>
    </actionOverrides>
    <actionOverrides>
        <actionName>SaveEdit</actionName>
        <type>Default</type>
    </actionOverrides>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>ContentSize</fullName>
    </fields>
    <fields>
        <fullName>Description</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>FileExtension</fullName>
    </fields>
    <fields>
        <fullName>FileType</fullName>
    </fields>
    <fields>
        <fullName>IsAssetEnabled</fullName>
    </fields>
    <fields>
        <fullName>Language</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>OwnerId</fullName>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>SharingOption</fullName>
        <trackHistory>true</trackHistory>
    </fields>
    <fields>
        <fullName>SharingPrivacy</fullName>
        <trackHistory>true</trackHistory>
    </fields>
    <fields>
        <fullName>TagCsv</fullName>
    </fields>
    <fields>
        <fullName>Title</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <searchLayouts>
        <searchResultsAdditionalFields>VERSION.TITLE</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>VERSION.CONTENT_SIZE</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>VERSION.FILE_EXTENSION</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>VERSION.LAST_UPDATE</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>VERSION.OWNER</searchResultsAdditionalFields>
    </searchLayouts>
    <validationRules>
        <fullName>Unsupported_FileType_Upload</fullName>
        <active>false</active>
        <description>This rule ensures only allowed file types can be uploaded in CHATS system</description>
        <errorConditionFormula>CONTAINS(FileType ,&apos;EXE&apos; )  || CONTAINS(FileType ,&apos;AVI&apos; ) || CONTAINS(FileType ,&apos;MSG&apos;) || CONTAINS(FileType ,&apos;WRF&apos;) || CONTAINS(FileType ,&apos;HTML&apos;) || CONTAINS(FileType ,&apos;ACGI&apos;) || CONTAINS(FileType ,&apos;HTM&apos;) || CONTAINS(FileType ,&apos;HTX&apos;) || CONTAINS(FileType ,&apos;SHTM&apos;) || CONTAINS(FileType ,&apos;SHTML&apos;) ||  CONTAINS(FileType ,&apos;JSON&apos;) || CONTAINS(FileType ,&apos;MHT&apos;) || CONTAINS(FileType ,&apos;MHTM&apos;) || CONTAINS(FileType ,&apos;MHTML&apos;) || CONTAINS(FileType ,&apos;MOV&apos;) || CONTAINS(FileType ,&apos;MP3&apos;)  || CONTAINS(FileType ,&apos;MP4&apos;) || CONTAINS(FileType ,&apos;MPEG&apos;) || CONTAINS(FileType ,&apos;MPG&apos;) || CONTAINS(FileType ,&apos;SVG&apos;) || CONTAINS(FileType ,&apos;SVGZ&apos;) || CONTAINS(FileType ,&apos;SWF&apos;) || CONTAINS(FileType ,&apos;,TXML&apos;) || CONTAINS(FileType ,&apos;UNKNOWN&apos;) || CONTAINS(FileType ,&apos;WAV&apos;) || CONTAINS(FileType ,&apos;WMA&apos;) || CONTAINS(FileType ,&apos;WMV&apos;) || CONTAINS(FileType ,&apos;XHTML&apos;) || CONTAINS(FileType ,&apos;XML&apos;) || CONTAINS(FileType ,&apos;HTT&apos;)</errorConditionFormula>
        <errorDisplayField>FileExtension</errorDisplayField>
        <errorMessage>This file type is not supported. Please upload an accepted file type.</errorMessage>
    </validationRules>
</CustomObject>
