    <fields>
        <fullName>Requested_By__c</fullName>
        <externalId>false</externalId>
        <formula>IF(RSN_CODE__c = &apos;CR0003&apos;||RSN_CODE__c = &apos;CR0006&apos;||RSN_CODE__c = &apos;CR0001&apos; || RSN_CODE__c = &apos;CR0002&apos; || RSN_CODE__c  = &apos;CR0023&apos; , IDN_CASE__r.Owner:User.FirstName +&apos; &apos;+IDN_CASE__r.Owner:User.LastName ,
            IF(RSN_CODE__c = &apos;CR0007&apos;, IDN_AGRMT_FISCAL__r.Owner:User.FirstName +&apos; &apos;+IDN_AGRMT_FISCAL__r.Owner:User.LastName,
            IF(RSN_CODE__c = &apos;CR0009&apos;||RSN_CODE__c = &apos;CR0011&apos;, IDN_ADJMT__r.Owner:User.FirstName+&apos; &apos;+IDN_ADJMT__r.Owner:User.LastName ,
            IF(RSN_CODE__c = &apos;CR0010&apos;, IF( NOT( ISBLANK(IDN_CASE__c) ) , IDN_CASE__r.Owner:User.FirstName + &apos; &apos; + IDN_CASE__r.Owner:User.LastName , IDN_AUTH__r.IDN_CASE__r.Owner:User.FirstName + &apos; &apos; + IDN_AUTH__r.IDN_CASE__r.Owner:User.LastName ),
            Owner:User.FirstName+&apos; &apos;+Owner:User.LastName ) ) ) )</formula>
        <label>Requested By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
