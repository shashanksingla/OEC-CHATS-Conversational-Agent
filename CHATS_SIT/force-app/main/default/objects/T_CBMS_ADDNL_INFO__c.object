    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules> 
        <fullName>AMT_TANF_INCOME_HH_GROSS_NOT_BLANK</fullName>
        <active>true</active>
        <description>Gross Household income without TANF cannot be less than 0.</description>
        <errorConditionFormula>AMT_TANF_INCOME_HH_GROSS__c &lt; 0</errorConditionFormula>
        <errorDisplayField>AMT_TANF_INCOME_HH_GROSS__c</errorDisplayField>
        <errorMessage>Gross Household income without TANF cannot be less than 0.</errorMessage>
    </validationRules>
    <!--Commented as part of CCCAP-10798-->
     <!--validationRules>
        <fullName>Effective_End_Date_GreaterThn_Begin_Date</fullName>
        <active>false</active>
        <description>Effective End Date must be equal to or greater than the Effective Begin Date.</description>
        <errorConditionFormula>DTE_END_EFFEV__c &lt; DTE_BEGIN_EFFEV__c</errorConditionFormula>
        <errorMessage>Effective End Date must be equal to or greater than the Effective Begin Date.</errorMessage>
    </validationRules-->
    <validationRules>
        <fullName>Closed_Case_Validation</fullName>
    <active>true</active>
    <description>Closed Case Validation</description>
    <errorConditionFormula>IF(IDN_CASE_CHATS__r.CLOSED_CASES_STATUS__c &gt;0, true, false)</errorConditionFormula>
    <errorMessage>Cannot update when the case is in Closed Status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Income_Frequency_Required_Validation</fullName>
        <active>true</active>
        <description>Income Frequency is required if Gross Household income without TANF field is not empty</description>
        <errorConditionFormula>NOT(ISBLANK(AMT_TANF_INCOME_HH_GROSS__c)) &amp;&amp; ISBLANK(TEXT(CDE_FREQ_INCOME__c))</errorConditionFormula>
        <errorMessage>Income Frequency is required if Gross Household income without TANF field is not empty</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
