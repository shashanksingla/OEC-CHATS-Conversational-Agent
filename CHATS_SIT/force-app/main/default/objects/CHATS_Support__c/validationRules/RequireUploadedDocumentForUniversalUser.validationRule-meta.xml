<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RequireUploadedDocumentForUniversalUser</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL( Access_Level_Requested__c,&apos;Universal User&apos;), RecordType.DeveloperName =&apos;System_Access_Request&apos;,! Uploaded_Document__c )</errorConditionFormula>
    <errorDisplayField>Uploaded_Document__c</errorDisplayField>
    <errorMessage>You must attach your County&apos;s policy for separation of duties if you are requesting Universal User access.</errorMessage>
</ValidationRule>
