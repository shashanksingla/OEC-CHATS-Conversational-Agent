    <fields>
        <fullName>CDE_RATE_TYPE__c</fullName>
        <description>Rate Type</description>
        <externalId>false</externalId>
        <label>Rate Type</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>R00751</valueSetName>
        </valueSet>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Delete_Button_Visibility__c</fullName>
        <externalId>false</externalId>
        <formula>AND(
            OR( Is_Flow_Completed__c == false, RecordType.Name == &apos;Future&apos;),
            OR(
                TEXT(IDN_AGRMT_FISCAL__r.CDE_COUNTY__r.CDE_COUNTY__c) == TEXT($User.Owner_County__c),
                CONTAINS(&apos;;&apos; &amp; $User.Common_County_Text__c &amp; &apos;;&apos;, &apos;;&apos; &amp; TEXT(IDN_AGRMT_FISCAL__r.CDE_COUNTY__r.CDE_COUNTY__c) &amp; &apos;;&apos;) ,         
                $Permission.System_Administrator
            )
            )</formula>
        <label>Delete Button Visibility</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>DTE_BEGIN_EFFV__c</fullName>
        <description>Effective Begin Date</description>
        <externalId>false</externalId>
        <label>Effective Begin Date</label>
