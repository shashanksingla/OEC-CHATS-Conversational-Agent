    <fields>
        <fullName>AMT_PLAN_PMT_PCT_MIN__c</fullName>
        <description>Minimum Deduction Amount</description>
        <externalId>false</externalId>
        <label>Minimum Deduction Amount</label>
        <precision>11</precision>
        <required>false</required>
        <scale>2</scale>
