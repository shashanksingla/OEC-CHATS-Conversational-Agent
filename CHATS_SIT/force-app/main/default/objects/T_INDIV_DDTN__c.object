    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel> 
    <validationRules>
        <fullName>EndDateCannotBeGreaterThanStartDate</fullName>
        <active>true</active>
        <errorConditionFormula>DTE_END_EFFV__c  &lt;  DTE_BEGIN_EFFV__c</errorConditionFormula>
        <errorDisplayField>DTE_END_EFFV__c</errorDisplayField>
        <errorMessage>Effective End Date cannot be Prior to Effective Begin Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Req_CDE_SOURCE_VRFYD_DOCKET</fullName>
        <active>true</active>
        <description>CDE_SOURCE_VRFYD_DOCKET is required if CDE_VRFYD_DOCKET is &quot;Written Verification&quot;</description>
        <errorConditionFormula>AND(NOT( IDN_CLIENT__r.Is_Peak_Data__c ),ISBLANK(TEXT(CDE_SOURCE_VRFYD_DOCKET__c)) ,  ISPICKVAL(CDE_VRFYD_DOCKET__c , &apos;V&apos;) )</errorConditionFormula>
        <errorDisplayField>CDE_SOURCE_VRFYD_DOCKET__c</errorDisplayField>
        <errorMessage>Required if Docket Verified is &apos;Written Verification&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_Source_How_Verified</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT( IDN_CLIENT__r.Is_Peak_Data__c ),ISPICKVAL(CDE_TYPE_VERIF__c, &apos;V&apos;) , ISPICKVAL(CDE_SOURCE_VRFYD_DTDN__c, &apos;&apos;)  )</errorConditionFormula>
        <errorDisplayField>CDE_SOURCE_VRFYD_DTDN__c</errorDisplayField>
        <errorMessage>A Value Is Required When Deduction Verified is Written Verification</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Warning_Message_before_saving_the_record</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT( IDN_CLIENT__r.Is_Peak_Data__c ),NOT(IDN_CLIENT__r.Is_Primary_Parent_Caretaker__c),IDN_CLIENT__r.Age__c &lt; VALUE( $Label.Teen_Parent_Age_Limit ),NOT(IDN_CLIENT__r.Has_Allowed_Relationship__c),NOT(Ignore__c))</errorConditionFormula>
        <errorMessage>This record may not be appropriate for this individual based on their age and/or relationship to the primary caretaker of this case(to continue saving please tick Ignore checkbox)</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
