	<fields>
        <fullName>Service_Period_Dates__c</fullName>
        <description>Used for the sub payment search logic for service period lookup</description>
        <externalId>false</externalId>
        <formula>TEXT(MONTH(DTE_BEGIN_EFFV__c)) &amp; &apos;/&apos; &amp; TEXT(DAY(DTE_BEGIN_EFFV__c)) &amp; &apos;/&apos; &amp; TEXT(YEAR(DTE_BEGIN_EFFV__c)) &amp; &apos; To &apos; &amp;
TEXT(MONTH(DTE_END_EFFV__c)) &amp; &apos;/&apos; &amp; TEXT(DAY(DTE_END_EFFV__c)) &amp; &apos;/&apos; &amp; TEXT(YEAR(DTE_END_EFFV__c))</formula>
        <label>Service Period Dates</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>DTE_BEGIN_EFFV_Formatted__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(MONTH(DTE_BEGIN_EFFV__c))+&quot;-&quot; +TEXT(DAY(DTE_BEGIN_EFFV__c))+&quot;-&quot; +TEXT(YEAR(DTE_BEGIN_EFFV__c))</formula>
        <label>Effective Begin Date (MM-DD-YYYY)</label>
        <required>false</required>
