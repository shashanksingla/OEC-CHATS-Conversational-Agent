        <externalId>false</externalId>
        <label>Total Number Of Worth Days</label>
        <summarizedField>T_EMPLMT_PAY_STUB__c.Number_Of_Worth_Days_Per_Frequency__c</summarizedField>
        <summaryForeignKey>T_EMPLMT_PAY_STUB__c.IDN_EMPLMT_INCOME__c</summaryForeignKey>
