    <listViews>
        <fullName>All1</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>{0}</displayFormat>
        <label>Income ID</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Employment Income</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Estimated_Annual_Income_Greater_than_0</fullName>
        <active>true</active>
        <description>Estimated Annual Income cannot be less than 0.</description>
        <errorConditionFormula>NOT( IDN_EMPLMT_INDIV__r.IDN_CLIENT__r.Is_Peak_Data__c ) &amp;&amp; AMT_INCOME_ANNUAL_ESTMD__c&lt;0</errorConditionFormula>
        <errorDisplayField>AMT_INCOME_ANNUAL_ESTMD__c</errorDisplayField>
        <errorMessage>Estimated Annual Income cannot be less than 0.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Estimated_Hours_per_Week_Greater_than_0</fullName>
        <active>true</active>
        <description>Estimated Hours per Week cannot be less than 0.</description>
        <errorConditionFormula>NOT( IDN_EMPLMT_INDIV__r.IDN_CLIENT__r.Is_Peak_Data__c ) &amp;&amp; CNT_WEEK_PER_HOURS_ESTMD__c&lt;0</errorConditionFormula>
        <errorDisplayField>CNT_WEEK_PER_HOURS_ESTMD__c</errorDisplayField>
        <errorMessage>Estimated Hours per Week cannot be less than 0.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Req_if_Estimated_Income_Frequency_is_HLY</fullName>
        <active>true</active>
        <description>Required if CDE_FREQ_PAY_ESTMD = Hourly</description>
        <errorConditionFormula>AND( NOT( IDN_EMPLMT_INDIV__r.IDN_CLIENT__r.Is_Peak_Data__c ), ISBLANK(CNT_WEEK_PER_HOURS_ESTMD__c) ,  ISPICKVAL(CDE_FREQ_PAY_ESTMD__c, &apos;HLY&apos;) )</errorConditionFormula>
        <errorDisplayField>CNT_WEEK_PER_HOURS_ESTMD__c</errorDisplayField>
        <errorMessage>Required if Estimated Income Frequency is Hourly</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>If_30_days_Paystub_selected_as_No</fullName>
        <active>true</active>
        <description>Estimated Income ,Estimated Income Frequency and Estimated Hours per week is required when 30 days of  Paystub is selected as No</description>
        <errorConditionFormula>OR(	And( ISNEW(), OR( ISNULL(AMT_INCOME_ANNUAL_ESTMD__c), ISNULL(CNT_WEEK_PER_HOURS_ESTMD__c), ISPICKVAL(CDE_FREQ_PAY_ESTMD__c, '')), text(IDN_EMPLMT_INDIV__r.IND_STUBS_PAY_RCVS__c) =='Y', Is_Peak_Data__c == false ),
	And( NOT( ISNEW() ), ISPICKVAL( CDE_STATUS__c , 'ACT'), OR( ISNULL(AMT_INCOME_ANNUAL_ESTMD__c), ISNULL(CNT_WEEK_PER_HOURS_ESTMD__c), ISPICKVAL(CDE_FREQ_PAY_ESTMD__c, '')), text(IDN_EMPLMT_INDIV__r.IND_STUBS_PAY_RCVS__c) =='Y', Is_Peak_Data__c == false)	)
	      </errorConditionFormula>
        <errorMessage>These required fields must be completed: Estimated Income, Estimated Hours per Week and Estimated Income Frequency</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>EstimatedHoursWeekRequired</fullName>
        <active>true</active>
        <description>Estimated Hours per Week is required when Estimated Income is Entered</description>
        <errorConditionFormula>OR( AND( ISNEW(),!ISNULL( AMT_INCOME_ANNUAL_ESTMD__c ) ,  ISNULL(CNT_WEEK_PER_HOURS_ESTMD__c  ), Is_Peak_Data__c == false, Is_CBMS_Data__c == false ),
	AND( NOT( ISNEW() ), ISPICKVAL(CDE_STATUS__C, 'ACT'), !ISNULL( AMT_INCOME_ANNUAL_ESTMD__c ) ,  ISNULL(CNT_WEEK_PER_HOURS_ESTMD__c ),Is_Peak_Data__c == false,Is_CBMS_Data__c == false ))
	</errorConditionFormula>
        <errorDisplayField>CNT_WEEK_PER_HOURS_ESTMD__c</errorDisplayField>
        <errorMessage>Estimated Hours per Week is required when Estimated Income is Entered</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Req_CDE_SOURCE_VRFYD_SE</fullName>
        <active>true</active>
        <description>CDE_SOURCE_VRFYD_PAY is required when CDE_TYPE_VERIF is &quot;Written Verification&quot;</description>
        <errorConditionFormula>AND(
 NOT(IDN_EMPLMT_INDIV__r.IDN_CLIENT__r.Is_Peak_Data__c),
 NOT(IDN_EMPLMT_INDIV__r.IDN_CLIENT__r.Is_CBMS_Data__c),
 ISPICKVAL( CDE_SOURCE_VRFYD_PAY__c, &apos;&apos;),
 ISPICKVAL(CDE_TYPE_VERIF__c, &apos;V&apos;),
 NOT(ISCHANGED(Total_Number_Of_Paystubs__c))
)</errorConditionFormula>
        <errorDisplayField>CDE_SOURCE_VRFYD_PAY__c</errorDisplayField>
        <errorMessage>How Verified is required if Verified is &apos;Written Verification&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Req_CDE_TYPE_VERIF</fullName>
        <active>true</active>
        <description>CDE_TYPE_VERIF is required for Self-Employment</description>
        <errorConditionFormula>AND(
 NOT(IDN_EMPLMT_INDIV__r.IDN_CLIENT__r.Is_Peak_Data__c),
 NOT(IDN_EMPLMT_INDIV__r.IDN_CLIENT__r.Is_CBMS_Data__c),
 ISPICKVAL( CDE_TYPE_VERIF__c, &apos;&apos;),
 ISPICKVAL(CDE_STATUS__c, &apos;ACT&apos;),
 IDN_EMPLMT_INDIV__r.RecordType.DeveloperName = &apos;Self_Employment&apos;
)</errorConditionFormula>
        <errorDisplayField>CDE_TYPE_VERIF__c</errorDisplayField>
        <errorMessage>Verified is required for Self Employment</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Req_CDE_TYPE_VERIF_2</fullName>
        <active>true</active>
        <description>CDE_TYPE_VERIF is required for Employment when AMT_INCOME_ANNUAL_ESTMD is not empty</description>
        <errorConditionFormula>AND(
 NOT(IDN_EMPLMT_INDIV__r.IDN_CLIENT__r.Is_Peak_Data__c),
 NOT(IDN_EMPLMT_INDIV__r.IDN_CLIENT__r.Is_CBMS_Data__c),
 ISPICKVAL(CDE_TYPE_VERIF__c , &apos;&apos;),
 ISPICKVAL(CDE_STATUS__c, &apos;ACT&apos;),
 IDN_EMPLMT_INDIV__r.RecordType.DeveloperName = &apos;Employment&apos;,
 AMT_INCOME_ANNUAL_ESTMD__c &gt; 0 
)</errorConditionFormula>
        <errorDisplayField>CDE_TYPE_VERIF__c</errorDisplayField>
        <errorMessage>When Estimated Income is used Verified is required</errorMessage>
    </validationRules>
    <visibility>Public</visibility>   
</CustomObject>
