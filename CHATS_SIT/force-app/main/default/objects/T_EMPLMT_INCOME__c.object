    <fields>
        <fullName>AMT_INCOME_ANNUAL_ACTUAL__c</fullName>
        <externalId>false</externalId>
        <formula>If( ISBLANK( Total_Number_Of_Paystubs__c  )||Total_Number_Of_Paystubs__c ==0,0,   (Total_Yearly_Income__c /Total_Number_Of_Paystubs__c)) + Total_One_Time_Income__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Actual Annual Income</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
	    <fields>
        <fullName>Gross_Monthly_Income__c</fullName>
        <externalId>false</externalId>
        <formula>If( ISBLANK( AMT_INCOME_ANNUAL_ACTUAL__c )||AMT_INCOME_ANNUAL_ACTUAL__c ==0,0, AMT_INCOME_ANNUAL_ACTUAL__c /12 )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Gross Monthly Income</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
