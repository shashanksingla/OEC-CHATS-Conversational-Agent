    <fields>
        <fullName>AMT_EXP_ANNUAL_ACTUAL__c</fullName>
        <externalId>false</externalId>
        <formula>If( ISBLANK( IDN_EMPLMT_INDIV__r.Total_Number_Of_Expenses__c )|| IDN_EMPLMT_INDIV__r.Total_Number_Of_Expenses__c ==0,0,  IDN_EMPLMT_INDIV__r.Total_Yearly_Expense__c/IDN_EMPLMT_INDIV__r.Total_Number_Of_Expenses__c  )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Actual Annual Expenses</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending> 
        <type>Number</type>
