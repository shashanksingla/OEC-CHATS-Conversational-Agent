    <validationRules>
        <fullName>Record_Read_only</fullName>
        <active>true</active>
        <description>this is to restrict record edit for Paid or Denied claims</description>
        <errorConditionFormula>AND(
            OR(
            ISPICKVAL( PRIORVALUE(Claim_Status__c),&apos;Denied&apos;),
            ISPICKVAL( PRIORVALUE(Claim_Status__c),&apos;Paid&apos;)
            ),
            NOT(ISNEW())
            )</errorConditionFormula>
        <errorMessage>Paid or Denied Claims are not editable</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Denial_Reason_is_mandatory</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
            ISPICKVAL(Denial_Reason__c,&apos;&apos;) ,
            ISPICKVAL(Claim_Status__c ,&apos;Denied&apos;)
            )</errorConditionFormula>
        <errorDisplayField>Denial_Reason__c</errorDisplayField>
        <errorMessage>Denial Reason is mandatory for a Denied Claim.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Adjustment_County_matching_Claim_County</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
            NOT(ISNEW()),
            NOT(ISBLANK(Adjustment__c)),
            OR(
            County_Code__c != Adjustment__r.CDE_COUNTY__r.CDE_COUNTY__c,
            Provider_Id__c != Adjustment__r.IDN_PROVR__r.Name ,
            NOT(ISPICKVAL(Adjustment__r.CDE_TYPE_ADJMT__c,'1'))
            )
            )</errorConditionFormula>
        <errorDisplayField>Adjustment__c</errorDisplayField>
        <errorMessage>Adjustment Record must be a Claim associated to same County and Provider ID</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Claim_and_Adjustment_Same_Month</fullName>
        <active>true</active>
        <description>Adjustment must be for same month as Provider Claim record.</description>
        <errorConditionFormula>
            AND(
                NOT(ISBLANK(Adjustment__c)),
            OR(
    TEXT(MONTH( Adjustment__r.DTE_START_ADJMT__c )) &lt;&gt;  TEXT(Care_Month__c) ,
    YEAR( Adjustment__r.DTE_START_ADJMT__c ) &lt;&gt;  Care_Year__c)
    )</errorConditionFormula>
        <errorDisplayField>Adjustment__c</errorDisplayField>
        <errorMessage>Adjustment must be for same month as Provider Claim record.</errorMessage>
    </validationRules>
