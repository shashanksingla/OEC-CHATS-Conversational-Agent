<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Parent_Fee_Delinqc_Amt_LT_Zero</fullName>
    <active>true</active>
    <description>Parent Fee Delinquency Amount cannot be less than Zero</description>
    <errorConditionFormula>AND( NOT( ISBLANK(AMT_DELINQC_COPAY_ENRLMT__c) ),
     AMT_DELINQC_COPAY_ENRLMT__c &lt; 0.0
)</errorConditionFormula>
    <errorDisplayField>AMT_DELINQC_COPAY_ENRLMT__c</errorDisplayField>
    <errorMessage>Parent Fee Delinquency Amount cannot be less than Zero</errorMessage>
</ValidationRule>
