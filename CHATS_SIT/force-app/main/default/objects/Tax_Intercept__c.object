    <label>Tax Intercept</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Tax_Year__c</columns>
        <columns>County__c</columns>
        <columns>Adjustment__c</columns>
        <columns>Case__c</columns>
        <columns>Provider__c</columns>
        <columns>Name__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>UPDATEDBY_USER</columns>
        <columns>LAST_UPDATE</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>This_Year</fullName>
        <columns>NAME</columns>
        <columns>Tax_Year__c</columns>
        <columns>County__c</columns>
        <columns>Adjustment__c</columns>
        <columns>Case__c</columns>
        <columns>Provider__c</columns>
        <columns>Name__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>UPDATEDBY_USER</columns>
        <columns>LAST_UPDATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CREATED_DATE</field>
            <operation>equals</operation>
            <value>THIS_YEAR</value>
        </filters>
        <label>This Year</label>
    </listViews>
    <nameField>
        <displayFormat>TI{YYYY}{MM}{DD}{000000}</displayFormat>
        <label>ID</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Tax Intercepts</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
	<validationRules>
        <fullName>Check_for_Expired_Status</fullName>
        <active>true</active>
        <description>If Status of the Intercept Record is &quot;Expired&quot; then do not allow any updates on the record.</description>
        <errorConditionFormula>NOT(ISNEW()) &amp;&amp; Intercept_Status__c = &apos;Expired&apos;</errorConditionFormula>
        <errorMessage>This Tax Intercept Record is &quot;Expired&quot; and can not be updated.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>