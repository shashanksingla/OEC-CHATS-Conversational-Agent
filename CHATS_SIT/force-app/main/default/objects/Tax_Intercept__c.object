        <description>Unique key for the intercept that was processed, assigned by MIR</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <inlineHelpText>Unique key for the intercept that was processed, assigned by MIR</inlineHelpText>
        <label>Intercept Processed Key</label>
        <length>10</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Intercept_Status__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
(OR((YEAR(TODAY())==(VALUE(Tax_Year__c))),((YEAR(TODAY())-1) == VALUE(Tax_Year__c)))), IF(
NOT(ISBLANK(TEXT(Remove_Reason__c))), &quot;Removed&quot;,
IF(
ISPICKVAL(Reinstate__c, &quot;Y&quot;), &quot;Reinstated&quot;,
&quot;Active&quot;
)
), &quot;Expired&quot;)</formula>
        <label>Intercept Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
