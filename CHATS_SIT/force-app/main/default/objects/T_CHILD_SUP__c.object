    <pluralLabel>Child Support</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Child_Support_End_Date_less_Than_Begin</fullName>
        <active>true</active>
        <description>Co-operation Child Support End Date must be greater than Co-operation Child Support Begin Date</description>
        <errorConditionFormula>NOT( IDN_CLIENT__r.Is_Peak_Data__c ) &amp;&amp; DTE_BEGIN_CS_COOP__c &gt; DTE_END_CS_COOP__c</errorConditionFormula>
        <errorDisplayField>DTE_END_CS_COOP__c</errorDisplayField>
        <errorMessage>Co-operation Child Support End Date must be greater than Co-operation Child Support Begin Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Good_Cause_Begin_Date_Less_than_End_Date</fullName>
        <active>true</active>
        <description>Good Cause Effective End Date must be greater than Good Cause Effective Begin Date.</description>
        <errorConditionFormula>AND(NOT( IDN_CLIENT__r.Is_Peak_Data__c ),OR((DTE_BEGIN_GDC__c &gt; DTE_END_GDC__c),
AND(ISBLANK( DTE_BEGIN_GDC__c ),NOT(ISBLANK( DTE_END_GDC__c )))))</errorConditionFormula>
        <errorDisplayField>DTE_END_GDC__c</errorDisplayField>
        <errorMessage>Good Cause Effective End Date must be greater than Good Cause Effective Begin Date or cannot be filled when Good Cause Begin Date is Blank.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Req_HowVerified_If_VerifType_Writtn</fullName>
        <active>true</active>
        <description>How Verified field is must for verified = &quot;Written Verification&quot;.</description>
        <errorConditionFormula>AND( NOT( IDN_CLIENT__r.Is_Peak_Data__c ),ISPICKVAL(IND_VRFYD__c, &quot;V&quot;) , 
     ISBLANK(TEXT(CDE_SOURCE_VRFD_CODA__c) ) 
)</errorConditionFormula>
        <errorDisplayField>CDE_SOURCE_VRFD_CODA__c</errorDisplayField>
        <errorMessage>How Verified field is must for verified = &quot;Written Verification&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Warning_Message_before_saving_the_record</fullName>
        <active>true</active>
        <description>This record may not be appropriate for this individual based on their age and/or relationship to the primary caretaker of this case</description>
        <errorConditionFormula>AND(NOT( IDN_CLIENT__r.Is_Peak_Data__c ),OR(IDN_CLIENT__r.Is_Primary_Parent_Caretaker__c,IDN_CLIENT__r.Age__c &gt;= 19, AND(IDN_CLIENT__r.Age__c &lt; 19, 
IDN_CLIENT__r.Has_Allowed_Relationship__c)),NOT(Ignore__c))</errorConditionFormula>
        <errorMessage>This record may not be appropriate for this individual based on their age and/or relationship to the primary caretaker of this case(to continue saving please tick Ignore checkbox)</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
