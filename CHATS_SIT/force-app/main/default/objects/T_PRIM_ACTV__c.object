    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>CDE_TYPE_ACTV_Cannot_be_edited</fullName>
        <active>true</active>
        <description>CDE_TYPE_ACTV Cannot be edited after record creation</description>
        <errorConditionFormula>AND(ISCHANGED(CDE_TYPE_ACTV__c),NOT(Is_CBMS_Data__c))</errorConditionFormula>
        <errorDisplayField>CDE_TYPE_ACTV__c</errorDisplayField>
        <errorMessage>Primary Activity cannot be updated</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Cannot_Update_IDN_CLIENT</fullName>
        <active>true</active>
        <errorConditionFormula>ISCHANGED(IDN_CLIENT__c )</errorConditionFormula>
        <errorDisplayField>IDN_CLIENT__c</errorDisplayField>
        <errorMessage>Cannot Update Client ID</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Cannot_Update_IDN_Case</fullName>
        <active>true</active>
        <errorConditionFormula>ISCHANGED( IDN_CASE__c )</errorConditionFormula>
        <errorDisplayField>IDN_CASE__c</errorDisplayField>
        <errorMessage>Cannot Update Case ID</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Effective_End_Date_Validation</fullName>
        <active>true</active>
        <description>Effective End Date must be greater than Effective Begin Date.</description>
        <errorConditionFormula>DTE_BEGIN_ACTV_PRIM__c &gt;= DTE_END_ACTV_PRIM__c</errorConditionFormula>
        <errorDisplayField>DTE_END_ACTV_PRIM__c</errorDisplayField>
        <errorMessage>Effective End Date must be greater than Effective Begin Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Warning_Message_before_saving_the_record</fullName>
        <active>true</active>
        <description>This record may not be appropriate for this individual based on their age and/or relationship to the primary caretaker of this case(to continue saving please tick Ignore checkbox)</description>
        <errorConditionFormula>AND(NOT(IDN_CLIENT__r.Is_Primary_Parent_Caretaker__c),IDN_CLIENT__r.Age__c &lt; VALUE( $Label.Teen_Parent_Age_Limit ),NOT(IDN_CLIENT__r.Has_Allowed_Relationship__c),NOT(Ignore__c))</errorConditionFormula>
        <errorMessage>This record may not be appropriate for this individual based on their age and/or relationship to the primary caretaker of this case(to continue saving please tick Ignore checkbox)</errorMessage>
    </validationRules>
    <validationRules>
    	<fullName>BeginDateWithin31DaysFuture</fullName>
   	    <active>true</active>
    	<description>Begin Date cannot be more than 31 days in the future</description>
    	<errorConditionFormula>DTE_BEGIN_ACTV_PRIM__c &gt;  TODAY() +31</errorConditionFormula>
    	<errorDisplayField>DTE_BEGIN_ACTV_PRIM__c</errorDisplayField>
    	<errorMessage>Begin Date cannot be more than 31 days in the future</errorMessage>
     </validationRules>	
    <visibility>Public</visibility>
</CustomObject>
