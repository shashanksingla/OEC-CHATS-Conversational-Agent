    <label>County Rate Plan</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>IDN_COUNTY__c</columns>
        <columns>DTE_BEGIN_EFFV_RATE__c</columns>
        <columns>DTE_END_EFFV_RATE__c</columns>
        <columns>STATUS__c</columns>
        <columns>CDE_RATE_PLAN_TEMPLT__c</columns>
        <columns>IND_RATE_PLAN_TEMPLT__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>Template_List_View</fullName>
        <columns>NAME</columns>
        <columns>STATUS__c</columns>
        <columns>DTE_BEGIN_EFFV_RATE__c</columns>
        <columns>DTE_END_EFFV_RATE__c</columns>
        <columns>CDE_RATE_PLAN_TEMPLT__c</columns>
        <columns>IND_RATE_PLAN_TEMPLT__c</columns>
        <columns>LAST_UPDATE</columns>
        <columns>IDN_COUNTY__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>IND_RATE_PLAN_TEMPLT__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <label>Template</label>
    </listViews>
    <nameField>
        <displayFormat>{0}</displayFormat>
        <label>ID</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>County Rate Plan</pluralLabel>
    <searchLayouts />
    <sharingModel>Read</sharingModel>
    <!--Commented
    as part of CCCAP-10798-->
    <!--validationRules>
        <fullName>Approved_Plan_cannot_be_updated</fullName>
        <active>false</active>
        <description>Approved Plan cannot be updated</description>
        <errorConditionFormula>OR(AND( NOT(ISCHANGED(CDE_STATUS__c)) ,NOT(ISNEW()),ISPICKVAL(CDE_STATUS__c,
    &apos;APV&apos;)), TEXT(PRIORVALUE(CDE_STATUS__c)) = &apos;APV&apos; )</errorConditionFormula>
        <errorMessage>Approved Plan cannot be updated</errorMessage>
    </validationRules-->
    <validationRules>
        <fullName>Begin_Date_First_Day_of_Month_Future</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
        ISBLANK( County_Rate_Plan__c ),
		IF( ISNEW(),
		IF(OR ( DTE_BEGIN_EFFV_RATE__c &lt;= TODAY() , DAY(DTE_BEGIN_EFFV_RATE__c) &lt;&gt; 1),
		true,
		false),
		IF( AND(
			!ISPICKVAL(CDE_STATUS__c ,&apos;APV&apos;),
		OR ( DTE_BEGIN_EFFV_RATE__c &lt;= TODAY() , DAY(DTE_BEGIN_EFFV_RATE__c) &lt;&gt; 1),
		OR(
			!ISCHANGED( CDE_STATUS__c ),
			AND(
				ISCHANGED( CDE_STATUS__c ),			
				!ISPICKVAL(CDE_STATUS__c ,&apos;NRV&apos;)
			)),
		!ISCHANGED(OwnerId)
		),
		true,
		false )),
		!Is_being_approved_by_Flow__c,
		!ISCHANGED( Bypass_Validation_On__c ))</errorConditionFormula>
        <errorDisplayField>DTE_BEGIN_EFFV_RATE__c</errorDisplayField>
        <errorMessage>Begin Date Should Be First Day Of Future Month</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Template_Record</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
            AND(
            ISBLANK( County_Rate_Plan__c ),
            $UserRole.DeveloperName &lt;&gt; &apos;Template_Administrator&apos; ,
            $UserRole.DeveloperName &lt;&gt; &apos;County_Plan_Approver&apos;
            ),
            OR(
            IND_RATE_PLAN_TEMPLT__c ,
            PRIORVALUE(IND_RATE_PLAN_TEMPLT__c )
            )
            )</errorConditionFormula>
        <errorMessage>Template Records can be modified/checked by Template Administrators only</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>