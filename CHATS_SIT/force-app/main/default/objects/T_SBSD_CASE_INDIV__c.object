    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>Case_Individual_Compact_Layout</compactLayoutAssignment>
    <compactLayouts>
        <fullName>Case_Individual_Compact_Layout</fullName>
        <fields>IDN_STATE__c</fields>
        <fields>First_Name__c</fields>
