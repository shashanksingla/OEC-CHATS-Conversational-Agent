<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Adr_Zip_Extn_Length_4</fullName>
    <active>true</active>
    <description>set Zip Extn address to length 4</description>
    <errorConditionFormula>AND(NOT(ISBLANK(ADR_ZIP_EXTN__c)),
     OR(LEN(ADR_ZIP_EXTN__c) &lt;&gt; 4,
        NOT(ISNUMBER(ADR_ZIP_EXTN__c))
       ) 
   )</errorConditionFormula>
    <errorDisplayField>ADR_ZIP_EXTN__c</errorDisplayField>
    <errorMessage>Zip Extension should be 4 digit number</errorMessage>
</ValidationRule>
