    <validationRules>
        <fullName>Effective_End_Date_less_than_Begin_Date</fullName>
        <active>true</active>
        <description>Effective End Date must be greater than Effective Begin Date.</description>
        <errorConditionFormula>NOT(IDN_CASE_INDIV__r.IDN_CLIENT__r.Is_Peak_Data__c ) &amp;&amp; 
        ((ISNULL(OVERRIDDEN_DTE_BEGIN_EFFV__c) &amp;&amp; DTE_BEGIN_EFFV__c &gt; DTE_END_EFFV__c) || 
        (NOT(ISNULL(OVERRIDDEN_DTE_BEGIN_EFFV__c)) &amp;&amp; OVERRIDDEN_DTE_BEGIN_EFFV__c &gt; DTE_END_EFFV__c))</errorConditionFormula>
        <errorDisplayField>DTE_END_EFFV__c</errorDisplayField>
        <errorMessage>Effective End Date must be greater than Effective Begin Date.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
