    <label>Individual E-mail</label>
    <nameField>
        <displayFormat>EI-{000000}</displayFormat>
        <label>E-mail Information Id</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Individual E-mails</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>PC_email_Not_blank</fullName>
        <active>true</active>
        <description>The email information of PC cannot be blank. CCCAP-14422</description>
        <errorConditionFormula>AND(Individual__r.Is_Primary_Parent_Caretaker__c  ,   ISCHANGED( Email_Information__c )  ,ISBLANK(Email_Information__c) )</errorConditionFormula>
        <errorDisplayField>Email_Information__c</errorDisplayField>
        <errorMessage>Complete the field.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
