    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>All1</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
   <nameField>
        <displayFormat>{0}</displayFormat>
        <label>Asset ID</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Case Asset</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Begin_date_validation</fullName>
        <active>true</active>
        <errorConditionFormula>DTE_BEGIN_EFFV__c  &gt;  DTE_END_EFFV__c</errorConditionFormula>
        <errorMessage>Begin date cannot be greater than the end date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_Liquid_Amount_if_it_has_assets</fullName>
        <active>true</active>
        <description>Please provide Liquid Resource Amount</description>
        <errorConditionFormula>AND( !IDN_CASE__r.Is_Peak_Data__c ,!IDN_CASE__r.Is_CBMS_Data__c,IND_HAS_ASSET__c , ISBLANK(NBR_LIQUID_AMT__c) )</errorConditionFormula>
        <errorDisplayField>NBR_LIQUID_AMT__c</errorDisplayField>
        <errorMessage>Please provide Liquid Resource Amount</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_Non_Liq_Amount_if_it_has_assets</fullName>
        <active>true</active>
        <description>Please provide Non-Liquid Resource Amount.</description>
        <errorConditionFormula>AND( !IDN_CASE__r.Is_Peak_Data__c ,!IDN_CASE__r.Is_CBMS_Data__c, IND_HAS_ASSET__c , ISBLANK(NBR_NON_LIQUID_AMT__c) )</errorConditionFormula>
        <errorDisplayField>NBR_NON_LIQUID_AMT__c</errorDisplayField>
        <errorMessage>Please provide Non-Liquid Resource Amount.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
