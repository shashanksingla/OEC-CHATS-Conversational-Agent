    <description>This custom object will be used to store the sfdc Id of the junk records which will be deleted as part of batch.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableChangeDataCapture>false</enableChangeDataCapture>
