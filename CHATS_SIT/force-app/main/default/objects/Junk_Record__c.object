        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Junk Record</label>
    <nameField>
        <displayFormat>JR-{0000000000}</displayFormat>
        <label>Junk Record Name</label>
