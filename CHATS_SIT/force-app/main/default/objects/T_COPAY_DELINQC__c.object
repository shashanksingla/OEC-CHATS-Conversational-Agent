        <columns>NAME</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>All1</fullName>
        <columns>NAME</columns>
        <columns>DTE_MONTH_DELINQC__c</columns>
        <columns>DTE_RPTD_DELINQC__c</columns>
        <columns>DTE_YEAR_DELINQC__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>{0}</displayFormat>
        <label>Parent Fee Delinquency ID</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Parent Fee Delinquencies</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Delinqc_Rprtd_Date</fullName>
        <active>true</active>
        <description>Delinqency Reported Date must be greater than</description>
        <errorConditionFormula>AND( NOT(ISBLANK(TEXT(DTE_MONTH_DELINQC__c))),
       NOT(ISBLANK(  DTE_YEAR_DELINQC__c  )),
       DTE_RPTD_DELINQC__c &lt; DATE(VALUE(DTE_YEAR_DELINQC__c),
                         VALUE( TEXT( DTE_MONTH_DELINQC__c )),
                         1)
 )</errorConditionFormula>
        <errorDisplayField>DTE_RPTD_DELINQC__c</errorDisplayField>
        <errorMessage>Delinquency Reported Date must be greater than Month &amp; Year of Delinquency</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Parent_Fee_Delinqc_Amt_LT_Zero</fullName>
        <active>true</active>
        <description>Parent Fee Delinquency Amount cannot be less than Zero</description>
        <errorConditionFormula>AND( NOT( ISBLANK(AMT_DELINQC_COPAY_ENRLMT__c) ),
     AMT_DELINQC_COPAY_ENRLMT__c &lt; 0.0
)</errorConditionFormula>
        <errorDisplayField>AMT_DELINQC_COPAY_ENRLMT__c</errorDisplayField>
        <errorMessage>Parent Fee Delinquency Amount cannot be less than Zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_RsltionDate_if_RsltionRsn_NtBlnc</fullName>
        <active>true</active>
        <description>Require Delinquency Resolution Date if Resolution Reason is entered.</description>
        <errorConditionFormula>AND( NOT( ISBLANK( TEXT(CDE_REASON_RESOLN__c)) ), 
ISBLANK( DTE_RESOLN_DELINQC__c ))</errorConditionFormula>
        <errorDisplayField>DTE_RESOLN_DELINQC__c</errorDisplayField>
        <errorMessage>Require Delinquency Resolution Date if Resolution Reason is entered.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_RsltionRsn_if_RsltionDate_NtBlnc</fullName>
        <active>true</active>
        <description>Require Resolution Reason if Delinquency Resolution Date is not blank</description>
        <errorConditionFormula>AND( NOT( ISBLANK(DTE_RESOLN_DELINQC__c) ),
    ISBLANK( TEXT(CDE_REASON_RESOLN__c) )  
)</errorConditionFormula>
        <errorDisplayField>CDE_REASON_RESOLN__c</errorDisplayField>
        <errorMessage>Require Resolution Reason if Delinquency Resolution Date is not blank</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>RsltionDate_Cannot_Be_FutureDate</fullName>
        <active>true</active>
        <description>Delinquency Resolution date cannot be in future</description>
        <errorConditionFormula>DTE_RESOLN_DELINQC__c &gt; TODAY()</errorConditionFormula>
        <errorDisplayField>DTE_RESOLN_DELINQC__c</errorDisplayField>
        <errorMessage>Delinquency Resolution Date cannot be a future date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>RsltionDate_MustBe_Grtrthan_ReprtdDate</fullName>
        <active>true</active>
        <description>Delinquency Resolution Date must be greater than Delinquency Reported Date.</description>
        <errorConditionFormula>DTE_RESOLN_DELINQC__c &lt;= DTE_RPTD_DELINQC__c</errorConditionFormula>
        <errorDisplayField>DTE_RESOLN_DELINQC__c</errorDisplayField>
        <errorMessage>Delinquency Resolution Date must be greater than Delinquency Reported Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Parent_Fee_Delinqc_Amt_Zero</fullName>
        <active>true</active>
        <description>Parent Fee Delinquency amount must be more than 0.00</description>
        <errorConditionFormula>OR(
 ISBLANK(AMT_DELINQC_COPAY_ENRLMT__c),
 AMT_DELINQC_COPAY_ENRLMT__c = 0.0
)</errorConditionFormula>
        <errorDisplayField>AMT_DELINQC_COPAY_ENRLMT__c</errorDisplayField>
        <errorMessage>Parent Fee Delinquency amount must be more than 0.00</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
