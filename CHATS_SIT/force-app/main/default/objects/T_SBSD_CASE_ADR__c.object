    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Adr_Zip_Extn_Length_4</fullName>
        <active>true</active>
        <description>Validation to check Length of Zip Extn is 4</description>
        <errorConditionFormula>AND( !IDN_CASE__r.Is_Peak_Data__c,!IDN_CASE__r.Is_CBMS_Data__c, NOT ( ISBLANK ( ADR_ZIP_EXTN__c ) ), LEN( ADR_ZIP_EXTN__c ) &lt;&gt; 4)</errorConditionFormula>
        <errorDisplayField>ADR_ZIP_EXTN__c</errorDisplayField>
        <errorMessage>Zip Extension should be of 4 digits</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Adr_Zip_Main_Length_5</fullName>
        <active>true</active>
        <description>validate to check the length of field to 5</description>
        <errorConditionFormula>AND( !IDN_CASE__r.Is_Peak_Data__c,!IDN_CASE__r.Is_CBMS_Data__c, NOT ( ISBLANK ( ADR_ZIP_MAIN__c ) ), LEN(  ADR_ZIP_MAIN__c ) &lt;&gt; 5)</errorConditionFormula>
        <errorDisplayField>ADR_ZIP_MAIN__c</errorDisplayField>
        <errorMessage>Zip Address must be of length 5</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Begin_date_validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND( (!ISNEW()) , DTE_BEGIN_EFFV__c  &gt;  DTE_END_EFFV__c )</errorConditionFormula>
        <errorMessage>Begin date cannot be greater than the end date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_Adr_City_if_AdrType_HOME</fullName>
        <active>true</active>
        <description>CHAT-1158: Require Address City if Address Type is Mailing.</description>
        <errorConditionFormula>AND( !IDN_CASE__r.Is_Peak_Data__c,!IDN_CASE__r.Is_CBMS_Data__c, NOT(ISBLANK(TEXT( CDE_TYPE_ADR__c ))),
     ISPICKVAL( CDE_TYPE_ADR__c, &quot;MAL&quot;),
     ISBLANK( ADR_CITY__c ) 
)</errorConditionFormula>
        <errorDisplayField>ADR_CITY__c</errorDisplayField>
        <errorMessage>Require Address City if Address Type is Mailing.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_Adr_Line1_if_AdrType_HOME</fullName>
        <active>true</active>
        <description>CHAT-1159: Require Address City if Address Type is Mailing.</description>
        <errorConditionFormula>AND( !IDN_CASE__r.Is_Peak_Data__c,!IDN_CASE__r.Is_CBMS_Data__c, NOT(ISBLANK(TEXT( CDE_TYPE_ADR__c ))), 
     ISPICKVAL( CDE_TYPE_ADR__c, &quot;MAL&quot;), 
     ISBLANK(  ADR_LINE_1__c  ) 
)</errorConditionFormula>
        <errorDisplayField>ADR_LINE_1__c</errorDisplayField>
        <errorMessage>Require Address Line 1 if Address Type is Mailing.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>req_HowVerified_if_Verified_Written</fullName>
        <active>true</active>
        <description>Require How Verified Field if Verified field is &quot;Written Verification&quot;</description>
        <errorConditionFormula>AND( !IDN_CASE__r.Is_Peak_Data__c,!IDN_CASE__r.Is_CBMS_Data__c, TEXT(CDE_TYPE_VERIF__c) = &apos;V&apos; , ISBLANK(TEXT(CDE_SOURCE_VRFD_ADR__c) ) )</errorConditionFormula>
        <errorDisplayField>CDE_SOURCE_VRFD_ADR__c</errorDisplayField>
        <errorMessage>&quot;How Verified&quot; is required if Verified is &quot;Written Verification&quot;.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
