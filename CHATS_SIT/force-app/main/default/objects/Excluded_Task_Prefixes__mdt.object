<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">    
    <description>Used to store task subject prefixes that are excluded from automated flow email notifications (i.e. task email notifications already handled via Apex or task email notifications that are not required)</description>
    <label>Excluded Task Prefix</label>
    <pluralLabel>Excluded Task Prefixes</pluralLabel>
    <visibility>Public</visibility>
<fields>
    <fullName>Prefix__c</fullName>
    <externalId>false</externalId>
    <fieldManageability>DeveloperControlled</fieldManageability>
    <label>Prefix</label>
    <length>20</length>
    <required>false</required>
    <type>Text</type>
    <unique>false</unique>
</fields>
</CustomObject>