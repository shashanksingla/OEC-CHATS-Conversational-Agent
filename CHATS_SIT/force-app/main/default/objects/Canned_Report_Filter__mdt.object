                </value>
                <value>
                    <fullName>MULTIPICKLIST</fullName>
                    <default>false</default>
                    <label>Picklist(Multi-Select)</label>
                </value>
                <value>
                    <fullName>STRING</fullName>
                    <default>false</default>
                    <label>Text</label>
                </value>
                <value>
                    <fullName>Month/Year</fullName>
                    <default>false</default>
                    <label>Month/Year</label>
                </value>
            </valueSetDefinition>
        </valueSet>
