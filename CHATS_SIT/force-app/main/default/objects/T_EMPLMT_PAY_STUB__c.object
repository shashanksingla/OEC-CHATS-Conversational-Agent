    <validationRules>
        <fullName>Pay_Date_CannotBe_b4_Inc_Effv_Date</fullName>
        <active>true</active>
        <description>Pay Date Cannot be before Income Effective Date and Employment Begin Date</description>
        <errorConditionFormula>OR(
AND( 
     NOT( ISBLANK( DTE_PAY__c ) ),
     NOT( ISBLANK( IDN_EMPLMT_INCOME__c  ) ),
     NOT( ISBLANK( IDN_EMPLMT_INCOME__r.DTE_BEGIN_EFFV__c ) ),
     
     NOT( ISBLANK( 
 IDN_EMPLMT_INCOME__r.IDN_EMPLMT_INDIV__r.DTE_BEGIN_EFFV__c)),

     DTE_PAY__c &lt;  IDN_EMPLMT_INCOME__r.DTE_BEGIN_EFFV__c 
),
AND(
     NOT( ISBLANK( DTE_PAY__c ) ),
     NOT( ISBLANK( IDN_EMPLMT_INCOME__c  ) ),
     NOT( ISBLANK( IDN_EMPLMT_INCOME__r.IDN_EMPLMT_INDIV__c) ),
     NOT( ISBLANK( 
 IDN_EMPLMT_INCOME__r.IDN_EMPLMT_INDIV__r.DTE_BEGIN_EFFV__c)),
     DTE_PAY__c &lt; IDN_EMPLMT_INCOME__r.IDN_EMPLMT_INDIV__r.DTE_BEGIN_EFFV__c  
     
))</errorConditionFormula>
        <errorDisplayField>DTE_PAY__c</errorDisplayField>
        <errorMessage>Pay Date Cannot be before Income Effective Date and Employment Begin Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Tips_Commisions_Bonuses_Greater_Than_0</fullName>
        <active>true</active>
        <description>Tips/Commisions/Bonuses cannot be less than 0.</description>
        <errorConditionFormula>AMT_TIPS_AVG__c &lt; 0</errorConditionFormula>
        <errorDisplayField>AMT_TIPS_AVG__c</errorDisplayField>
        <errorMessage>Tips/Commisions/Bonuses cannot be less than 0.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
