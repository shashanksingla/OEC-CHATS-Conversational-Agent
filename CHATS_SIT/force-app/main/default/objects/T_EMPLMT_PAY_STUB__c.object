        <fullName>IDN_EXTNL__c</fullName>
        <caseSensitive>true</caseSensitive>
        <externalId>true</externalId>
        <label>External ID</label>
        <length>50</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>bypassValidations__c</fullName>
        <encryptionScheme>None</encryptionScheme>
        <description>To be able to update status from backend. CCCAP-15586</description>
        <externalId>false</externalId>
        <label>bypassValidation</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>CDE_STATUS__c</fullName>
        <description>JIRA CHAT-2779 and 2778
2. added new columns T_EMPLMT_PAY_STUB.CDE_STATUS and T_EMPLMT_INCOME.CDE_STATUS</description>
        <externalId>false</externalId>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>R00848</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Number_Of_Worth_Days_Per_Frequency__c</fullName>
        <description>Logic on sufficient paystubs on employment income record needs to be changed to match legacy: check if there are enough paystubs for 30 days (if paystubs are in weeks(5)/twice per month(2)/every 2 weeks(3)) or a month (if paystubs are in months/yearly/one-time/etc. only need 1)</description>
        <externalId>false</externalId>
        <formula>IF(TEXT(CDE_STATUS__c)=&apos;ACT&apos;,CASE( TEXT(CDE_FREQ_PAY__c) , &apos;WKY&apos;, 7.5, &apos;E2W&apos;, 15,&apos;2PM&apos;, 15, 30),0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Number Of Worth Days Per Frequency</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Employment Pay Stub</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>All1</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
   <nameField>
        <displayFormat>{0}</displayFormat>
        <label>Pay Stub ID</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Employment Pay Stub</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Gross_Amount_Greater_Than_0</fullName>
        <active>true</active>
        <description>Gross Amount before taxes and deductions cannot be less than 0.</description>
        <errorConditionFormula>AMT_INCOME_GROSS__c &lt; 0</errorConditionFormula>
        <errorDisplayField>AMT_INCOME_GROSS__c</errorDisplayField>
        <errorMessage>Gross Amount before taxes and deductions cannot be less than 0.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Hours_worked_and_Care_needed_Validation</fullName>
        <active>true</active>
        <description>Hours Worked and Care Needed cannot be less than 0.</description>
        <errorConditionFormula>CNT_WORKED_HOURS_STUB_PAY__c &lt; 0</errorConditionFormula>
        <errorDisplayField>CNT_WORKED_HOURS_STUB_PAY__c</errorDisplayField>
        <errorMessage>Hours Worked and Care Needed cannot be less than 0.</errorMessage>
    </validationRules>
