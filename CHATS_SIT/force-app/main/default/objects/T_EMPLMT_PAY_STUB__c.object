        </valueSet>
    </fields>
    <fields>
        <fullName>CNT_WORKED_HOURS_STUB_PAY__c</fullName>
        <description>Hours Worked and Care Needed</description>
        <externalId>false</externalId>
        <label>Hours Worked and Care Needed</label>
        <precision>8</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Calculated_Weekly_Hours_Worked__c</fullName>
        <externalId>false</externalId>
        <formula>CASE( TEXT(CDE_FREQ_PAY__c) , 
&apos;WKY&apos;,  CNT_WORKED_HOURS_STUB_PAY__c , 
&apos;E2M&apos;, (CNT_WORKED_HOURS_STUB_PAY__c/2)/4.33, 
&apos;2PM&apos;, (CNT_WORKED_HOURS_STUB_PAY__c*2)/4.33,
&apos;E2W&apos;, CNT_WORKED_HOURS_STUB_PAY__c/2, 
&apos;MON&apos;, CNT_WORKED_HOURS_STUB_PAY__c/4.33, 
&apos;QRT&apos;, (CNT_WORKED_HOURS_STUB_PAY__c/3)/4.33, 
&apos;2PY&apos;, (CNT_WORKED_HOURS_STUB_PAY__c/6)/4.33, 
&apos;1PY&apos;, (CNT_WORKED_HOURS_STUB_PAY__c/12)/4.33, 
&apos;ONE&apos;, (CNT_WORKED_HOURS_STUB_PAY__c/12)/4.33, 
0 
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Calculated Weekly Hours Worked</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Calculated_Yearly_Income__c</fullName>
        <description>Formula referenced from: https://drive.google.com/file/d/0BzExP1u9ErsgREF3YnQ5Tm12blU/view</description>
        <externalId>false</externalId>
        <formula>CASE( TEXT(CDE_FREQ_PAY__c) , 
&apos;2PM&apos;, (AMT_INCOME_GROSS__c +  AMT_TIPS_AVG__c )*2*12,
&apos;E2M&apos;, (AMT_INCOME_GROSS__c +  AMT_TIPS_AVG__c )*6,
&apos;WKY&apos;,  (AMT_INCOME_GROSS__c +  AMT_TIPS_AVG__c )*4.33*12,
&apos;E2W&apos;,  ((AMT_INCOME_GROSS__c +  AMT_TIPS_AVG__c)/2)*4.33*12,
&apos;MON&apos;,  (AMT_INCOME_GROSS__c +  AMT_TIPS_AVG__c )*12,
&apos;QRT&apos;,  ((AMT_INCOME_GROSS__c +  AMT_TIPS_AVG__c )/3)*12,
&apos;2PY&apos;,  (AMT_INCOME_GROSS__c +  AMT_TIPS_AVG__c )*2,
&apos;1PY&apos;,  (AMT_INCOME_GROSS__c +  AMT_TIPS_AVG__c ),
&apos;ONE&apos;,  (AMT_INCOME_GROSS__c +  AMT_TIPS_AVG__c ),
0
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Calculated Yearly Income</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>DTE_PAY__c</fullName>
        <description>Pay Date</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>Pay Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
