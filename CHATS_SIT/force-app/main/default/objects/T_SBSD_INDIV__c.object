    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>First_Name_No_Special_Characters</fullName>
        <active>true</active>
        <description>First Name must contain at least one letter, and can only use letters, spaces, hyphens, and apostrophes. Names cannot start or end with a space, and cannot use multiple special characters in a row.</description>
        <errorConditionFormula>NOT(REGEX(NAM_FIRST__c,&quot;^(?! )(?!.*(--|  |&apos;&apos;))(?=.*[A-Za-z])[A-Za-z&apos; -]+(?&lt;! )$&quot;))</errorConditionFormula>
        <errorMessage>First Name must contain at least one letter, and can only use letters, spaces, hyphens, and apostrophes. Names cannot start or end with a space, and cannot use multiple special characters in a row.</errorMessage>
    </validationRules>   
    <validationRules>
        <fullName>Last_Name_No_Special_Characters</fullName>
        <active>true</active>
        <description>Last Name must contain at least one letter, and can only use letters, spaces, hyphens, and apostrophes. Names cannot start or end with a space, and cannot use multiple special characters in a row.</description>
        <errorConditionFormula>NOT(REGEX(NAM_LAST__c,&quot;^(?! )(?!.*(--|  |&apos;&apos;))(?=.*[A-Za-z])[A-Za-z&apos; -]+(?&lt;! )$&quot;))</errorConditionFormula>
        <errorMessage>Last Name must contain at least one letter, and can only use letters, spaces, hyphens, and apostrophes. Names cannot start or end with a space, and cannot use multiple special characters in a row.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Middle_Initial_No_Special_Characters</fullName>
        <active>true</active>
        <description>Middle Initial cannot contain special characters (except spaces).</description>
        <errorConditionFormula>AND(NOT(REGEX(NAM_MI__c,&quot;[a-zA-Z ]+&quot;)), NOT(ISBLANK(NAM_MI__c)))</errorConditionFormula>
        <errorMessage>Middle Initial cannot contain special characters (except spaces).</errorMessage>
    </validationRules> 
    <validationRules>
        <fullName>Req_HowVerified_DOB_If_VerifType_Writtn</fullName>
        <active>true</active>
        <description>How Verified DOB is required if Verification Type is written Applicable</description>
        <errorConditionFormula>AND($Label.Batch_User_Id &lt;&gt; $User.Id , !(Is_Peak_Data__c || (ISCHANGED(Is_Peak_Data__c) &amp;&amp; !Is_Peak_Data__c)),  !(Is_CBMS_Data__c || (ISCHANGED(Is_CBMS_Data__c) &amp;&amp; !Is_CBMS_Data__c)), ISPICKVAL( IND_CDE_TYPE_VERIF_DOB__c , &apos;V&apos;),  ISPICKVAL( CDE_SOURCE_VRFYD_DOB__c , &apos;&apos;),NOT($Setup.ByPass_Validation_Setting__c.Is_Batch_Excluded__c), NOT(ISCHANGED(Bypass_On__c)))</errorConditionFormula>
        <errorDisplayField>CDE_SOURCE_VRFYD_DOB__c</errorDisplayField>
        <errorMessage>Required: How Verified is must for Verification Type DOB as &quot;Written Verification&quot;</errorMessage>
    </validationRules>
    <!--Commented as part of CCCAP-10798-->
    <!--validationRules>
        <fullName>Require_How_Verified_if_SSN_populated</fullName>
        <active>false</active>
        <description>How verified(Identity) is required if SSN is populated</description>
        <errorConditionFormula>NOT(Is_Peak_Data__c) &amp;&amp; NOT(Is_CBMS_Data__c) &amp;&amp;
NOT(ISBLANK(NBR_SSN__c)) &amp;&amp; ISBLANK(TEXT(CDE_SOURCE_VRFYD_IDNTY__c))</errorConditionFormula>
        <errorDisplayField>CDE_SOURCE_VRFYD_IDNTY__c</errorDisplayField>
        <errorMessage>How verified(Identity) is required if SSN is populated</errorMessage>
    </validationRules-->
    <validationRules>
        <fullName>SSN_Alphanumeric_Only</fullName>
        <active>true</active>
        <errorConditionFormula>NOT(Is_Peak_Data__c)&amp;&amp; NOT(Is_CBMS_Data__c)&amp;&amp; NOT(ISCHANGED(Bypass_On__c))&amp;&amp; !ISBLANK(NBR_SSN__c )&amp;&amp; OR(NOT(ISNUMBER(NBR_SSN__c )),CONTAINS(NBR_SSN__c  ,&quot; &quot;),CONTAINS(NBR_SSN__c  ,&quot;-&quot;))</errorConditionFormula>
        <errorDisplayField>NBR_SSN__c</errorDisplayField>
        <errorMessage>Special characters and spaces are not allowed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>read_only_if_indiv_cleared</fullName>
        <active>false</active>
        <description>Fields: First Name, Middle Initial, Last Name, Gender, SSN, DOB, Date of Death cannot be edited for the cleared individual.</description>
        <errorConditionFormula>AND( NOT( ISNEW() ) , 
     OR( 
        ISCHANGED( DTE_DOB__c ) ,
        ISCHANGED( NAM_FIRST__c ) ,
        ISCHANGED( NAM_LAST__c ) ,
        ISCHANGED( NAM_MI__c ) ,
        ISCHANGED( NBR_SSN__c ) ,
        ISCHANGED( CDE_GENDER__c ),
        ISCHANGED( DTE_Death__c )
    ),
    ISPICKVAL( IND_NOTIFY_SIDMOD__c , &quot;Y&quot;),
    NOT(ISCHANGED(IND_NOTIFY_SIDMOD__c )),
   $Label.Batch_User_Id  &lt;&gt;  $User.Id 
)</errorConditionFormula>
        <errorMessage>Fields: First Name, Middle Initial, Last Name, Gender, SSN, DOB, Date of Death cannot be edited for the cleared individual.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_HowVerifiedIf_IdenVer_iswritten</fullName>
        <active>true</active>
        <errorConditionFormula>AND($Label.Batch_User_Id &lt;&gt; $User.Id , ISPICKVAL( CDE_VRFYD_IDNTY__c , &quot;V&quot;) ,  ISPICKVAL( CDE_SOURCE_VRFYD_IDNTY__c, &apos;&apos;),NOT(ISNEW()),NOT($Setup.ByPass_Validation_Setting__c.Is_Batch_Excluded__c ), NOT(Is_CBMS_Data__c), NOT(Is_Peak_Data__c), NOT(ISCHANGED(Bypass_On__c)))</errorConditionFormula>
        <errorDisplayField>CDE_SOURCE_VRFYD_IDNTY__c</errorDisplayField>
        <errorMessage>Please enter a value</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
