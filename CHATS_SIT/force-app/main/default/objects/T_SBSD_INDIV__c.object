    <enableStreamingApi>true</enableStreamingApi>
    <fields>
        <fullName>BirthDay__c</fullName>
        <externalId>false</externalId>
        <formula>DAY(DTE_DOB__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>BirthDay</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>BirthMonth__c</fullName>
        <externalId>false</externalId>
        <formula>MONTH(DTE_DOB__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>BirthMonth</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Age__c</fullName>
        <externalId>false</externalId>
        <formula>IF( NOT( ISBLANK( DTE_DOB__c ) ) ,
  IF( DATE( 2000 , MONTH( DTE_DOB__c ) , DAY( DTE_DOB__c ) ) &lt;= DATE( 2000 , MONTH( TODAY() ) , DAY( TODAY() ) ),
     YEAR (Today()) - YEAR ( DTE_DOB__c ),
     YEAR (Today()) - YEAR ( DTE_DOB__c ) -1 ),
  null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Age</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
