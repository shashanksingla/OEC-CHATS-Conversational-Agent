        <externalId>false</externalId>
        <label>Subsidy Amount Paid</label>
        <precision>9</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Error_Elements__c</fullName>
        <externalId>false</externalId>
        <label>Error Elements</label>
        <summaryFilterItems>
            <field>Case_Review_Response__c.CaseReview_QuestionMain__c</field>
            <operation>equals</operation>
            <value>No</value>
        </summaryFilterItems>
        <summaryForeignKey>Case_Review_Response__c.Case_Review__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Applicable_Elements__c</fullName>
        <externalId>false</externalId>
        <label>Applicable Elements</label>
        <summaryFilterItems>
            <field>Case_Review_Response__c.CaseReview_QuestionMain__c</field>
            <operation>notEqual</operation>
            <value>N/A</value>
        </summaryFilterItems>
        <summaryForeignKey>Case_Review_Response__c.Case_Review__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Element_Accuracy__c</fullName>
        <externalId>false</externalId>
        <formula>1 - (Error_Elements__c / Applicable_Elements__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Element Accuracy</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>IsSubmitted__c</fullName>
        <defaultValue>false</defaultValue>
        <externalId>false</externalId>
        <label>Submitted?</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>No_Change_Indicator__c</fullName>
        <label>Change Indicator</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Y</fullName>
                    <default>false</default>
                    <label>Yes</label>
                </value>
                <value>
                    <fullName>N</fullName>
                    <default>false</default>
                    <label>No</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Correct_Subsidy_Amount__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
  ISPICKVAL(Improper_Payment_Type__c, &apos;Overpayment&apos;),
  Subsidy_Amount_Paid__c - Improper_Payment_Amount__c,
  IF(
    ISPICKVAL(Improper_Payment_Type__c, &apos;Underpayment&apos;),
    Subsidy_Amount_Paid__c + Improper_Payment_Amount__c,
    Subsidy_Amount_Paid__c
  )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Correct Subsidy Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Improper_Payment_Type__c</fullName>
        <externalId>false</externalId>
        <label>Overpayment or Underpayment?</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Overpayment</fullName>
                    <default>false</default>
                    <label>Overpayment</label>
                </value>
                <value>
                    <fullName>Underpayment</fullName>
                    <default>false</default>
                    <label>Underpayment</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Payment_Accuracy_Rate__c</fullName>
        <externalId>false</externalId>
        <formula>IF(OR(Subsidy_Amount_Paid__c = 0,ISPICKVAL(Improper_Payment__c , &apos;N&apos;)), 1,
            IF(Subsidy_Amount_Paid__c = Correct_Subsidy_Amount__c, 1,
            IF(AND(Correct_Subsidy_Amount__c = 0,ISPICKVAL(Improper_Payment__c , &apos;Y&apos;)), 0,
IF(Subsidy_Amount_Paid__c &gt; Correct_Subsidy_Amount__c,
  Correct_Subsidy_Amount__c / Subsidy_Amount_Paid__c,
  Subsidy_Amount_Paid__c / Correct_Subsidy_Amount__c)
  )
            )
)
</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Payment Accuracy Rate</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <label>Case Review</label>
    <listViews>
