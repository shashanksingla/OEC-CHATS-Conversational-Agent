    <validationRules>
        <fullName>Cancellation_Date_Check</fullName>
        <active>true</active>
        <errorConditionFormula>DTE_DISC_CANCELLATION__c &gt;  TODAY()</errorConditionFormula>
        <errorMessage>Begin date cannot be a future date.</errorMessage>
    </validationRules>
