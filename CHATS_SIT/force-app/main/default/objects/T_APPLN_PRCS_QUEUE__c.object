        <fullName>CDE_AUTO_PROCESS_NOTES__c</fullName>
        <businessStatus>Active</businessStatus>
        <description>Project 507, JIRA CCCAP-7696</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <inlineHelpText>Auto processed Referral Notes</inlineHelpText>
        <label>Auto processed Referral Notes</label>
