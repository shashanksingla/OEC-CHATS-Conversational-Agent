    </fields>
    <fields>
        <fullName>Incorrect_Information_Needed__c</fullName>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>Incorrect Information Needed</label>
        <length>512</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Process_Referral_State__c</fullName>
        <externalId>false</externalId>
        <formula>IF( 
    AND (
    TEXT(CDE_SOURCE__c) ==&apos;CB&apos; ,
    NOT(ISPICKVAL(CDE_STATUS_APPLN__c,&apos;REJ&apos;)),
    NOT(ISPICKVAL(CDE_STATUS_APPLN__c,&apos;PRC&apos;)),
    NOT(ISPICKVAL(CDE_STATUS_APPLN__c,&apos;INC&apos;))
    ),
    IF( AND(County_Name__c !=null, IDN_APPLN__r.CDE_CBMS_REF_TYP__c == &apos;New&apos;),&quot;New&quot;,
    IF( AND(County_Name__c !=null, IDN_CASE__c!=null,  OR(IDN_APPLN__r.CDE_CBMS_REF_TYP__c == &apos;Renewal&apos;, IDN_APPLN__r.CDE_CBMS_REF_TYP__c == &apos;Change&apos;)),&quot;Change&quot;,
    IF( AND(IDN_CASE__c=null, IDN_APPLN__r.CDE_CBMS_REF_TYP__c != &apos;New&apos;),&quot;ReferralToCase&quot;,
    IF( AND(County_Name__c !=null, IDN_CASE__c!=null,  OR(IDN_APPLN__r.CDE_CBMS_REF_TYP__c == &apos;Transition&apos;, IDN_APPLN__r.CDE_CBMS_REF_TYP__c == &apos;Closure&apos;) ) , &quot;Transitional&quot;,&quot;NA&quot;)))),&quot;NA&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Process Referral State</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Reverse_Refer_Track__c</fullName>
        <defaultValue>false</defaultValue>
        <externalId>false</externalId>
        <label>Reverse Refer Track</label>
        <description>This field is used for marked a Referral rejected that needs to be send in next file to CBMS.</description>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
    <type>Checkbox</type>
    </fields>
