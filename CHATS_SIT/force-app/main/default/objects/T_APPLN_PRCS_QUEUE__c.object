    <nameField>
        <displayFormat>APRCS_QUEUE-{0}</displayFormat>
        <label>Application Process Queue ID</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Application Process Queues</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>cannot_chng_county_if_source_paper</fullName>
        <active>true</active>
        <description>CHAT-1140: &quot;Read-only
If user has completed intake for a paper application (from the flow), populate with the CDE_COUNTY from T_SBSD_CASE&quot;</description>
        <errorConditionFormula>AND( NOT(ISNEW()),
     ISPICKVAL(CDE_SOURCE__c, &quot;PA&quot;),  ISCHANGED( CDE_COUNTY__c ) 
)</errorConditionFormula>
        <errorDisplayField>CDE_COUNTY__c</errorDisplayField>
        <errorMessage>Cannot update County if Application Source is Paper.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CBMS_Reason_of_Rejection_Required</fullName>
        <active>true</active>
        <errorConditionFormula>AND( ISPICKVAL(CDE_SOURCE__c, &apos;CB&apos;) ,NOT(ISPICKVAL( CDE_REJECT_APPLN__c,&apos;&apos;))  )</errorConditionFormula>
        <errorMessage>Please select appropriate Reason for Rejection.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PEAK_Reason_of_Rejection_Required</fullName>
        <active>true</active>
        <errorConditionFormula>AND( ISPICKVAL(CDE_SOURCE__c, &apos;PK&apos;) , NOT(ISPICKVAL( CDE_REJECT_REFER__c,&apos;&apos;)) )</errorConditionFormula>
        <errorMessage>Please select appropriate Reason for Rejection.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cannot_chng_reason_cncln_if_source_paper</fullName>
        <active>true</active>
        <description>CHAT-1141: If user has completed intake for a paper application (from the flow), don&apos;t allow user to enter data into this field</description>
        <errorConditionFormula>AND( NOT(ISNEW()),
     ISPICKVAL(CDE_SOURCE__c, &quot;PA&quot;),
     ISCHANGED( CDE_REJECT_APPLN__c) 
)</errorConditionFormula>
     <errorDisplayField>CDE_REJECT_APPLN__c</errorDisplayField>
        <errorMessage>cannot update Reason for Rejection if it is paper application</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CntyTransferNotes_Req_when_Upd_County</fullName>
        <active>true</active>
        <description>County Transfer Notes is required when County is updated</description>
        <errorConditionFormula>AND(
 NOT(ISNEW()),
 ISPICKVAL(CDE_SOURCE__c, &apos;PK&apos;),
 ISCHANGED(County_Name__c ),
 OR(
  ISBLANK(County_Transfer_Notes__c),
  NOT(ISCHANGED(County_Transfer_Notes__c))
 )
)</errorConditionFormula>
        <errorDisplayField>County_Transfer_Notes__c</errorDisplayField>
        <errorMessage>County Transfer Notes is required when County is updated</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PEAK_CaseID_Required</fullName>
        <active>true</active>
        <description>Required for certain values in Reason for Rejection field for PEAK</description>
        <errorConditionFormula>AND(
 ISPICKVAL(CDE_SOURCE__c, &apos;PK&apos;),
 ISBLANK(IDN_CASE__c), 
 OR(
  ISPICKVAL(CDE_REJECT_APPLN__c, &apos;3&apos;),
  ISPICKVAL(CDE_REJECT_APPLN__c, &apos;1&apos;)
 )
)</errorConditionFormula>
        <errorDisplayField>IDN_CASE__c</errorDisplayField>
        <errorMessage>Please enter appropriate Case ID.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PEAK_RejectionReasonNotes_Required</fullName>
        <active>true</active>
        <description>Required for certain values in Reason for Rejection field for PEAK</description>
        <errorConditionFormula>AND(
 ISPICKVAL(CDE_SOURCE__c, &apos;PK&apos;),
 ISBLANK(CDE_REJECT_NOTES__c), 
 OR(
  ISPICKVAL(CDE_REJECT_APPLN__c, &apos;3&apos;),
  ISPICKVAL(CDE_REJECT_APPLN__c, &apos;1&apos;)
 )
)</errorConditionFormula>
        <errorDisplayField>CDE_REJECT_NOTES__c</errorDisplayField>
        <errorMessage>Please enter appropriate notes for rejection.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PEAK_CaseID_Restricted</fullName>
        <active>true</active>
        <description>Prevent a user from entering a Case ID if its not required to enter.</description>
        <errorConditionFormula>AND(
 ISCHANGED(IDN_CASE__c),
 NOT(ISPICKVAL(CDE_REJECT_APPLN__c, &quot;1&quot;)),
 NOT(ISPICKVAL(CDE_REJECT_APPLN__c, &quot;3&quot;)),
 ISPICKVAL(CDE_SOURCE__c, &quot;PK&quot;),
 PEAK_bypass_CaseID_Validation__c == false
)</errorConditionFormula>
        <errorDisplayField>IDN_CASE__c</errorDisplayField>
        <errorMessage>Please do not enter Case ID unless PEAK Application is in Rejected status.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
