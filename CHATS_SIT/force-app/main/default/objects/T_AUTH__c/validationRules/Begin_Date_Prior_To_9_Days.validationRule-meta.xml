<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Begin_Date_Prior_To_9_Days</fullName>
    <active>true</active>
    <errorConditionFormula>AND((ISNEW()) ,DTE_BEGIN_EFFV_AUTH__c  &lt; (TODAY()-9))</errorConditionFormula>
    <errorDisplayField>DTE_BEGIN_EFFV_AUTH__c</errorDisplayField>
    <errorMessage>Cannot be prior to {today + 9 days in the past}</errorMessage>
</ValidationRule>
