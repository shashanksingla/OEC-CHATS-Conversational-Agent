    <validationRules>
        <fullName>Adj_Pmt_Id_Not_Deletable</fullName>
        <active>true</active>
        <description>Adjustment Payment Id once created cannot be deleted</description>
        <errorConditionFormula>AND( NOT( ISNEW() ) , 
ISCHANGED( Name ) 
)</errorConditionFormula>
        <errorDisplayField>Name</errorDisplayField>
        <errorMessage>Adjustment Payment Id once created cannot be deleted</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Adm_Action_Not_Deletable</fullName>
        <active>true</active>
        <description>Record once created , Action Admin cannot be changed</description>
        <errorConditionFormula>AND( NOT( ISNEW() ) ,
    ISCHANGED( CDE_ACTION_ADMIN__c )
)</errorConditionFormula>
        <errorDisplayField>CDE_ACTION_ADMIN__c</errorDisplayField>
        <errorMessage>Record once created , Action Admin cannot be changed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Amt_Not_Deletable</fullName>
        <active>true</active>
        <description>once Record is Created, Amount is not deletable</description>
        <errorConditionFormula>AND( NOT( ISNEW() ) ,
    ISCHANGED( AMT_PMT_ADJMT__c )
)</errorConditionFormula>
        <errorDisplayField>AMT_PMT_ADJMT__c</errorDisplayField>
        <errorMessage>once Record is Created, Amount is not deletable</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Case_Not_Deletable</fullName>
        <active>true</active>
        <description>Once the record is created , it is not deletable</description>
        <errorConditionFormula>AND( NOT( ISNEW() ) ,
    ISCHANGED( IDN_CASE__c )
)</errorConditionFormula>
        <errorDisplayField>IDN_CASE__c</errorDisplayField>
        <errorMessage>Once the record is created , it is not deletable</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Check_Number_Not_deletable</fullName>
        <active>true</active>
        <description>Once the record is Created, Check Number cannot be deleted</description>
        <errorConditionFormula>AND( NOT( ISNEW() ) ,
    ISCHANGED( TXT_NBR_CHECK_PMT__c )
)</errorConditionFormula>
        <errorDisplayField>TXT_NBR_CHECK_PMT__c</errorDisplayField>
        <errorMessage>Once the record is Created, Check Number cannot be deleted</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Date_Paid_not_deletable</fullName>
        <active>true</active>
        <description>Once the Record is created, Date Paid is not deletable</description>
        <errorConditionFormula>AND( NOT( ISNEW() ) ,
    ISCHANGED( DTE_PMT_ADJMT__c )
)</errorConditionFormula>
        <errorDisplayField>DTE_PMT_ADJMT__c</errorDisplayField>
        <errorMessage>Once the Record is created, Date Paid is not deletable</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Payment_Not_Deletable</fullName>
        <active>true</active>
        <description>Record once created , Payment cannot be changed</description>
        <errorConditionFormula>AND( NOT( ISNEW() ) , 
ISCHANGED( IDN_PMT__c ) 
)</errorConditionFormula>
        <errorDisplayField>IDN_PMT__c</errorDisplayField>
        <errorMessage>Record once created , Payment cannot be changed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Paymnt_Type_Not_deletable</fullName>
        <active>true</active>
        <description>Once the Record is created, Payment Type cannot be changed</description>
        <errorConditionFormula>AND( NOT( ISNEW() ) ,
    ISCHANGED( CDE_TYPE_PMT_ADJMT__c )
)</errorConditionFormula>
        <errorDisplayField>CDE_TYPE_PMT_ADJMT__c</errorDisplayField>
        <errorMessage>Once the Record is created, Payment Type cannot be changed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Provider_Not_Editable</fullName>
        <active>true</active>
        <description>Once the record is Created, provider cannot be edited</description>
        <errorConditionFormula>AND( NOT( ISNEW() ) ,
    ISCHANGED( IDN_PROVR__c )
)</errorConditionFormula>
        <errorDisplayField>IDN_PROVR__c</errorDisplayField>
        <errorMessage>Once the record is Created, provider cannot be edited</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ReceiptNumber_Not_deletable</fullName>
        <active>true</active>
        <description>Once Record is Created , Receipt Number cannot be deleted</description>
        <errorConditionFormula>AND( NOT( ISNEW() ) ,
    ISCHANGED( IDN_RCPT_PMT__c )
)</errorConditionFormula>
        <errorDisplayField>IDN_RCPT_PMT__c</errorDisplayField>
        <errorMessage>Once Record is Created , Receipt Number cannot be deleted</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_AdmAction_If_PymntType_AdmAction</fullName>
        <active>true</active>
        <description>Require Administrative Action based on Payment Type</description>
        <errorConditionFormula>AND( ISPICKVAL(CDE_TYPE_PMT_ADJMT__c,&apos;5&apos;) , ISBLANK(TEXT(CDE_ACTION_ADMIN__c))	 )</errorConditionFormula>
        <errorDisplayField>CDE_ACTION_ADMIN__c</errorDisplayField>
        <errorMessage>Administrative Action field is must for Payment Type = &apos;Administrative Action&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_Check_Number_If_PymntType_Check</fullName>
        <active>true</active>
        <description>Check Number is must for Payment Type = &apos;Check&apos;</description>
        <errorConditionFormula>AND( ISPICKVAL(CDE_TYPE_PMT_ADJMT__c,&apos;2&apos;), ISBLANK(TXT_NBR_CHECK_PMT__c ))</errorConditionFormula>
        <errorDisplayField>TXT_NBR_CHECK_PMT__c</errorDisplayField>
        <errorMessage>Check Number is must for Payment Type = &apos;Check&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Txt_Info_cannot_be_changed</fullName>
        <active>true</active>
        <description>TXT_INFO_OTHER cannot be changed</description>
        <errorConditionFormula>AND( NOT( ISNEW() ) ,
    ISCHANGED( TXT_INFO_OTHER__c )
)</errorConditionFormula>
        <errorDisplayField>TXT_INFO_OTHER__c</errorDisplayField>
        <errorMessage>TXT_INFO_OTHER cannot be changed</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
