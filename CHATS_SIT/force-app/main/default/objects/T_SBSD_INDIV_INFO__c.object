    <validationRules>
        <fullName>Eff_End_Dt_cannot_be_less_Eff_Begin_Dt</fullName>
        <active>true</active>
        <description>Effective End Date cannot be before the Effective Begin Date</description>
        <errorConditionFormula>NOT(IDN_CLIENT__r.Is_Peak_Data__c) &amp;&amp; NOT(IDN_CLIENT__r.Is_CBMS_Data__c) &amp;&amp; DTE_END_EFFV__c &lt; DTE_BEGIN_EFFV__c</errorConditionFormula>
        <errorDisplayField>DTE_END_EFFV__c</errorDisplayField>
        <errorMessage>Cannot be before the Effective Begin Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Req_Begin_Date_if_Type_is_Head_St_Foster</fullName>
        <active>true</active>
        <description>Required when CDE_TYPE_INFO_INDIV is Foster or Head Start. CHAT-1169</description>
        <errorConditionFormula>AND(NOT(IDN_CLIENT__r.Is_Peak_Data__c),NOT(IDN_CLIENT__r.Is_CBMS_Data__c), ISBLANK( DTE_BEGIN_EFFV__c) ,  OR(ISPICKVAL(CDE_TYPE_INFO_INDIV__c , &apos;HDS&apos;), ISPICKVAL(CDE_TYPE_INFO_INDIV__c , &apos;FST&apos;)))</errorConditionFormula>
        <errorDisplayField>DTE_BEGIN_EFFV__c</errorDisplayField>
        <errorMessage>Please enter Effective Begin Date when Type of Individual Information is Foster or Head Start</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Case_Id_mandatory_for_Citisenship_type</fullName>
        <active>true</active>
        <description>Required when CDE_TYPE_INFO_INDIV is Citizenship status. CCCAP-9945</description>
        <errorConditionFormula>AND(NOT(IDN_CLIENT__r.Is_Peak_Data__c),NOT(IDN_CLIENT__r.Is_CBMS_Data__c), ISBLANK(IDN_CASE__c) , ISPICKVAL(CDE_TYPE_INFO_INDIV__c , &apos;CS&apos;))</errorConditionFormula>
        <errorDisplayField>IDN_CASE__c</errorDisplayField>
        <errorMessage>Please enter Case ID when Type of Individual Information is Citizenship Status</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
