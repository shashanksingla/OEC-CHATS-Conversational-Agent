<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cell_Phone_Must_be_10_Digits</fullName>
    <active>true</active>
    <errorConditionFormula>(NOT( ISBLANK(NBR_PHONE_CELL__c)) &amp;&amp;  LEN(NBR_PHONE_CELL__c)!=10)</errorConditionFormula>
    <errorDisplayField>NBR_PHONE_CELL__c</errorDisplayField>
    <errorMessage>Cell Phone must be 10 digits</errorMessage>
</ValidationRule>
