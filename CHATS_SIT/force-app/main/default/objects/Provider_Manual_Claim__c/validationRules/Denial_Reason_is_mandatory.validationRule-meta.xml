<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Denial_Reason_is_mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
            ISPICKVAL(Denial_Reason__c,&apos;&apos;) ,
            ISPICKVAL(Claim_Status__c ,&apos;Denied&apos;)
            )</errorConditionFormula>
    <errorDisplayField>Denial_Reason__c</errorDisplayField>
    <errorMessage>Denial Reason is mandatory for a Denied Claim.</errorMessage>
</ValidationRule>
