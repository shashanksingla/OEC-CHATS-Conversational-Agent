        <columns>CCCAP_Q7_2__c</columns>
        <columns>CCCAP_Q10_1__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CDE_COUNTY__c</field>
            <operation>equals</operation>
            <value>arapahoe</value>
        </filters>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>Template_List_View</fullName>
        <columns>NAME</columns>
        <columns>STATUS__c</columns>
        <columns>DTE_BEGIN_EFFEV__c</columns>
        <columns>DTE_END_EFFEV__c</columns>
        <columns>CDE_COUNTY_PLAN_TEMPLT__c</columns>
        <columns>IND_COUNTY_PLAN_TEMPLT__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>IND_COUNTY_PLAN_TEMPLT__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <label>Template</label>
    </listViews>
    <nameField>
        <displayFormat>{0}</displayFormat>
        <label>ID</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>County Plan</pluralLabel>
    <searchLayouts />
    <sharingModel>Read</sharingModel>
    <!--Commented
    as part of CCCAP-10798-->
    <!--validationRules>
        <fullName>Approved_Plan_cannot_be_updated</fullName>
        <active>false</active>
        <description>Once the plan is in an Approved status, users should not be able to edit</description>
        <errorConditionFormula>OR(AND( NOT(ISCHANGED(CDE_STATUS__c)) ,NOT(ISNEW()),ISPICKVAL(CDE_STATUS__c,
    &apos;APV&apos;)),  TEXT(PRIORVALUE(CDE_STATUS__c)) = &apos;APV&apos; )</errorConditionFormula>
        <errorMessage>Approved Plan cannot be updated</errorMessage>
    </validationRules-->
    <validationRules>
        <fullName>Begin_Date_Future</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
		ISBLANK(County_Plan__c ),
		DTE_BEGIN_EFFEV__c &lt;= TODAY(),
			!ISPICKVAL(CDE_STATUS__c ,&apos;APV&apos;),
		OR(
			!ISCHANGED( CDE_STATUS__c ),
			AND(
				ISCHANGED( CDE_STATUS__c ),
				!ISPICKVAL(CDE_STATUS__c ,&apos;NRV&apos;)
			)),		
		!ISCHANGED( OwnerId ),
		!Is_being_approved_by_Flow__c,
		!ISCHANGED(Bypass_Validation_On__c)
		)</errorConditionFormula>
        <errorDisplayField>DTE_BEGIN_EFFEV__c</errorDisplayField>
        <errorMessage>Begin Date Should Be a Future Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Template_Record</fullName>
        <active>true</active>
        <errorConditionFormula>AND( AND(
            ISBLANK(County_Plan__c ),
            $UserRole.DeveloperName &lt;&gt;
            &apos;Template_Administrator&apos;,$UserRole.DeveloperName &lt;&gt;
            &apos;County_Plan_Approver&apos;) , OR(IND_COUNTY_PLAN_TEMPLT__c,
            PRIORVALUE(IND_COUNTY_PLAN_TEMPLT__c)))</errorConditionFormula>
        <errorMessage>Template Records can be modified/checked by Template Administrators only</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_Enrolment_Freeze</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISBLANK(County_Plan__c ),$Label.RestrictWaitlistEnrolmentFreeze
            ==&apos;true&apos;,TEXT(ELIGIBILITY_Q9__c)==&apos;Y&apos; , DTE_BEGIN_EFFEV__c &lt;
            DATEVALUE(&quot;2019-07-01&quot;), TEXT(CDE_STATUS__c) &lt;&gt; &apos;APV&apos;)</errorConditionFormula>
        <errorDisplayField>ELIGIBILITY_Q9__c</errorDisplayField>
        <errorMessage>Is not applicable until 7/1/2019 You must select “No”.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_Waitlist</fullName>
        <active>true</active>
        <errorConditionFormula>AND( ISBLANK(County_Plan__c ),$Label.RestrictWaitlistEnrolmentFreeze
            ==&apos;true&apos;,TEXT(ELIGIBILITY_Q10__c)==&apos;Y&apos;, DTE_BEGIN_EFFEV__c &lt;
            DATEVALUE(&quot;2019-07-01&quot;) , TEXT(CDE_STATUS__c) &lt;&gt; &apos;APV&apos;)</errorConditionFormula>
        <errorDisplayField>ELIGIBILITY_Q10__c</errorDisplayField>
        <errorMessage>Is not applicable until 7/1/2019 You must select “No”.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>