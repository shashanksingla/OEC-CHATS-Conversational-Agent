        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>this is a representation of Status in the event of being conditionally approved by the approver</description>
        <externalId>false</externalId>
        <formula>IF(
            AND(
            ISPICKVAL(CDE_STATUS__c, &apos;APV&apos;),
            Is_Conditionally_Approved__c
            ),
            &apos;Conditionally Approved&apos;,
            CASE(
            TEXT(CDE_STATUS__c),
            &apos;PEN&apos;, &apos;Draft&apos;,
            &apos;SUB&apos;, &apos;Submitted&apos;,
            &apos;NRV&apos;, &apos;Need Revision&apos;,
            &apos;APV&apos;, &apos;Approved&apos;,
            &apos;&apos;
            )
            )</formula>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
