        <deleteConstraint>SetNull</deleteConstraint>
        <description>Client ID</description>
        <externalId>false</externalId>
        <label>Client ID</label>
        <referenceTo>T_SBSD_INDIV__c</referenceTo>
        <relationshipLabel>Other Income</relationshipLabel>
        <relationshipName>T_SBSD_INDIV10</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields> 
    <fields>
        <fullName>IDN_EXTNL__c</fullName>
        <caseSensitive>true</caseSensitive>
        <externalId>true</externalId>
        <label>External ID</label>
        <length>50</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>CNT_HOURS_WEEK__c</fullName>
        <externalId>false</externalId>
        <label>Hours per Week</label>
        <precision>7</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Other Income</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>All1</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
   <nameField>
        <displayFormat>{0}</displayFormat>
        <label>Other Income ID</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Other Income</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>EffectiveEndDateCannotBeGreaterBeginDate</fullName>
        <active>true</active>
        <errorConditionFormula>DTE_END_EFFV__c  &lt;  DTE_BEGIN_EFFV__c</errorConditionFormula>
        <errorDisplayField>DTE_END_EFFV__c</errorDisplayField>
        <errorMessage>Effective End Date cannot be Prior to Effective Begin Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_VERIF_SRC_INC_IF_VERIFTYPE_Writn</fullName>
        <active>true</active>
        <errorConditionFormula>AND( NOT( IDN_CLIENT__r.Is_Peak_Data__c ),NOT( IDN_CLIENT__r.Is_CBMS_Data__c ),ISPICKVAL(CDE_TYPE_VERIF__c, &quot;V&quot;) , 
    ISBLANK( TEXT(CDE_SOURCE_VRFYD_INCOME__c) ) )</errorConditionFormula>
        <errorDisplayField>CDE_SOURCE_VRFYD_INCOME__c</errorDisplayField>
        <errorMessage>Income How Verified Field is Required</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_if_CDE_FREQ_INCOME</fullName>
        <active>true</active>
        <description>Hours per Week is Required if CDE_FREQ_INCOME = &apos;HLY&apos; and Cannot be less than 0</description>
        <errorConditionFormula>AND(NOT( IDN_CLIENT__r.Is_Peak_Data__c ),NOT( IDN_CLIENT__r.Is_CBMS_Data__c ), OR( 
	AND(ISPICKVAL( CDE_FREQ_INCOME__c , &quot;HLY&quot;), ISNULL(CNT_HOURS_WEEK__c)),
	CNT_HOURS_WEEK__c  &lt; 0
))</errorConditionFormula>
        <errorDisplayField>CNT_HOURS_WEEK__c</errorDisplayField>
        <errorMessage>Required if income received is &apos;Hourly&apos; and value cannot be less than 0.</errorMessage>
    </validationRules>
    <validationRules>
    	<fullName>BeginDateWithin31DaysFuture</fullName>
   	 <active>true</active>
    	<description>Begin Date cannot be more than 31 days in the future</description>
    	<errorConditionFormula>DTE_BEGIN_EFFV__c &gt;  TODAY() +31</errorConditionFormula>
    	<errorDisplayField>DTE_BEGIN_EFFV__c</errorDisplayField>
    	<errorMessage>Begin Date cannot be more than 31 days in the future</errorMessage>
     </validationRules>	
    <visibility>Public</visibility>
</CustomObject>
