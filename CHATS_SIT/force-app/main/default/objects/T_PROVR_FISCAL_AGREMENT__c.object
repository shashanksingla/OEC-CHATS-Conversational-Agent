    <fields>
        <fullName>CDE_COUNTY_OWNER__c</fullName>
        <description>CHAT-489</description>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(ID_SERVICE__r.CDE_COUNTY_OWNER__c) , &apos;&apos;, 
HYPERLINK(&quot;/&quot; &amp; ID_SERVICE__r.CDE_COUNTY_OWNER__c, ID_SERVICE__r.CDE_COUNTY_OWNER__r.Name)
)</formula>
        <label>Owner County</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
