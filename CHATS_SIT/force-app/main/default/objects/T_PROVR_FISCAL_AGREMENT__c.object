    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>CANNOT_UPDATE_CLOSED_FA</fullName>
        <active>true</active>
        <errorConditionFormula>TEXT(PRIORVALUE(CDE_TYPE_STATUS__c))= &apos;CLS&apos;</errorConditionFormula>
        <errorMessage>Fiscal Agreement with Closed status cannot be edited.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Date_Rcv_Fisc_Agrmnt_LesThan_Begin_Date</fullName>
        <active>true</active>
        <description>Fiscal Agreement receive date must be less than Effective Begin Date</description>
        <errorConditionFormula>DTE_RCV_AGRMT_FISCAL__c &gt; DTE_BEGIN_AGRMT__c</errorConditionFormula>
        <errorDisplayField>DTE_RCV_AGRMT_FISCAL__c</errorDisplayField>
        <errorMessage>Fiscal Agreement receive date must be less than Effective Begin Date</errorMessage>
    </validationRules>
    <!--Commented as part of CCCAP-10798-->
    <!--validationRules>
        <fullName>Date_Received_Required_for_Open_FA</fullName>
        <active>false</active>
        <description>Date Fiscal Agreement Received is Required to Finalize Fiscal Agreement</description>
        <errorConditionFormula>AND (ISBLANK(DTE_RCV_AGRMT_FISCAL__c ) ,OR(ISPICKVAL(CDE_TYPE_STATUS__c  , &apos;OPN&apos;) ,ISPICKVAL(CDE_TYPE_STATUS__c  , &apos;FIN&apos;)) )</errorConditionFormula>
        <errorDisplayField>DTE_RCV_AGRMT_FISCAL__c</errorDisplayField>
        <errorMessage>Date Fiscal Agreement Received is Required to Finalize Fiscal Agreement</errorMessage>
    </validationRules-->
    <validationRules>
        <fullName>Record_ReadOnly_status_open_Finalised</fullName>
        <active>true</active>
        <description>Added 'EFACH' exception for Project 337, JIRA CCCAP-4768</description>
        <errorConditionFormula>(
 ISPICKVAL(CDE_TYPE_STATUS__c, &apos;OPN&apos;) ||
 ISPICKVAL(CDE_TYPE_STATUS__c, &apos;FIN&apos;)
) &amp;&amp; (
 ISCHANGED(Name) ||
 ISCHANGED(ID_SERVICE__c) ||
 ISCHANGED(CDE_TYPE_FACILITY__c) ||
 ISCHANGED(CDE_COUNTY__c) ||
 ISCHANGED(DTE_RCV_AGRMT_FISCAL__c) ||
 ISCHANGED(CDE_COUNTY_OWNER__c)
) &amp;&amp; (
 IF(
 NOT(ISPICKVAL(ID_SERVICE__r.CDE_TYPE_PROVR__c, &apos;EFACH&apos;)),
 ISCHANGED(DTE_BEGIN_AGRMT__c), false
 )
)</errorConditionFormula>
        <errorMessage>Only Owner is editable for Open/Finalized Fiscal Agreements</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Staus_Close_Validation</fullName>
        <active>true</active>
        <description>Without Reason of  closure user can&apos;t change status to &apos;Closed&apos;.</description>
        <errorConditionFormula>AND( ISPICKVAL( CDE_TYPE_STATUS__c , &apos;CLS&apos;) , ISPICKVAL( CDE_REASON_END_AGRMT__c , &quot;&quot;))</errorConditionFormula>
        <errorDisplayField>CDE_TYPE_STATUS__c</errorDisplayField>
        <errorMessage>Can not close the fiscal agreement without reason of closure.</errorMessage>
    </validationRules>
	<validationRules>
        <fullName>FABeginDateEqOrGreaterThenLicenceEffDate</fullName>
        <active>true</active>
        <description>Fiscal Agreement Begin Date must be greater than or equal to the License Effective Date</description>
        <errorConditionFormula> OR(AND(ISNEW(), NOT($Setup.ByPass_Validation_Setting__c.Is_Batch_Excluded__c), ISBLANK( TEXT(CDE_REASON_END_AGRMT__c ) ), DTE_BEGIN_AGRMT__c &lt; ID_SERVICE__r.DTE_BEGIN_EFFV__c ), AND(NOT(ISNEW()), NOT($Setup.ByPass_Validation_Setting__c.Is_Batch_Excluded__c), ISBLANK( TEXT(CDE_REASON_END_AGRMT__c ) ), DTE_BEGIN_AGRMT__c &lt; ID_SERVICE__r.DTE_BEGIN_EFFV__c, NOT( ISCHANGED( OwnerId ) ) ))</errorConditionFormula>
        <errorDisplayField>DTE_BEGIN_AGRMT__c</errorDisplayField>
        <errorMessage>Fiscal Agreement Begin Date must be greater than or equal to the License Effective Date</errorMessage>
    </validationRules>
	<validationRules>
        <fullName>Restrict_PFA_finalize_for_In_Progress_BG</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(ID_SERVICE__r.CDE_REQ_BGC_CHK_STATE__c, &quot;In Progress&quot;), OR(
ISPICKVAL(CDE_TYPE_STATUS__c, &quot;FIN&quot;),
ISPICKVAL(CDE_TYPE_STATUS__c, &quot;OPN&quot;)
))</errorConditionFormula>
        <errorMessage>Fiscal agreement can not be finalized because Background Check is in Progress for this Provider.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>State_BG_Check_Incomplete</fullName>
        <active>true</active>
        <description>Project 337, JIRA CCCAP-4768</description>
        <errorConditionFormula>AND(
ISPICKVAL(ID_SERVICE__r.CDE_TYPE_PROVR__c, &quot;EFACH&quot;),
OR(
ISNULL(ID_SERVICE__r.DTE_FA_ReimEff__c),
NOT(ISPICKVAL(ID_SERVICE__r.CDE_REQ_BGC_CHK_STATE__c, &quot;Cleared&quot;))
),
OR(
ISPICKVAL(CDE_TYPE_STATUS__c, &quot;FIN&quot;),
ISPICKVAL(CDE_TYPE_STATUS__c, &quot;OPN&quot;)
),
ISPICKVAL(PRIORVALUE(CDE_TYPE_STATUS__c), &quot;DFT&quot;)
)</errorConditionFormula>
        <errorMessage>State required background check is not completed. Please contact  State CCCAP Team</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>QEProvr_FA_BeginDate_Validation</fullName>
        <active>true</active>
        <description>CCCAP-5987</description>
        <errorConditionFormula>AND(
 ISPICKVAL(ID_SERVICE__r.CDE_TYPE_PROVR__c, &quot;EFACH&quot;),
 DTE_BEGIN_AGRMT__c &lt; ID_SERVICE__r.DTE_FA_ReimEff__c,
 ISNEW()
)</errorConditionFormula>
        <errorMessage>Fiscal Agreement Effective Begin Date should be the same day or greater than the Fiscal Agreement/Reimbursement Effective date on the provider’s details screen.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
