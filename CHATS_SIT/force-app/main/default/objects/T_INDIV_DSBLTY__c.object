    <validationRules>
        <fullName>Incapacitation_End_Date_Validation</fullName>
        <active>true</active>
        <description>Incapacitation End Date must be greater than Incapacitation Reported Date.</description>
        <errorConditionFormula>NOT(IDN_CLIENT__r.Is_Peak_Data__c) &amp;&amp; NOT(IDN_CLIENT__r.Is_CBMS_Data__c) &amp;&amp; DTE_BEGIN_EFFV__c &gt; DTE_END_EFFV__c</errorConditionFormula>
        <errorDisplayField>DTE_END_EFFV__c</errorDisplayField>
        <errorMessage>Incapacitation End Date must be greater than Incapacitation Reported Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_How_Verified_If_Verified_Type_V</fullName>
        <active>true</active>
        <description>Require How Verified if Verified Type equals Written Verification</description>
        <errorConditionFormula>AND(AND(NOT(IDN_CLIENT__r.Is_Peak_Data__c),NOT(IDN_CLIENT__r.Is_CBMS_Data__c)), ISPICKVAL(CDE_TYPE_VERIF__c, &quot;V&quot;)  , 
    ISBLANK(TEXT(CDE_SOURCE_DSBLTY_CHILD__c) ) )</errorConditionFormula>
        <errorDisplayField>CDE_SOURCE_DSBLTY_CHILD__c</errorDisplayField>
        <errorMessage>Require How Verified if Verified Type equals Written Verification</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
