    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Cell_Phone_Must_be_10_Digits</fullName>
        <active>true</active>
        <errorConditionFormula>(NOT( ISBLANK(NBR_PHONE_CELL__c)) &amp;&amp;  LEN(NBR_PHONE_CELL__c)!=10)</errorConditionFormula>
        <errorDisplayField>NBR_PHONE_CELL__c</errorDisplayField>
        <errorMessage>Cell Phone must be 10 digits</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Facility_Phone_must_of_10_digits</fullName>
        <active>true</active>
        <errorConditionFormula>NOT( ISBLANK(NBR_PHONE_FAC__c)) &amp;&amp;  LEN(NBR_PHONE_FAC__c)!=10</errorConditionFormula>
        <errorDisplayField>NBR_PHONE_FAC__c</errorDisplayField>
        <errorMessage>Facility Phone must be 10 digits</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Fax_Number_must_be_10_digits</fullName>
        <active>true</active>
        <errorConditionFormula>(NOT( ISBLANK(NBR_FAX__c)) &amp;&amp;  LEN(NBR_FAX__c)!=10)</errorConditionFormula>
        <errorDisplayField>NBR_FAX__c</errorDisplayField>
        <errorMessage>Fax Number must be 10 digits</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Home_Phone_must_be_10_digits</fullName>
        <active>true</active>
        <errorConditionFormula>(NOT( ISBLANK(NBR_PHONE_HOME__c)) &amp;&amp;  LEN(NBR_PHONE_HOME__c)!=10)</errorConditionFormula>
        <errorDisplayField>NBR_PHONE_HOME__c</errorDisplayField>
        <errorMessage>Home Phone must be 10 digits</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>AllBackGroundChecks_noFutureDate</fullName>
        <active>true</active>
        <errorConditionFormula>DTE_AllBackGroundChecks__c &gt; TODAY()</errorConditionFormula>
        <errorDisplayField>DTE_AllBackGroundChecks__c</errorDisplayField>
        <errorMessage>Date entered should be less than or equal to today.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>FBI5yearDueDate_noPastDate</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
 DTE_5yearFBIDueDate__c &lt; TODAY(),
 OR(
  ISCHANGED(DTE_5yearFBIDueDate__c),
  ISNEW()
 )
)</errorConditionFormula>
        <errorDisplayField>DTE_5yearFBIDueDate__c</errorDisplayField>
        <errorMessage>Date entered should be greater than or equal to today.</errorMessage>
    </validationRules>
