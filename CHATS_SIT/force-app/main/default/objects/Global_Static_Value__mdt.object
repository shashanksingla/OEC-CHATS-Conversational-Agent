<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>This should be used for all static key value pair as an environment variables.</description>
    <fields>
        <fullName>Category__c</fullName>
        <description>Give the category to make this record uniquely available.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Category</label>
        <length>50</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Value__c</fullName>
        <description>Give the actual value which should be referenced in custom code.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Value</label>
        <length>80</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>isActive__c</fullName>
        <defaultValue>true</defaultValue>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>isActive</label>
        <type>Checkbox</type>
    </fields>
    <label>Global Static Value</label>
    <pluralLabel>Global Static Values</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
