    <validationRules>
        <fullName>Cell_Phone_Must_be_10_Digits</fullName>
        <active>true</active>
        <description>Cell Phone must be 10 digits</description>
        <errorConditionFormula>AND(NOT(ISBLANK(NBR_PHONE_CELL__c)),LEN(NBR_PHONE_CELL__c) != 10)</errorConditionFormula>
        <errorDisplayField>NBR_PHONE_CELL__c</errorDisplayField>
        <errorMessage>Cell Phone must be 10 digits</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Facility_Phone_must_of_10_digits</fullName>
        <active>true</active>
        <description>Facility Phone must be 10 digits</description>
        <errorConditionFormula>AND(NOT(ISBLANK(NBR_PHONE_FAC__c)),LEN(NBR_PHONE_FAC__c) != 10)</errorConditionFormula>
        <errorDisplayField>NBR_PHONE_FAC__c</errorDisplayField>
        <errorMessage>Facility Phone must be 10 digits</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Fax_Number_must_be_10_digits</fullName>
        <active>true</active>
        <description>Fax Number must be 10 digits</description>
        <errorConditionFormula>AND(NOT(ISBLANK(NBR_FAX__c)),LEN(NBR_FAX__c) != 10)</errorConditionFormula>
        <errorDisplayField>NBR_FAX__c</errorDisplayField>
        <errorMessage>Fax Number must be 10 digits</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Home_Phone_must_be_10_digits</fullName>
        <active>true</active>
        <description>Home Phone must be 10 digits</description>
        <errorConditionFormula>AND(NOT(ISBLANK(NBR_PHONE_HOME__c)),LEN(NBR_PHONE_HOME__c)!=10)</errorConditionFormula>
        <errorDisplayField>NBR_PHONE_HOME__c</errorDisplayField>
        <errorMessage>Home Phone must be 10 digits</errorMessage>
    </validationRules>
