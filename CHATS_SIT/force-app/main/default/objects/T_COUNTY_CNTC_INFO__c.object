    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Ext_len_mustbe_5</fullName>
        <active>true</active>
        <description>CHAT-2124: Extension must be 5 digit number</description>
        <errorConditionFormula>AND(NOT(ISBLANK(NBR_PHONE_EXT__c)), 
OR(LEN(NBR_PHONE_EXT__c) &gt; 5, 
NOT(ISNUMBER(NBR_PHONE_EXT__c)) 
) 
)</errorConditionFormula>
        <errorDisplayField>NBR_PHONE_EXT__c</errorDisplayField>
        <errorMessage>Please provide the 5-digit Phone Number Extension.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Fax_Nbr_Len_MustBe_10</fullName>
        <active>true</active>
        <description>Fax Number must be 10 digit number</description>
        <errorConditionFormula>AND(NOT(ISBLANK(NBR_FAX__c)), 
OR(LEN(NBR_FAX__c) &lt;&gt; 10, 
NOT(ISNUMBER(NBR_FAX__c)) 
) 
)</errorConditionFormula>
        <errorDisplayField>NBR_FAX__c</errorDisplayField>
        <errorMessage>Please provide the 10-digit Fax Number.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Phn_Nbr_Len_10</fullName>
        <active>true</active>
        <description>Validation to check Phone Number is of 10 digits</description>
        <errorConditionFormula>OR(  NOT(ISNUMBER( NBR_PHONE__c )) ,
    LEN( NBR_PHONE__c ) &lt;&gt; 10
)</errorConditionFormula>
        <errorDisplayField>NBR_PHONE__c</errorDisplayField>
        <errorMessage>Please provide the 10-digit Phone Number.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
