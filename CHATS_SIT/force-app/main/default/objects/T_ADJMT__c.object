    <fields>
        <fullName>AMT_ADJMT__c</fullName>
        <externalId>false</externalId>
        <formula>CASE(TEXT(CDE_AGNST_ADJMT__c), &apos;1&apos;, Adjustment_Details_Amount__c, &apos;2&apos;, Non_Adjustment_Details_Amount__c,Null )</formula>
        <label>Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
