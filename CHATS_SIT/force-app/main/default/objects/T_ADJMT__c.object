        <fullName>CHK_CR206ForceTrigger__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Project 353 | JIRA CCCAP-6051 | When true, CR206 is generated once and set it to false</description>
        <externalId>false</externalId>
