        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Reimbursable_Legacy__c</fullName>
        <description>The field is used to store the value of IND_REIMBSL_PMT field for legacy records.</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
