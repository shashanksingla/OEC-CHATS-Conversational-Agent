        <type>Date</type>
    </fields>
<fields>
        <fullName>Cancel_Button_Access__c</fullName>
        <externalId>false</externalId>
        <formula>AND(ISPICKVAL(CDE_TYPE_ADJMT__c, &apos;2&apos;),OR(ISPICKVAL(CDE_STATUS_ADJMT__c, &apos;2&apos;),ISPICKVAL(CDE_STATUS_ADJMT__c, &apos;5&apos;)), RecordType.DeveloperName = &apos;Finalized&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Cancel Button Access</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
