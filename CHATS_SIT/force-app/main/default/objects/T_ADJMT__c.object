        <searchResultsAdditionalFields>DTE_END_ADJMT__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CDE_STATUS_ADJMT__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CDE_AGNST_ADJMT__c</searchResultsAdditionalFields>
