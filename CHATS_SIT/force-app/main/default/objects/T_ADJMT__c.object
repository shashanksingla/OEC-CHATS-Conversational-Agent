    <fields>
        <fullName>IND_REIMBSL_PMT__c</fullName>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL(CDE_TYPE_ADJMT__c, &apos;2&apos;), &apos;Yes&apos;,IF( ISBLANK(Reimbursable_Legacy__c), 
IF( ABS((MONTH(DTE_START_ADJMT__c) + (12*(YEAR(DTE_START_ADJMT__c)-YEAR(DATEVALUE(CreatedDate)))) - MONTH(DATEVALUE(CreatedDate)))) &lt;= 3, &apos;Yes&apos;, &apos;No&apos;), Reimbursable_Legacy__c))</formula>
        <label>Reimbursable</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Non_Adjustment_Details_Amount__c</fullName>
        <description>Sum of Adjusted Amount on all Non Adjustment Details. This field is referred in AMT_ADJMT.</description>
        <externalId>false</externalId>
        <label>Non Adjustment Details Amount</label>
        <summarizedField>T_NON_ADJMT_DETAIL__c.AMT_DETAIL_ADJMT__c</summarizedField>
