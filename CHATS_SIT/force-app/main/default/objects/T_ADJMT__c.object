    <enableStreamingApi>true</enableStreamingApi> 
    <fields>
        <fullName>Recovery_Initiative__c</fullName>
        <externalId>false</externalId>
        <label>Recovery Initiative</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Claim Established</fullName>
                    <default>false</default>
                    <label>Claim Established</label>
                </value>
                <value>
                    <fullName>Claim Established and IPV will be pursued</fullName>
                    <default>false</default>
                    <label>Claim Established and IPV will be pursued</label>
                </value>
                <value>
