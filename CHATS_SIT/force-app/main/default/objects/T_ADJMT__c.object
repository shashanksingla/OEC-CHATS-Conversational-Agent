    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Adjmnt_cannotBe_claim_if_case_isNotNull</fullName>
        <active>true</active>
        <description>Adjustment Type cannot be &apos;Claim&apos; when Case Id is not Null</description>
        <errorConditionFormula>AND( NOT(ISBLANK( IDN_CASE__r.Id )), TEXT(CDE_TYPE_ADJMT__c) = &apos;1&apos;,ISPICKVAL(CDE_STATUS_ADJMT__c, &apos;1&apos;) )</errorConditionFormula>
        <errorDisplayField>CDE_TYPE_ADJMT__c</errorDisplayField>
        <errorMessage>Adjustment Type cannot be &apos; Claim &apos;  with Case# entered.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CareEndDate_CareStartDate_SameMonth</fullName>
        <active>true</active>
        <description>Both Care Start Date and Care End Date must be in same Month</description>
        <errorConditionFormula>AND(
OR(
    (YEAR(DTE_START_ADJMT__c)&lt;&gt;YEAR(DTE_END_ADJMT__c)),
    (MONTH(DTE_START_ADJMT__c)&lt;&gt;MONTH(DTE_END_ADJMT__c))
),
AND(ISPICKVAL(CDE_STATUS_ADJMT__c, &apos;1&apos;),
OR(ISPICKVAL(CDE_TYPE_ADJMT__c, &apos;1&apos;),ISPICKVAL(CDE_TYPE_ADJMT__c, &apos;3&apos;))) 
)</errorConditionFormula>
        <errorMessage>Both the Care Start Date and the Care End Date must be in the same month.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>DTE_END_ADJMT_Validation</fullName>
        <active>true</active>
        <description>Care End Date Cannot be in Future.</description>
        <errorConditionFormula>DTE_END_ADJMT__c &gt;  TODAY()  &amp;&amp; ISPICKVAL(CDE_STATUS_ADJMT__c, &apos;1&apos;)</errorConditionFormula>
        <errorDisplayField>DTE_END_ADJMT__c</errorDisplayField>
        <errorMessage>The Care End Date cannot be in the future.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>DTE_Start_ADJMT_Validation</fullName>
        <active>true</active>
        <description>Care Start Date Cannot be in Future</description>
        <errorConditionFormula>DTE_START_ADJMT__c &gt; TODAY() &amp;&amp; ISPICKVAL(CDE_STATUS_ADJMT__c, &apos;1&apos;)</errorConditionFormula>
        <errorDisplayField>DTE_START_ADJMT__c</errorDisplayField>
        <errorMessage>The Care Start Date cannot be in the future.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>careEndDate_Grtrthan_careStartDate</fullName>
        <active>true</active>
        <description>Care End Date must be greater than Care Begin Date</description>
        <errorConditionFormula>DTE_END_ADJMT__c &lt; DTE_START_ADJMT__c  &amp;&amp; ISPICKVAL(CDE_STATUS_ADJMT__c, &apos;1&apos;)</errorConditionFormula>
        <errorMessage>The Care End Date must be greater than the Care Begin Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>either_case_or_provr_must_be_entered</fullName>
        <active>true</active>
        <description>CHAT-525: one of IDN_PROVR or IDN_CASE must be entered</description>
        <errorConditionFormula>AND(  ISBLANK(IDN_CASE__c),
      ISBLANK(IDN_PROVR__c), 
      ISPICKVAL(CDE_STATUS_ADJMT__c, &apos;1&apos;) 
   )</errorConditionFormula>
        <errorMessage>Either Case or Provider must be entered.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>either_case_or_provr_must_be_enteredNtbt</fullName>
        <active>true</active>
        <description>CHAT-525: one of IDN_PROVR or IDN_CASE must be entered. Not both</description>
        <errorConditionFormula>AND(
NOT(OR(  ISBLANK(IDN_CASE__c),
      ISBLANK(IDN_PROVR__c) 
   )),
   ISPICKVAL(CDE_STATUS_ADJMT__c, &apos;1&apos;) 
)</errorConditionFormula>
        <errorMessage>Either Case or Provider must be entered. Not both.</errorMessage>
    </validationRules>
    <!--Commented as part of CCCAP-10798-->
    <!--validationRules>
        <fullName>Provider_License_Closed</fullName>
        <active>false</active>
        <description>On Closed Provier Adjustment of type Claim can not be created</description>
        <errorConditionFormula>AND(  TEXT(CDE_TYPE_ADJMT__c) = &apos;1&apos;,NOT(ISPICKVAL( IDN_PROVR__r.CDE_STATUS_PROVR__c , &apos;Open&apos;)),OR((TEXT( CDE_STATUS_ADJMT__c ) = &apos;&apos;),(TEXT(CDE_STATUS_ADJMT__c) = &apos;1&apos;)) )</errorConditionFormula>
        <errorMessage>Adjustment cannot be created for the care dates when provider license status is closed</errorMessage>
    </validationRules-->
    <validationRules>
        <fullName>OriginalDiscoveryDate_Required</fullName>
        <active>true</active>
        <description>Project 353 | JIRA CCCAP-6051</description>
        <errorConditionFormula>AND(
 ISNULL(DTE_DISCV_ADJMT_ORIG__c),
 ISPICKVAL(CDE_TYPE_ADJMT__c, &quot;2&quot;),
 OR(
  ISNEW(),
  ISCHANGED( CDE_COUNTY__c ),
  ISCHANGED( IDN_CASE__c ),
  ISCHANGED( IDN_PROVR__c ),
  ISCHANGED( CDE_AGNST_ADJMT__c ),
  ISCHANGED( CDE_TYPE_ADJMT__c ),
  ISCHANGED( DTE_START_ADJMT__c ),
  ISCHANGED( DTE_END_ADJMT__c )
 )
)</errorConditionFormula>
        <errorDisplayField>DTE_DISCV_ADJMT_ORIG__c</errorDisplayField>
        <errorMessage>Field is required when Adjustment Type is Recovery</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Adjustment_Recover_Cancellation_Rule</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(CDE_TYPE_ADJMT__c,&apos;2&apos;), 
        OR(
                        AND (
                                                    NOT(ISCHANGED(DTE_INIT_CANCEL__c)),
                                                                    ISPICKVAL(CDE_STATUS_ADJMT__c, &apos;5&apos;)
                                                                ),
                                    AND (
                                                    NOT(ISCHANGED(DTE_CANCEL_ADJMT__c)),
                                                                    ISPICKVAL(CDE_STATUS_ADJMT__c, &apos;6&apos;)
                                                                )
        )
    )</errorConditionFormula>
        <errorMessage>This record can not be updated due to cancellation.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
