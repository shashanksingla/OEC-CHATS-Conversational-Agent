    <label>CCCAP Address</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>{0}</displayFormat>
        <label>ID</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>CCCAP Addresses</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Length_ZIP_eq_9</fullName>
        <active>true</active>
        <description>Length of the ZIP field equal to 5</description>
        <errorConditionFormula>AND(NOT(ISBLANK(ADR_ZIP_MAIN__c)), 
    OR( LEN(ADR_ZIP_MAIN__c) &lt;&gt; 5, 
        NOT(ISNUMBER(ADR_ZIP_MAIN__c)) 
    ) 
)</errorConditionFormula>
        <errorDisplayField>ADR_ZIP_MAIN__c</errorDisplayField>
        <errorMessage>Please provide the complete 5 digit Zip Address</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ZIP_Extension_4_digit</fullName>
        <active>true</active>
        <description>value must be 4 digits long</description>
        <errorConditionFormula>AND(
	NOT(ISBLANK(ADR_ZIP_EXTN__c)), 
	OR( 
		LEN(ADR_ZIP_EXTN__c) &lt;&gt; 4, 
		NOT(ISNUMBER(ADR_ZIP_EXTN__c)) 
	  ) 
)</errorConditionFormula>
        <errorDisplayField>ADR_ZIP_EXTN__c</errorDisplayField>
        <errorMessage>Please provide the complete 4 digit Zip extension</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
