    <fields>
        <fullName>Assignee__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Assignee</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Client_Complaints</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <trackHistory>true</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Complaint_Body__c</fullName>
        <encryptionScheme>None</encryptionScheme>
        <inlineHelpText>&quot;Complaint” means a verbal or written expression of dissatisfaction by an applicant, adult caretaker, teen parent, or child care provider to a county or the Department that is: (1) significant, meaning not yet resolved and severe enough that resources should be contributed to resolve it immediately, and (2) controllable, meaning the county had the ability to alter the negative event preceding the complaint, but failed to take the necessary steps to prevent it.</inlineHelpText>
        <label>Complaint Body</label>
        <length>5000</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Complaint_Status__c</fullName>
        <label>Complaint Status</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>R00900</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Complaint_Types__c</fullName>
        <label>Complaint Types</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>R00899</valueSetName>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>DTE_Complaint_Resolved__c</fullName>
        <encryptionScheme>None</encryptionScheme>
        <label>Complaint Resolved Date</label>
        <required>false</required>
