    </fields>
    <fields>
        <fullName>DTE_County_Response__c</fullName>
        <encryptionScheme>None</encryptionScheme>
        <inlineHelpText>Counties must respond to contact from families and/or child care providers within three (3) business days.</inlineHelpText>
        <label>Initial County Response Date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
