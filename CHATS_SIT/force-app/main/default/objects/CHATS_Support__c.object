    <fields>
        <fullName>Ticket_Closure_Date__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Date this ticket was resolved by State CCCAP Team/Helpdesk</inlineHelpText>
        <label>Ticket Closure Date</label>
        <required>false</required>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Ticket_Created_Date_Date_only__c</fullName>
        <externalId>false</externalId>
        <formula>DATEVALUE(CreatedDate)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Ticket Created Date (Date only)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Time_to_Initial_Response_Business_Hours__c</fullName>
        <externalId>false</externalId>
        <formula>9 * (
( 5 * FLOOR( ( DATEVALUE( Initial_Response_Date__c ) - DATE( 1900, 1, 8) ) / 7) +
MIN(5,
MOD( DATEVALUE(Initial_Response_Date__c) - DATE( 1900, 1, 8), 7) +
MIN( 1, 24 / 9 * ( MOD( Initial_Response_Date__c - DATETIMEVALUE( &apos;1900-01-08 13:30:00&apos; ), 1 ) ) )
)
)
-
( 5 * FLOOR( ( DATEVALUE(  CreatedDate  ) - DATE( 1900, 1, 8) ) / 7) +
MIN( 5,
MOD( DATEVALUE( CreatedDate) - DATE( 1996, 1, 1), 7 ) +
MIN( 1, 24 / 9 * ( MOD( CreatedDate- DATETIMEVALUE( &apos;1900-01-08 13:30:00&apos; ), 1) ) )
)
)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Time to Initial Response-Business Hours</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Time_to_Initial_Response_Clock_Hours__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT( FLOOR(   Initial_Response_Date__c  -  CreatedDate  ) ) + &apos; days &apos; +
TEXT( FLOOR( MOD((Initial_Response_Date__c -  CreatedDate) * 1440, 1440) / 60) ) + &apos; hours &apos; +
TEXT( ROUND(MOD( MOD((Initial_Response_Date__c -  CreatedDate) * 1440, 1440), 60), 2) ) + &apos; mins&apos;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Time to Initial Response-Clock Hours</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Time_to_TIcket_Closure_Business_Hours__c</fullName>
        <externalId>false</externalId>
        <formula>9 * (
( 5 * FLOOR( ( DATEVALUE(   Ticket_Closure_Date__c   ) - DATE( 1900, 1, 8) ) / 7) +
MIN(5,
MOD( DATEVALUE(Ticket_Closure_Date__c) - DATE( 1900, 1, 8), 7) +
MIN( 1, 24 / 9 * ( MOD( Ticket_Closure_Date__c - DATETIMEVALUE( &apos;1900-01-08 13:30:00&apos; ), 1 ) ) )
)
)
-
( 5 * FLOOR( ( DATEVALUE(  CreatedDate  ) - DATE( 1900, 1, 8) ) / 7) +
MIN( 5,
MOD( DATEVALUE( CreatedDate) - DATE( 1996, 1, 1), 7 ) +
MIN( 1, 24 / 9 * ( MOD( CreatedDate- DATETIMEVALUE( &apos;1900-01-08 13:30:00&apos; ), 1) ) )
)
)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Time to TIcket Closure-Business Hours</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Time_to_Ticket_Closure_Clock_Hours__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT( FLOOR( Ticket_Closure_Date__c    -  CreatedDate  ) ) + &apos; days &apos; +
TEXT( FLOOR( MOD((Ticket_Closure_Date__c-  CreatedDate) * 1440, 1440) / 60) ) + &apos; hours &apos; +
TEXT( ROUND(MOD( MOD((Ticket_Closure_Date__c -  CreatedDate) * 1440, 1440), 60), 2) ) + &apos; mins&apos;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Time to Ticket Closure-Clock Hours</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
