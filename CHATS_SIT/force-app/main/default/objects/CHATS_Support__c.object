    <validationRules>
        <fullName>Can_Only_Edit_NEW_CHATS_Support_Ticket</fullName>
        <active>true</active>
        <description>Allows users to only edit New status tickets.</description>
        <errorConditionFormula>AND 
            ( ISPICKVAL( PRIORVALUE(Status__c),&quot;Fixed/Completed&quot;), 
            NOT(OR($Profile.Name = &quot;Eligibility Worker&quot;,
            $Profile.Name = &quot;Fiscal Worker&quot;,
            $Profile.Name = &quot;Provider Worker&quot;,
            $Profile.Name = &quot;Universal User&quot;,
            $Profile.Name = &quot;Read Only User&quot;, 
            $Profile.Name = &quot;Eligibility Worker Supervisor&quot;, 
            $Profile.Name = &quot;Fiscal Worker Supervisor&quot;, 
            $Profile.Name = &quot;Provider Worker Supervisor&quot;, 
            $Profile.Name = &quot;System Administrator&quot;, 
            $Profile.Name = &quot;System Admin&quot;, 
            $Profile.Name = &quot;CHATS System Administrator&quot;,
            $Profile.Name = &quot;Business Office Worker&quot;,
            $Profile.Name = &quot;Business Office Supervisor&quot;,
            $Profile.Name = &quot;State IT User&quot;,
            $Profile.Name = &quot;State Program Administrator&quot;,
            $Profile.Name = &quot;CCCAP Program Internal Team&quot;
            )) 
            )</errorConditionFormula>
        <errorMessage>You cannot Edit a Fixed/Completed Support Ticket.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Cannot_Edit_In_Progress_Tickets</fullName>
        <active>true</active>
        <description>Prevents users from editing an In-Progress Status ticket</description>
        <errorConditionFormula>AND
            (ISPICKVAL(PRIORVALUE(Status__c), &quot;In Progress&quot;), 
            NOT(OR(
             $Profile.Name = &quot;Eligibility Worker&quot;, 
             $Profile.Name = &quot;Fiscal Worker&quot;, 
             $Profile.Name = &quot;Provider Worker&quot;, 
             $Profile.Name = &quot;Business Office Worker&quot;, 
             $Profile.Name = &quot;Read Only User&quot;, 
             $Profile.Name = &quot;Eligibility Worker Supervisor&quot;, 
             $Profile.Name = &quot;Fiscal Worker Supervisor&quot;, 
             $Profile.Name = &quot;Provider Worker Supervisor&quot;, 
             $Profile.Name = &quot;Business Office Supervisor&quot;, 
             $Profile.Name = &quot;Universal User&quot;, 
             $Profile.Name = &quot;State IT User&quot;, 
             $Profile.Name = &quot;State Program Administrator&quot;, 
             $Profile.Name = &quot;System Administrator&quot;, 
             $Profile.Name = &quot;System Admin&quot;, 
             $Profile.Name = &quot;CHATS System Administrator&quot;,
             $Profile.Name = &quot;CCCAP Program Internal Team&quot;
            )) 
           )</errorConditionFormula>
        <errorMessage>You cannot Edit an In Progress Support Ticket. State Staff have already begun working on this ticket.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Complete_Staff_Member_Being_Replaced</fullName>
        <active>true</active>
        <description>Returns an error if Yes is selected in the Is this staff member replacing another field, but no member is selected.</description>
        <errorConditionFormula>AND(
 OR(ISBLANK(  Name_of_staff_member_being_replaced__c  ) ,
ISBLANK( Date_to_Deactivate_Previous_Staff__c ),ISPICKVAL( Reason_for_Deactivation__c,&apos;&apos;)),
ISPICKVAL( Is_this_staff_member_replacing_another__c ,&quot;Yes&quot;))</errorConditionFormula>
        <errorDisplayField>Name_of_staff_member_being_replaced__c</errorDisplayField>
        <errorMessage>You must choose the name of the ACTIVE CHATS staff member that is being replaced, and complete the &quot;Date to deactivate previous staff member&quot; and &quot;Reason for Deactivation&quot; fields.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>DateEndIfTemporaryAccess6Months</fullName>
        <active>true</active>
        <errorConditionFormula>AND( RecordType.DeveloperName =&apos;System_Access_Request&apos;,Temporary_Access_End_Date__c  &gt;
DATE(
  YEAR( Start_Deactivation_Change_Date__c ) + FLOOR( ( MONTH ( Start_Deactivation_Change_Date__c ) + 6 - 1 ) / 12 ),
  MOD( MONTH ( Start_Deactivation_Change_Date__c ) + 6 - 1 + 
    IF( DAY ( Start_Deactivation_Change_Date__c ) &gt; CASE( MOD( MONTH( Start_Deactivation_Change_Date__c ) + 6 - 1, 12 ) + 1, 
      2, 28,
      4, 30,
      6, 30,
      9, 30, 
      11, 30,
      31 ), 1, 0 ), 12 ) + 1,
    IF( DAY( Start_Deactivation_Change_Date__c ) &gt; CASE( MOD( MONTH( Start_Deactivation_Change_Date__c ) + 6 - 1, 12 ) + 1,
      2, 28, 
      4, 30, 
      6, 30, 
      9, 30, 
      11, 30, 
      31 ), 
    1, DAY( Start_Deactivation_Change_Date__c )
  )
))</errorConditionFormula>
        <errorDisplayField>Temporary_Access_End_Date__c</errorDisplayField>
        <errorMessage>End Date if Temporary Access cannot be greater than 6 months from Begin Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>DateEndIfTemporaryAccessUniversalUser</fullName>
        <active>true</active>
        <errorConditionFormula>AND( ISPICKVAL(Access_Level_Requested__c  , &apos;Universal User&apos;),  ISPICKVAL(Reason_for_Universal_User__c , &apos;1&apos;), ISNULL( Temporary_Access_End_Date__c ), RecordType.DeveloperName =&apos;System_Access_Request&apos; )</errorConditionFormula>
        <errorDisplayField>Temporary_Access_End_Date__c</errorDisplayField>
        <errorMessage>End Date if Temporary Access is required when Access LevelRequested is Universal User and Reason for Universal User is Time Limited temporary access request (No longer than 6 months at a time)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Justification_for_Access_Request_Require</fullName>
        <active>true</active>
        <description>Access request for Read only or Universal User requires justification and information entered in the description field.   (WILL ADD Universal User value into rule when Universal user becomes picklist option in Access Level Requested Field)</description>
        <errorConditionFormula>AND( 
ISBLANK(Access_Request_Title_Info_Justification__c), 
ISPICKVAL(Access_Level_Requested__c,&quot;Read Only&quot;))</errorConditionFormula>
        <errorDisplayField>Access_Request_Title_Info_Justification__c</errorDisplayField>
        <errorMessage>Please enter the user&apos;s position title and information when requesting &quot;Read Only&quot; access. See helptext for information needed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Must_Select_Who_Elevated_To</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT(ISBLANK(Date_Elevated__c)),
(ISPICKVAL(Elevated_to__c, &quot;&quot;))
)</errorConditionFormula>
        <errorDisplayField>Elevated_to__c</errorDisplayField>
        <errorMessage>Enter who the ticket was elevated to. May also specify more in Internal Comments.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ReadOnly_Required_Fields</fullName>
        <active>true</active>
        <description>Requires completion of all necessary fields on the system access page layout.</description>
        <errorConditionFormula>AND( 
            ISPICKVAL(Support_Type__c, &quot;Read-Only Access Request&quot;), 
            $Profile.Name==&quot;Eligibility Worker Supervisor&quot;, 
            $Profile.Name==&quot;Fiscal Worker Supervisor&quot;, 
            $Profile.Name==&quot;Provider Worker Supervisor&quot;, 
            $Profile.Name==&quot;Universal User&quot;, 
            $Profile.Name== &quot;CCCAP Program Internal Team&quot;, 
            $Profile.Name==&quot;System Administrator&quot;, 
            $Profile.Name==&quot;System Admin&quot;, 
            $Profile.Name==&quot;CHATS System Administrator&quot;, 
            OR( 
            ISBLANK(Email_Address__c), 
            ISBLANK(Last_Name__c), 
            ISBLANK(First_name__c), 
            ISBLANK(Phone_Number__c), 
            ISBLANK(Start_Deactivation_Change_Date__c), 
            ISBLANK(TEXT(Is_this_staff_member_replacing_another__c)), 
            ISBLANK(TEXT(Access_Level_Requested__c)) 
            ) 
            )</errorConditionFormula>
        <errorMessage>For a Read-Only Access Request, Please ensure the following fields have been completed: Start Date; First Name; Last Name; Email Address; Profile Name; Phone #; Is this staff member replacing another.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Reason_Deactivation_Required_Prev_Staff</fullName>
        <active>true</active>
        <description>Reason for Deactivation is not specified after stating staff is replacing another.</description>
        <errorConditionFormula>AND(ISPickval(Is_this_staff_member_replacing_another__c, &apos;Yes&apos;),Ispickval( Reason_for_Deactivation__c ,&apos;&apos;))</errorConditionFormula>
        <errorDisplayField>Reason_for_Deactivation__c</errorDisplayField>
        <errorMessage>You must specify the Reason for Deactivation.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ReasonforUniversalReasonRequired</fullName>
        <active>true</active>
        <errorConditionFormula>AND( RecordType.DeveloperName =&apos;System_Access_Request&apos;,ISPICKVAL(Access_Level_Requested__c , &apos;Universal User&apos;), ISBLANK( TEXT(Reason_for_Universal_User__c) )  )</errorConditionFormula>
        <errorDisplayField>Reason_for_Universal_User__c</errorDisplayField>
        <errorMessage>Reason for Universal reason is required for Access Level requested &apos;Universal User&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Req_Actual_Results_if_Supp_Cat_is_System</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(Support_Category__c , &apos;System&apos;), RecordType.DeveloperName =&apos;Support_Ticket&apos;,   ISBLANK( Actual_Results__c)    )</errorConditionFormula>
        <errorDisplayField>Actual_Results__c</errorDisplayField>
        <errorMessage>Required when Support Category is System.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>RequireUploadedDocumentForUniversalUser</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL( Access_Level_Requested__c,&apos;Universal User&apos;), RecordType.DeveloperName =&apos;System_Access_Request&apos;,! Uploaded_Document__c )</errorConditionFormula>
        <errorDisplayField>Uploaded_Document__c</errorDisplayField>
        <errorMessage>You must attach your County&apos;s policy for separation of duties if you are requesting Universal User access.</errorMessage>
    </validationRules>
    <!--Commented as part of CCCAP-10798-->
    <!--validationRules>
        <fullName>Req_CHATS_Area_if_Supp_Cat_is_System</fullName>
        <active>false</active>
        <errorConditionFormula>AND(ISPICKVAL(Support_Category__c , &apos;System&apos;), RecordType.DeveloperName =&apos;Support_Ticket&apos;,  ISPICKVAL(CHATS_Area__c , &apos;&apos;)    )</errorConditionFormula>
        <errorDisplayField>CHATS_Area__c</errorDisplayField>
        <errorMessage>Required when Support Category is System.</errorMessage>
    </validationRules-->
    <validationRules>
        <fullName>Req_CHATS_Superv_if_Access_Req_Is_New_Wo</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL( Access_Request_Type__c , &apos;New Worker Access Request&apos;), RecordType.DeveloperName =&apos;System_Access_Request&apos;,  ISBLANK(  CHATS_Supervisor__c ))</errorConditionFormula>
        <errorDisplayField>CHATS_Supervisor__c</errorDisplayField>
        <errorMessage>Required when Access Type is New Worker Access Request.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Req_Expect_Results_if_Supp_Cat_is_System</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(Support_Category__c , &apos;System&apos;), RecordType.DeveloperName =&apos;Support_Ticket&apos;,   ISBLANK(  Expected_Results__c )    )</errorConditionFormula>
        <errorDisplayField>Expected_Results__c</errorDisplayField>
        <errorMessage>Required when Support Category is System.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Req_Page_URL_if_Supp_Cat_is_System</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(Support_Type__c , &apos;System Issue/Request&apos;), RecordType.DeveloperName =&apos;Support_Ticket&apos;,   ISBLANK(   Page_URL__c )    )</errorConditionFormula>
        <errorDisplayField>Page_URL__c</errorDisplayField>
        <errorMessage>Required when Support Type is System Issue/Request.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Req_Phone_Number_if_Access_Req_Is_New_Wo</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL( Access_Request_Type__c , &apos;New Worker Access Request&apos;), RecordType.DeveloperName =&apos;System_Access_Request&apos;,  ISBLANK( Phone_Number__c ))</errorConditionFormula>
        <errorDisplayField>Phone_Number__c</errorDisplayField>
        <errorMessage>Required when Access Type is New Worker Access Request.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Req_Position_Tit_if_Access_Req_Is_New_Wo</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL( Access_Request_Type__c , &apos;New Worker Access Request&apos;), RecordType.DeveloperName =&apos;System_Access_Request&apos;,  ISBLANK( Position_Title__c ))</errorConditionFormula>
        <errorDisplayField>Position_Title__c</errorDisplayField>
        <errorMessage>Required when Access Type is New Worker Access Request.</errorMessage>
    </validationRules>
    <!--Commented as part of CCCAP-10798-->
    <!--validationRules>
        <fullName>Req_Temp_Access_if_Access_Req_Is_New_Wo</fullName>
        <active>false</active>
        <errorConditionFormula>AND(ISPICKVAL(  Access_Level_Requested__c , &apos;Universal User&apos;), RecordType.DeveloperName =&apos;System_Access_Request&apos;,  OR(ISBLANK(  Temporary_Access_End_Date__c ),Temporary_Access_End_Date__c &lt; TODAY(),Temporary_Access_End_Date__c &gt; TODAY() + ( ( 365 / 12 ) * 6) ))</errorConditionFormula>
        <errorDisplayField>Temporary_Access_End_Date__c</errorDisplayField>
        <errorMessage>Required when Access Type is New Worker Access Request. And it must be less than or equal to 6 months from Today.</errorMessage>
    </validationRules-->
    <validationRules>
        <fullName>Req_Which_other_county</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(Do_you_work_for_multiple_counties__c , &apos;Yes&apos;), RecordType.DeveloperName =&apos;System_Access_Request&apos;,ISBLANK( Which_other_county__c ) )</errorConditionFormula>
        <errorDisplayField>Which_other_county__c</errorDisplayField>
        <errorMessage>Required when Do you perform work for multiple counties is Yes</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_Access_Deactivation_Fields</fullName>
        <active>true</active>
        <description>Required fields when Deactivate Access is chosen from the Support Ticket pick-list</description>
        <errorConditionFormula>AND( 
    ISPICKVAL(Support_Type__c, &quot;Deactivate Access&quot;), 
    
    $Profile.Name==&quot;Eligibility Worker Supervisor&quot;, 
    $Profile.Name==&quot;Fiscal Worker Supervisor&quot;, 
    $Profile.Name==&quot;Provider Worker Supervisor&quot;, 
    $Profile.Name==&quot;Universal User&quot;, 
    $Profile.Name==&quot;CCCAP Program Internal Team&quot;, 
    $Profile.Name==&quot;System Administrator&quot;, 
    $Profile.Name==&quot;System Admin&quot;, 
    $Profile.Name==&quot;CHATS System Administrator&quot; , 
    OR( 
    ISBLANK(Last_Name__c), 
    ISBLANK(First_name__c), 
    ISBLANK(CHATS_Supervisor__c),
    ISBLANK(Start_Deactivation_Change_Date__c)) 
    )</errorConditionFormula>
        <errorMessage>For a Deactivate Access, Please ensure the following fields have been completed: Start/Deactivation/Change date; First Name; Last Name; Email Address; CHATS Supervisor.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_Awaiting_User</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(Status__c, &apos;Awaiting User&apos;), ISBLANK(Awaiting_User__c) )</errorConditionFormula>
        <errorDisplayField>Awaiting_User__c</errorDisplayField>
        <errorMessage>Required when Status is in Awaiting User.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_Change_Profile_Fields</fullName>
        <active>true</active>
        <description>Required fields when Change Profile is selected from Support Type pick-list</description>
        <errorConditionFormula>AND( 
    ISPICKVAL(Access_Request_Type__c, &quot;Change Profile/Access&quot;), 
    $Profile.Name==&quot;Eligibility Worker Supervisor&quot;, 
    $Profile.Name==&quot;Fiscal Worker Supervisor&quot;, 
    $Profile.Name==&quot;Provider Worker Supervisor&quot;, 
    $Profile.Name==&quot;Universal User&quot;, 
    $Profile.Name==&quot;CCCAP Program Internal Team&quot;, 
    $Profile.Name==&quot;System Administrator&quot;, 
    $Profile.Name==&quot;System Admin&quot;, 
    $Profile.Name==&quot;CHATS System Administrator&quot;, 
    OR( 
    ISBLANK(Email_Address__c), 
    ISBLANK(Last_Name__c), 
    ISBLANK(First_name__c), 
    ISBLANK(Start_Deactivation_Change_Date__c), 
    ISBLANK(TEXT(Is_this_staff_member_replacing_another__c)), 
    ISBLANK(TEXT(Access_Level_Requested__c)) 
    ) 
    )</errorConditionFormula>
        <errorMessage>For Change Access, please ensure that the following fields are compeleted:
    Start Date, First Name, Last Name, CHATS Supervisor, Access Level Requested, Changing Profile Only check-box, Is this staff member replacing another?; Email address.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_System_Access_Fields</fullName>
        <active>true</active>
        <description>Requires completion of all necessary fields on the system access page layout.</description>
        <errorConditionFormula>AND( 
ISPICKVAL(Support_Type__c, &quot;Access Request&quot;), 
OR( 
ISBLANK(Email_Address__c), 
ISBLANK(Last_Name__c), 
ISBLANK(First_name__c), 
ISBLANK(CHATS_Supervisor__c ), 
ISBLANK(Phone_Number__c), 
ISBLANK(Start_Deactivation_Change_Date__c), 
ISBLANK(TEXT(Is_this_staff_member_replacing_another__c)), 
ISBLANK(TEXT(Access_Level_Requested__c) 
) 
))</errorConditionFormula>
        <errorMessage>For Access Request, Please ensure the following fields have been completed: Start Date; First and Last Name; Email; Access Level; Supervisor; Phone #; Is this staff member replacing another.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Support_Fields_Not_Available</fullName>
        <active>true</active>
        <description>Disable Support fields when Access Request is selected as Support Type.</description>
        <errorConditionFormula>AND( 
ISPICKVAL(Support_Type__c, &quot;System Access&quot;), 
(Client_Name__c&lt;&gt;&quot;&quot;),(Description_Steps_to_Reproduce__c&lt;&gt;&quot;&quot;),(Specific_Record_Number__c&lt;&gt;&quot;&quot;) 
)</errorConditionFormula>
        <errorDisplayField>Support_Type__c</errorDisplayField>
        <errorMessage>System Access was selected. Specify the Access Request Type and complete the Staff Access Information section, or select the appropriate Support Type.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Valid_Future_Desired_Date</fullName>
        <active>true</active>
        <description>Future Dates are only valid for this field.</description>
        <errorConditionFormula>Desired_PROD_Release_Date__c  &lt;=  TODAY()</errorConditionFormula>
        <errorDisplayField>Desired_PROD_Release_Date__c</errorDisplayField>
        <errorMessage>It should have future date.</errorMessage>
    </validationRules>
