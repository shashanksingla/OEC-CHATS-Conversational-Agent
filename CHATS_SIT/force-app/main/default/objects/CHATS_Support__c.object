        <fullName>Support_Email_Recipient_Name__c</fullName>
        <description>o update the Recipient name in Email template : Access Request Help Desk Template</description>
        <externalId>false</externalId>
        <formula>IF( (ISPICKVAL(Status__c , &apos;Awaiting User&apos;) &amp;&amp; (RecordType.Name = &apos;System Access Request&apos;)), AwaitingUser_FullName__c , Owner:User.FirstName + &apos; &apos; + Owner:User.LastName )</formula>
