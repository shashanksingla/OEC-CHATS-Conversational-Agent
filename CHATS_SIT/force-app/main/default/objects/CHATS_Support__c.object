    <label>Support</label>
    <listViews>
        <fullName>All1</fullName>
        <columns>NAME</columns>
        <columns>LAST_UPDATE</columns>
        <columns>Root_Cause__c</columns>
        <columns>JIRA_ID__c</columns>
        <columns>Priority__c</columns>
        <columns>CHATS_Area__c</columns>
        <columns>Status__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Status__c</field>
            <operation>equals</operation>
            <value>New,In Progress,Awaiting User,Elevated</value>
        </filters>
        <filters>
            <field>JIRA_ID__c</field>
            <operation>equals</operation>
        </filters>
        <filters>
            <field>Root_Cause__c</field>
            <operation>equals</operation>
            <value>Clarification</value>
        </filters>
        <label>All</label>
    </listViews>
