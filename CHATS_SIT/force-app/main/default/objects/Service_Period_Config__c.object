    </fields>
    <fields>
        <fullName>Service_Period_Frequency__c</fullName>
        <description>Number of service periods (1, 2, 3, or 4 weeks) for which the state will pay
            providers at a time.</description>
        <label>Service Period Frequency</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>1</fullName>
                    <default>false</default>
                    <label>1 week</label>
                </value>
                <value>
                    <fullName>2</fullName>
                    <default>false</default>
                    <label>2 weeks</label>
                </value>
                <value>
                    <fullName>3</fullName>
                    <default>false</default>
                    <label>3 weeks</label>
                </value>
                <value>
                    <fullName>4</fullName>
                    <default>false</default>
                    <label>4 weeks</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Payment_Calculation_Day__c</fullName>
        <label>Payment Calculation Day</label>
