    <fields>
        <fullName>Future_Payment__c</fullName>
        <label>Future Payment?</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>true</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Y</fullName>
                    <default>false</default>
                    <label>Yes</label>
                </value>
                <value>
                    <fullName>N</fullName>
                    <default>false</default>
                    <label>No</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
