<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>County_Transferred_To_NotNULL</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
	    ISBLANK(TEXT(CDE_COUNTY_TRANSFER__c)),
        NOT(ISBLANK(DTE_CASE_TRANSFER__c))
	)</errorConditionFormula>
    <errorDisplayField>CDE_COUNTY_TRANSFER__c</errorDisplayField>
    <errorMessage>County Transferred To required field when Case Transfer Effective Date field is not blank.</errorMessage>
</ValidationRule>
