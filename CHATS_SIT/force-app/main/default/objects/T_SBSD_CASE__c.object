        <errorConditionFormula>VALUE(TEXT( Owner:User.Owner_County__c )) &lt;&gt;  CDE_COUNTY__r.CDE_COUNTY__c</errorConditionFormula>
        <errorDisplayField>CDE_COUNTY__c</errorDisplayField>
        <errorMessage>Cannot enter a County that&apos;s not affiliated with the User&apos;s profile</errorMessage>
    </validationRules-->
    <validationRules>
        <fullName>Case_Transfer_Effective_Date</fullName>
        <active>false</active>
        <description>- Cannot be before T_SBSD_CASE.DTE_APPLN
- Cannot be before 8/10/2018
- Required if CDE_COUNTY_TRANSFER is populated</description>
        <errorConditionFormula>OR(
   DTE_APPLN__c &gt; DTE_CASE_TRANSFER__c,
   Datevalue(&quot;2018-08-10&quot;) &gt; DTE_CASE_TRANSFER__c
)</errorConditionFormula>
        <errorDisplayField>DTE_CASE_TRANSFER__c</errorDisplayField>
        <errorMessage>Case Transfer Effective Date cannot be before Date Application Received or  8/10/2018.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Case_Transfer_Effective_Date_NotNULL</fullName>
        <active>false</active>
        <description>- Cannot be before T_SBSD_CASE.DTE_APPLN
- Cannot be before 8/10/2018
- Required if CDE_COUNTY_TRANSFER is populated</description>
        <errorConditionFormula>AND(
	    NOT(ISBLANK(TEXT(CDE_COUNTY_TRANSFER__c))),
        (ISBLANK(DTE_CASE_TRANSFER__c))
	)</errorConditionFormula>
        <errorDisplayField>DTE_CASE_TRANSFER__c</errorDisplayField>
        <errorMessage>Case Transfer Effective Date required field when County Transferred To field is not blank.</errorMessage>
    </validationRules>
     <validationRules>
        <fullName>County_Transferred_To_NotNULL</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
	    ISBLANK(TEXT(CDE_COUNTY_TRANSFER__c)),
        NOT(ISBLANK(DTE_CASE_TRANSFER__c))
	)</errorConditionFormula>
        <errorDisplayField>CDE_COUNTY_TRANSFER__c</errorDisplayField>
        <errorMessage>County Transferred To required field when Case Transfer Effective Date field is not blank.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Appl_Recvd_Date_cannot_be_future</fullName>
        <active>true</active>
        <description>Application Received Date cannot be in future</description>
        <errorConditionFormula>AND(NOT(ISBLANK(DTE_APPLN__c)), DTE_APPLN__c &gt; TODAY())</errorConditionFormula>
        <errorDisplayField>DTE_APPLN__c</errorDisplayField>
        <errorMessage>Date Application Received cannot be in future.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Case_Name_not_editable</fullName>
        <active>true</active>
        <description>CCCAP-2720 : To restrict Case Name being edited from List view in Case tab</description>
        <errorConditionFormula>AND(
 ISCHANGED( Name ),
 NOT(ISBLANK(PRIORVALUE( Name ))),
 PRIORVALUE( Name ) &lt;&gt; &quot;RECORD_FROM_CASE_FLOW&quot;,
 NOT (Bypass_CaseName_ValidationRule__c)
)</errorConditionFormula>
        <errorMessage>Case Name can not be changed after creation</errorMessage>
    </validationRules>
    <visibility>Public</visibility> 
</CustomObject>
