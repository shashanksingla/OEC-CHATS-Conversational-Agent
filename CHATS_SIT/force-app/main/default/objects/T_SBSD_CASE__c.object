    <!--Commented as part of CCCAP-10798-->
    <!--validationRules>
        <fullName>Cannot_upd_Redet_Pckge_Rcvd_Date</fullName>
        <active>false</active>
        <description>Cannot Update Redetermination Package Receive Date if the Case Status is Closed</description>
        <errorConditionFormula>AND( NOT( ISNEW() ) ,
    ISCHANGED( DTE_RCVD_PACKET_REDET__c ),
    CLOSED_CASES_STATUS__c &gt; 0
)</errorConditionFormula>
        <errorMessage>Cannot Update Redetermination Package Receive Date if the Case Status is Closed</errorMessage>
    </validationRules-->
    <validationRules>
        <fullName>Require_Provider_Facility_Name</fullName>
        <active>true</active>
        <description>Please provide Provider/Facility Name.</description>
        <errorConditionFormula>AND(!(Is_Peak_Data__c || (ISCHANGED(Is_Peak_Data__c) &amp;&amp; !Is_Peak_Data__c)),!(Is_CBMS_Data__c || (ISCHANGED(Is_CBMS_Data__c) &amp;&amp; !Is_CBMS_Data__c)),ISPICKVAL(IND_ASSIST_PROVR__c,&apos;Y&apos;) , ISBLANK(NAM_FACLTY_PROVR__c) )</errorConditionFormula>
        <errorDisplayField>NAM_FACLTY_PROVR__c</errorDisplayField>
        <errorMessage>Please provide Provider/Facility Name.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_Provider_First_Name</fullName>
        <active>true</active>
        <description>Please provide Provider First Name.</description>
        <errorConditionFormula>AND( !(Is_Peak_Data__c || (ISCHANGED(Is_Peak_Data__c) &amp;&amp; !Is_Peak_Data__c)) ,!(Is_CBMS_Data__c || (ISCHANGED(Is_CBMS_Data__c) &amp;&amp; !Is_CBMS_Data__c)),ISPICKVAL(IND_ASSIST_PROVR__c,&apos;Y&apos;) , ISBLANK(NAM_FIRST_PROVR__c) )</errorConditionFormula>
        <errorDisplayField>NAM_FIRST_PROVR__c</errorDisplayField>
        <errorMessage>Please provide Provider First Name.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_Provider_ID</fullName>
        <active>true</active>
        <description>Please provide the Provider ID</description>
        <errorConditionFormula>AND( !(Is_Peak_Data__c || (ISCHANGED(Is_Peak_Data__c) &amp;&amp; !Is_Peak_Data__c)) ,!(Is_CBMS_Data__c || (ISCHANGED(Is_CBMS_Data__c) &amp;&amp; !Is_CBMS_Data__c)),ISPICKVAL(IND_ASSIST_PROVR__c,&apos;Y&apos;) , ISBLANK(IDN_PROVR__c) )</errorConditionFormula>
        <errorDisplayField>IDN_PROVR__c</errorDisplayField>
        <errorMessage>Please provide the Provider ID</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_Provider_last_name</fullName>
        <active>true</active>
        <description>Please provide Provider Last Name.</description>
        <errorConditionFormula>AND(!(Is_Peak_Data__c || (ISCHANGED(Is_Peak_Data__c) &amp;&amp; !Is_Peak_Data__c))  ,!(Is_CBMS_Data__c || (ISCHANGED(Is_CBMS_Data__c) &amp;&amp; !Is_CBMS_Data__c)),ISPICKVAL(IND_ASSIST_PROVR__c,&apos;Y&apos;) , ISBLANK(NAM_LAST_PROVR__c) )</errorConditionFormula>
        <errorDisplayField>NAM_LAST_PROVR__c</errorDisplayField>
        <errorMessage>Please provide Provider Last Name.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_Who_determined_eligibility</fullName>
        <active>true</active>
        <description>Please Enter Who Determined Eligibility.</description>
        <errorConditionFormula>AND(!(Is_Peak_Data__c || (ISCHANGED(Is_Peak_Data__c) &amp;&amp; !Is_Peak_Data__c)),!(Is_CBMS_Data__c || (ISCHANGED(Is_CBMS_Data__c) &amp;&amp; !Is_CBMS_Data__c)),IND_ELG_PRE_PROVR__c == TRUE,ISBLANK(TEXT(LOC_ELG_DETERM__c)))</errorConditionFormula>
        <errorDisplayField>LOC_ELG_DETERM__c</errorDisplayField>
        <errorMessage>Please Enter Who Determined Eligibility.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cannot_chng_county</fullName>
        <active>true</active>
        <description>CHAT-1150: Read-only after record is created</description>
        <errorConditionFormula>AND( NOT(ISNEW()),
     ISCHANGED( CDE_COUNTY__c )
)</errorConditionFormula>
        <errorDisplayField>CDE_COUNTY__c</errorDisplayField>
        <errorMessage>county cannot be changed once the case record is created</errorMessage>
    </validationRules>
