    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Begin_Date_Prior_To_End_Date</fullName>
        <active>true</active>
        <errorConditionFormula>NOT(IDN_CLIENT__r.Is_Peak_Data__c) &amp;&amp; NOT(IDN_CLIENT__r.Is_CBMS_Data__c) &amp;&amp; DTE_BEGIN_EFFV__c &gt; DTE_END_EFFV__c</errorConditionFormula>
        <errorDisplayField>DTE_END_EFFV__c</errorDisplayField>
        <errorMessage>Effective End Date must be later than Effective Begin Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Req_HowVerified_If_VerifType_Writtn</fullName>
        <active>true</active>
        <description>Require How Verified field for Verified Type is &quot;Written Verification&quot;</description>
        <errorConditionFormula>AND(AND(NOT(IDN_CLIENT__r.Is_Peak_Data__c),NOT(IDN_CLIENT__r.Is_CBMS_Data__c)), ISPICKVAL(CDE_TYPE_VERIF__c, &quot;V&quot;) , 
    ISBLANK(TEXT(CDE_SOURCE_VRFD_EDUC__c) ) 
)</errorConditionFormula>
        <errorDisplayField>CDE_SOURCE_VRFD_EDUC__c</errorDisplayField>
        <errorMessage>Require How Verified field for Verified Type is &quot;Written Verification&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Warning_Message_before_saving_the_record</fullName>
        <active>true</active>
        <description>This record may not be appropriate for this individual based on their age and/or relationship to the primary caretaker of this case</description>
        <errorConditionFormula>AND(NOT(IDN_CLIENT__r.Is_Peak_Data__c),NOT(IDN_CLIENT__r.Is_CBMS_Data__c), NOT(IDN_CLIENT__r.Is_Primary_Parent_Caretaker__c),IDN_CLIENT__r.Age__c &lt; VALUE( $Label.Teen_Parent_Age_Limit ),NOT(IDN_CLIENT__r.Has_Allowed_Relationship__c),NOT(Ignore__c))</errorConditionFormula>
        <errorMessage>This record may not be appropriate for this individual based on their age and/or relationship to the primary caretaker of this case(to continue saving please tick Ignore checkbox)</errorMessage>
    </validationRules>
    <validationRules>
    	<fullName>BeginDateWithin31DaysFuture</fullName>
   	    <active>true</active>
    	<description>Begin Date cannot be more than 31 days in the future</description>
    	<errorConditionFormula>DTE_BEGIN_EFFV__c &gt;  TODAY() +31</errorConditionFormula>
    	<errorDisplayField>DTE_BEGIN_EFFV__c</errorDisplayField>
    	<errorMessage>Begin Date cannot be more than 31 days in the future</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>AntCompDateGreaterThanBeginDate</fullName>
        <active>true</active>
        <description>Anticipated completion date must be greater than effective begin date.</description>
        <errorConditionFormula>DTE_BEGIN_EFFV__c &gt;= DTE_END_ANT__c</errorConditionFormula>
        <errorDisplayField>DTE_END_ANT__c</errorDisplayField>
        <errorMessage>Anticipated Completion Date must be greater than Effective Begin Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>AntCompDateNotInPast</fullName>
        <active>true</active>
        <description>Anticipated completion date cannot be in the past.</description>
        <errorConditionFormula>DTE_END_ANT__c &lt; TODAY()</errorConditionFormula>
        <errorDisplayField>DTE_END_ANT__c</errorDisplayField>
        <errorMessage>Anticipated Completion Date cannot be in the past.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Hours_validation</fullName>
        <active>true</active>
        <errorConditionFormula>HOURS_SUD__c  &gt; 168</errorConditionFormula>
        <errorDisplayField>HOURS_SUD__c</errorDisplayField>
        <errorMessage>Enter the number of hours, up to 168</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
