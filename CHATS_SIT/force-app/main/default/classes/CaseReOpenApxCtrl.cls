                    }
            recordsToBeUpdated.add(currentCaseStatusMode);
            recordsToBeInserted.sort();
            recordsToBeUpdated.sort();
            System.debug('recordsToBeInserted:'+recordsToBeInserted);
            System.debug('recordsToBeUpdated:'+recordsToBeUpdated);
            List<Database.SaveResult> lstSaveResult = new List<Database.SaveResult>();
            List<CRUDPermissionException> lstCrudPermissionException = new List<CRUDPermissionException>();
            List<DMLResult> lstDMLResult = GenericDMLHandler.updateRecords(recordsToBeUpdated, false, new Map<String,Object>{'byPassObjects'=>new Set<String>{'T_SBSD_CASE_STATUS_MODE__c','T_APPLN_CASE__c','T_APPLN_PRCS_QUEUE__c'}});
            lstSaveResult.addAll(GenericDMLHandler.getSaveResultsFromDMLResults(lstDMLResult));
            lstCrudPermissionException.addAll(GenericDMLHandler.getCRUDPermissionExceptionsFromDMLResults(lstDMLResult));

			lstDMLResult = GenericDMLHandler.insertRecords(recordsToBeInserted, false, new Map<String,Object>{'byPassObjects'=>new Set<String>{'T_SBSD_CASE_STATUS_MODE__c','T_APPLN_CASE__c','T_APPLN_PRCS_QUEUE__c'}}, new list<string>{'CDE_MODE_CASE__c'}); //Added additional paramter of fieldNames for Checkmarx CCCAP-12580
            lstSaveResult.addAll(GenericDMLHandler.getSaveResultsFromDMLResults(lstDMLResult));
            lstCrudPermissionException.addAll(GenericDMLHandler.getCRUDPermissionExceptionsFromDMLResults(lstDMLResult));            

			lstDMLResult = GenericDMLHandler.insertRecords(new List<SObject>{newCaseStatus}, false, new Map<String,Object>{'byPassObjects'=>new Set<String>{'T_SBSD_CASE_STATUS_MODE__c','T_APPLN_CASE__c','T_APPLN_PRCS_QUEUE__c'}}, new list<string>{'CDE_MODE_CASE__c'});   //Added additional paramter of fieldNames for Checkmarx CCCAP-12580
