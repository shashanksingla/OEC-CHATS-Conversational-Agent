            lstCrudPermissionException.addAll(GenericDMLHandler.getCRUDPermissionExceptionsFromDMLResults(lstDMLResult));            

            lstDMLResult = GenericDMLHandler.updateRecords(new List<SObject>{caseRec}, false, methodInfo);
            lstSaveResult.addAll(GenericDMLHandler.getSaveResultsFromDMLResults(lstDMLResult));
            lstCrudPermissionException.addAll(GenericDMLHandler.getCRUDPermissionExceptionsFromDMLResults(lstDMLResult)); 
             
            //CCCAP-13251
            applnDateRec.IDN_CASE__c = caseRec.Id;
            applnDateRec.Maintain_Eligibility__c = newCaseStatus.CDE_ELIGTY_CONTNUS__c;
            if(applnDateRec.DTE_APPLN_NEW__c!=null){        
                lstDMLResult = GenericDMLHandler.insertRecords(new List<SObject>{applnDateRec}, false, methodInfo, new List<String>{'IDN_CASE__c','DTE_APPLN_OLD__c','CMT_OVERRIDE__c','DTE_APPLN_NEW__c','RSN_OVERRIDE__c','Maintain_Eligibility__c','Reopened_or_Elig__c'});
                lstSaveResult.addAll(GenericDMLHandler.getSaveResultsFromDMLResults(lstDMLResult));
                lstCrudPermissionException.addAll(GenericDMLHandler.getCRUDPermissionExceptionsFromDMLResults(lstDMLResult));         
             }
            //end CCCAP-13251        
            
            recordsToBeUpdated.addAll(recordsToBeInserted);
            recordsToBeUpdated.add(newCaseStatus);
            recordsToBeUpdated.add(caseRec);
            
            lstAPXFieldValidationError = CrudResponseApxCtrl.getCrudResponseFromSaveResults(recordsToBeUpdated, lstSaveResult);
            
            System.debug('recordsToBeUpdated:'+recordsToBeUpdated);
            System.debug('lstSaveResult:'+lstSaveResult);
            if(lstAPXFieldValidationError.isEmpty()){
                        if(!lstATSRecords.isEmpty()){
                            ATSHandler.insertATSRecord(true, lstATSRecords);
                        }
                objectData.put('upsertedRecords',recordsToBeUpdated);
                message = Label.Record_has_been_successfully_updated;
                isSuccessful = true;
            }else{
                objectData.put('upsertedRecords',recordsToBeUpdated);
                message = Label.ERRORS_ON_THIS_PAGE;
                isSuccessful = false;
                // Rollback to the savepoint
                Database.rollback(sp);
            }
            if(lstCrudPermissionException!=null && !lstCrudPermissionException.isEmpty()){
                throw CRUDPermissionException.getCRUDPermissionException(lstCrudPermissionException);
            }
            }
        }catch(Exception ex){
            isSuccessful = false;
            message = ex.getMessage();
            Database.rollback(sp);
            ExceptionLoggingServices.captureExceptionLog(ex,methodInfo);
        }
        System.debug(new LightningServerResponse(isSuccessful,message,objectData,lstAPXFieldValidationError));
        return new LightningServerResponse(isSuccessful,message,objectData,lstAPXFieldValidationError);
    }
    @auraEnabled
    public static LightningServerResponse getIPVDisqualifiedIndividuals (Id caseId){
        Map<String, Object> objectData = new map<String, Object>();
        Boolean isSuccessful= false;
        Set<String> clientNames = new Set<String>();
        String message;
        
        List<T_SBSD_CASE_INDIV__c> caseIndiv = [SELECT Id, IDN_CLIENT__c, IND_CRTKR__c
                                                FROM T_SBSD_CASE_INDIV__c WHERE IDN_CASE__c =: caseId 
                                                AND DTE_BEGIN_EFFV__c<=TODAY AND (DTE_END_EFFV__c = null OR DTE_END_EFFV__c>TODAY)];
        if(!caseIndiv.isEmpty()) {
            List<Id> indivIds = new List<Id>();
            for(T_SBSD_CASE_INDIV__c eachCaseIndiv : caseIndiv) {
                indivIds.add(eachCaseIndiv.IDN_CLIENT__c);
            }
            for(IPV_Information__c ipvRec : [Select id ,Individual_Id__c, Individual_Id__r.NAM_FIRST__c, Individual_Id__r.NAM_LAST__c from IPV_Information__c where Individual_Id__c in :indivIds AND Disqualification_Begin_Date__c <=TODAY AND (Disqualification_End_Date__c = null OR Disqualification_End_Date__c>TODAY)  AND Reversal_Created__c = false])
            {
                if(ipvRec.Individual_Id__r.NAM_FIRST__c !=null && ipvRec.Individual_Id__r.NAM_FIRST__c!=''){
                    clientNames.add(ipvRec.Individual_Id__r.NAM_FIRST__c +' '+ ipvRec.Individual_Id__r.NAM_LAST__c);
                }else{
                    clientNames.add(ipvRec.Individual_Id__r.NAM_LAST__c);
                }
            }
            if(clientNames.size()>0){
                List<String> lstClientNames = new List<String>(clientNames);
                isSuccessful = true;
                String warningMsg;
                if(lstClientNames.size() == 1){
                    warningMsg = lstClientNames[0]+' '+ Label.IPV_ACTIVE_DISQUALIFICATION_SINGLE; 
                }
                else if (lstClientNames.size() == 2){
                    warningMsg= lstClientNames[0]+' and '+lstClientNames[1]+' '+Label.IPV_ACTIVE_DISQUALIFICATION_MULTIPLE;
                }else{
                    for(Integer i=0; i<lstClientNames.size(); i++){
                        if(i==0){
                            warningMsg = lstClientNames[i];  
                        }else if(i == lstClientNames.size()-1){
                            warningMsg += ' and '+lstClientNames[i]+' '+Label.IPV_ACTIVE_DISQUALIFICATION_MULTIPLE;  
                        }else{
                            warningMsg += ' , '+lstClientNames[i];  
                        }
                    }
                }
                objectData.put('warningMsg',warningMsg); 
            }
        }
        return new LightningServerResponse(isSuccessful,message,objectData);
    }
    
}