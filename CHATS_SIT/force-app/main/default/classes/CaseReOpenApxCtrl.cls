public with sharing class CaseReOpenApxCtrl {
    @AuraEnabled
    public static LightningServerResponse getInitData(String caseId){
        Map<String, Object> objectData = new map<String, Object>();
        Boolean isSuccessful = false;
        String message;
        List<T_SBSD_CASE__c> cases = [SELECT Id, CDE_COUNTY__r.Name,CDE_COUNTY__r.CDE_COUNTY__c, CDE_COUNTY__c, DTE_APPLN__c, DTE_RCVD_PACKET_REDET__c, DTE_SENT_PACKET_REDET__c,
                                        DTE_REDET_CASE__c,
                                      (SELECT Id,DTE_BEGIN_EFFV__c, toLabel(CDE_REASON_CHANGE_MODE_STATUS__c)
                                       FROM T_SBSD_CASE10__r
                                       WHERE CDE_STATUS_CASE__c = 'CLS' AND DTE_BEGIN_EFFV__c<=TODAY
                                       AND (DTE_END_EFFV__c = null OR DTE_END_EFFV__c<TODAY)
                                       ORDER BY DTE_BEGIN_EFFV__c desc LIMIT 1)
                                      FROM T_SBSD_CASE__c WHERE Id = :caseId];
        if(!cases.isEmpty()){
            T_SBSD_CASE_STATUS_MODE__c newCaseStatusMode = new T_SBSD_CASE_STATUS_MODE__c();
            NewCaseStatusMode.IDN_CASE__c = cases.get(0).Id;
            objectData.put('newCaseStatus',newCaseStatusMode);
            objectData.put('data',cases.get(0));
            List<T_SBSD_CASE_STATUS_MODE__c> currentCaseStatusMode = [SELECT Id, CDE_STATUS_CASE__c, CDE_MODE_CASE__c 
                                                                      FROM T_SBSD_CASE_STATUS_MODE__c 
                                                                      WHERE IDN_CASE__c =:caseId AND 
                                                                      (DTE_BEGIN_EFFV__c<=TODAY AND (DTE_END_EFFV__c=null OR DTE_END_EFFV__c>=TODAY)) 
                                                                      ORDER BY DTE_BEGIN_EFFV__c DESC , createddate desc LIMIT 1];
            if(!currentCaseStatusMode.isEmpty()){
                objectData.put('currentCaseStatusMode',currentCaseStatusMode.get(0));
            }
            objectData.put('isCountyMatch',CHATSUtility.checkCountyWithUserCounty(cases.get(0).CDE_COUNTY__c));            
            objectData.put('countyName',cases.get(0).CDE_COUNTY__r.Name);
            isSuccessful = true;
            System.debug('objectData:'+objectData);
        }
	LightningServerResponse lsrIPV = getIPVDisqualifiedIndividuals(caseId);
        if(lsrIPV.isSuccessful){
           objectData.put('warningMsg',lsrIPV.objectData.get('warningMsg'));
           objectData.put('ipvDisqualification', true); 
        }    
        return new LightningServerResponse(isSuccessful,message,objectData);
    }
    
    @AuraEnabled
    //added applnDateRec for CCCAP-13251
    public static LightningServerResponse onCaseReopenFlowCompletion(T_SBSD_CASE__c caseRec, T_SBSD_CASE_STATUS_MODE__c newCaseStatus, T_SBSD_CASE_STATUS_MODE__c currentCaseStatusMode,T_SBSD_CASE__c caseRecCopay,T_CASE_APPLN_DTE__c applnDateRec ){
        Map<String, Object> objectData = new map<String, Object>();
        Boolean isSuccessful;
        String message;
        isSuccessful = true;
