                                                        FROM T_SBSD_CASE_INDIV__c WHERE IDN_CASE__c = :caseRec.Id AND DTE_BEGIN_EFFV__c<TODAY AND (DTE_END_EFFV__c=null OR DTE_END_EFFV__c>TODAY)]){
