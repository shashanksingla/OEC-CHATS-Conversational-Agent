		List<batchsit_t_pos_trans_queue_ats__x> lstATSRecords = new List<batchsit_t_pos_trans_queue_ats__x>();

		
        try{
                //[SJ 10/10: Adding condition to handle browser's back button scenario]
                Integer effectiveClosedCase = [SELECT count() FROM T_SBSD_CASE_STATUS_MODE__c WHERE IDN_CASE__c =:caseRec.Id AND CDE_STATUS_CASE__c = 'CLS' AND DTE_BEGIN_EFFV__c<=:System.today() AND (DTE_END_EFFV__c=null OR DTE_END_EFFV__c>:System.today()) LIMIT 1];
