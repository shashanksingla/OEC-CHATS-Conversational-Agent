public with sharing class CaseFlowApxCtrl {
    public final static String EMPTY_LOOKUP = null;
    @auraEnabled
    public static LightningServerResponse handleCaseRelatedRecords(List<SObject> lstSObject, T_SBSD_CASE__c caseRecord, Boolean isRejectedReferralFlow, string appQueueId){
        Savepoint sp = Database.setSavepoint();
        
        System.debug('lstSObject To Be Updated:'+lstSObject);
        Map<String, Object> objectData = new map<String, Object>();
        Boolean isSuccessful;
        String message='';
        List<APXFieldValidationError> lstAPXFieldValidationError; 
        List<SObject> lstRecordsToBeInserted = new List<SObject>();
        List<SObject> lstRecordsToBeUpdated = new List<SObject>();
        try{
            //Custom Logic to create T_APPLN_PRCS_QUEUE__c, T_SBSD_CASE_STATUS_MODE__c
            List<T_SBSD_CASE__c> caseRecs= [SELECT Id, CDE_COUNTY__c, CDE_COUNTY__r.CDE_COUNTY__c,
                                            (SELECT Id FROM Application_Process_Queues__r),
                                            (SELECT Id FROM T_SBSD_CASE10__r)
                                            FROM T_SBSD_CASE__c WHERE id = :caseRecord.Id WITH SECURITY_ENFORCED];
            if(!caseRecs.isEmpty()){
                if(caseRecs.get(0).Application_Process_Queues__r.isEmpty() && caseRecs.get(0).T_SBSD_CASE10__r.isEmpty()){
                    T_SBSD_CASE_STATUS_MODE__c caseStatusMode = new T_SBSD_CASE_STATUS_MODE__c(
                        IDN_CASE__c = caseRecord.Id,
                        CDE_MODE_CASE__c = 'INT',
                        CDE_STATUS_CASE__c = 'PEN',
                        DTE_BEGIN_EFFV__c = System.today()
                    );
                    GenericDMLHandler.insertRecords(new List<SObject>{caseStatusMode}, new Map<String,Object>{'byPassObjects'=>new Set<String>{'T_SBSD_CASE_STATUS_MODE__c'},'Method__c'=>'handleCaseRelatedRecords','Class__c'=>'CaseFlowApxCtrl'});                        
                }
                if(String.isBlank(appQueueId)){
                    T_APPLN_CASE__c appCase = new T_APPLN_CASE__c();
                    GenericDMLHandler.insertRecords(new List<SObject>{appCase}, new Map<String,Object>{'byPassObjects'=>new Set<String>{'T_APPLN_CASE__c'},'Method__c'=>'handleCaseRelatedRecords','Class__c'=>'CaseFlowApxCtrl'});
                    //added to make sure county code consistency remains in system for CCCAP-14154/CCCAP-13978
                    String countyCode = String.isNotEmpty(caseRecs.get(0).CDE_COUNTY__c)?String.valueOf(caseRecs.get(0).CDE_COUNTY__r.CDE_COUNTY__c):EMPTY_LOOKUP;
                    if(countyCode != null && countyCode.length() == 1){
                        countyCode = '0'+countyCode;
                    }
                    T_APPLN_PRCS_QUEUE__c appProcessQueue = new T_APPLN_PRCS_QUEUE__c(
                        CDE_SOURCE__c = 'PA',
                        DTE_RCVD_APPLN__c = caseRecord.DTE_APPLN__c,
                        CDE_STATUS_APPLN__c = 'PRC',
                        IDN_CASE__c = caseRecord.Id,
                        IDN_APPLN__c = appCase.Id,
                        CDE_COUNTY__c = countyCode
                    );
                    GenericDMLHandler.insertRecords(new List<SObject>{appProcessQueue}, new Map<String,Object>{'byPassObjects'=>new Set<String>{'T_APPLN_PRCS_QUEUE__c'},'Method__c'=>'handleCaseRelatedRecords','Class__c'=>'CaseFlowApxCtrl'});                        
                    List<T_APPLN_PRCS_QUEUE__c> appProcessQueues= [SELECT PAPER_AUTOGENERATED_ID__c FROM T_APPLN_PRCS_QUEUE__c WHERE Id=:appProcessQueue.Id WITH SECURITY_ENFORCED LIMIT 1];
                    appCase.IDN_APPLN__c = Integer.valueOf(appProcessQueues.get(0).PAPER_AUTOGENERATED_ID__c);
                    GenericDMLHandler.updateRecords(new List<SObject>{appCase}, new Map<String,Object>{'byPassObjects'=>new Set<String>{'T_APPLN_CASE__c'},'Method__c'=>'handleCaseRelatedRecords','Class__c'=>'CaseFlowApxCtrl'});
                }
                else {                    
                    T_APPLN_PRCS_QUEUE__c appProcessQueue = new T_APPLN_PRCS_QUEUE__c(Id=appQueueId,
                                                                                        IDN_CASE__c = caseRecord.Id);
                    if(!isRejectedReferralFlow){
                        appProcessQueue.CDE_STATUS_APPLN__c = 'PRC';
                        appProcessQueue.DTE_PRCSD_APPLN__c = Date.Today();
                    }
                    //Added additional paramter of fieldNames for Checkmarx CCCAP-12580
                    GenericDMLHandler.updateRecords(new List<SObject>{appProcessQueue}, new Map<String,Object>{'byPassObjects'=>new Set<String>{'T_APPLN_PRCS_QUEUE__c'},'Method__c'=>'handleCaseRelatedRecords','Class__c'=>'CaseFlowApxCtrl'}, new list<String>{'DTE_PRCSD_APPLN__c'});
                } 
                CaseLastUpdatedServices.updateCaseNameField(new Set<Id>{caseRecord.Id});
            }
            
            for(SObject sOb:lstSObject){
                if(String.isNotBlank(sOb.Id)){
                    if((String.valueOf(sOb.getSObjectType()) != 'T_SBSD_CASE_PHONE__c' || sOb.get('NBR_PHONE__c')!=null)){
                        lstRecordsToBeUpdated.add(sOb);    
                    }
                }else{
                    if((String.valueOf(sOb.getSObjectType()) != 'T_SBSD_CASE_PHONE__c' || sOb.get('NBR_PHONE__c')!=null)){
                        lstRecordsToBeInserted.add(sOb);
                    }
                }
            }   
            
            List<Database.SaveResult> lstSaveResult = new List<Database.SaveResult>();
            List<CRUDPermissionException> lstCrudPermissionException = new List<CRUDPermissionException>();
            
            List<DMLResult> lstDMLResult = GenericDMLHandler.insertRecords(lstRecordsToBeInserted, false, new Map<String,Object>{'Method__c'=>'handleCaseRelatedRecords','Class__c'=>'CaseFlowApxCtrl'});
            System.debug('lstDMLResult After Insert:'+lstDMLResult);
            lstSaveResult.addAll(GenericDMLHandler.getSaveResultsFromDMLResults(lstDMLResult));
            lstCrudPermissionException.addAll(GenericDMLHandler.getCRUDPermissionExceptionsFromDMLResults(lstDMLResult));
			
            lstDMLResult = GenericDMLHandler.updateRecords(lstRecordsToBeUpdated, false, new Map<String,Object>{'Method__c'=>'handleCaseRelatedRecords','Class__c'=>'CaseFlowApxCtrl'});
            System.debug('lstDMLResult After Update:'+lstDMLResult);
            lstSaveResult.addAll(GenericDMLHandler.getSaveResultsFromDMLResults(lstDMLResult));
            lstCrudPermissionException.addAll(GenericDMLHandler.getCRUDPermissionExceptionsFromDMLResults(lstDMLResult));            
            
            lstRecordsToBeUpdated.addAll(lstRecordsToBeInserted);
            System.debug('lstRecordsToBeUpdated-->'+lstRecordsToBeUpdated);
            lstAPXFieldValidationError = CrudResponseApxCtrl.getCrudResponseFromSaveResults(lstRecordsToBeUpdated, lstSaveResult);
            if(lstAPXFieldValidationError.isEmpty()){
                objectData.put('upsertedRecords',lstRecordsToBeUpdated);
                message = Label.Record_has_been_successfully_updated;
                isSuccessful = true;
                lstRecordsToBeUpdated.add(caseRecord);
                JunkRecordServices.deleteJunkRecordsByRecords(lstRecordsToBeUpdated, false);
            }else{
                objectData.put('upsertedRecords',lstRecordsToBeUpdated);
                message = Label.Please_correct_the_below_errors;
                isSuccessful = false;
                // Rollback to the savepoint
                Database.rollback(sp);
            }
            //System.debug('lstCrudPermissionException:'+lstCrudPermissionException);
            if(lstCrudPermissionException!=null && !lstCrudPermissionException.isEmpty()){
                throw CRUDPermissionException.getCRUDPermissionException(lstCrudPermissionException);
            }
        }catch(Exception dEx){
            isSuccessful = false;
            message += dEx.getLineNumber()+Label.SEPARATOR_SEMI_COLUMN+dEx.getMessage();
            System.debug(message);
            
            // Rollback to the savepoint
            Database.rollback(sp);
            Map<String,Object> exceptionMap = new Map<String,Object>();
            exceptionMap.put('Class__c','CaseFlowApxCtrl' );
            exceptionMap.put('Method__c','handleCaseRelatedRecords');
            ExceptionLoggingServices.captureExceptionLog(dEx, exceptionMap);
        }
        return new LightningServerResponse(isSuccessful,message,objectData,lstAPXFieldValidationError);
    }
    
    @auraEnabled
    public static LightningServerResponse getUsersOwnerCounty(){
        Map<String,Object> objectData = new Map<String,Object>();
        try{
            List<User> users = [SELECT Owner_County__c FROM User WHERE Id = :UserInfo.getUserId() AND Owner_County__c!=null WITH SECURITY_ENFORCED LIMIT 1];
            if(!users.isEmpty()){
                List<T_COUNTY__c> counties = [SELECT Id FROM T_COUNTY__c WHERE CDE_COUNTY__c = :Decimal.valueOf(users.get(0).Owner_County__c) WITH SECURITY_ENFORCED];
                if(!counties.isEmpty()){
                    objectData.put('userCounty',counties.get(0).Id);
                }else{
                    objectData.put('warning','No County present for county code:'+users.get(0).Owner_County__c);
                }
            }
        }catch(Exception ex){
        	Map<String,Object> exceptionMap = new Map<String,Object>();
            exceptionMap.put('Class__c','CaseFlowApxCtrl' );
            exceptionMap.put('Method__c','getUsersOwnerCounty');
            ExceptionLoggingServices.captureExceptionLog(ex, exceptionMap);
            objectData.put('warning',ex.getMessage());
        }
        return new LightningServerResponse(true,null,objectData);
    }
    
    @auraEnabled
    public static LightningServerResponse checkCountyWithUserCounty(String countyId){
        T_COUNTY__c county = [Select Name from T_COUNTY__c where Id =:countyId WITH SECURITY_ENFORCED limit 1];
        return new LightningServerResponse(true,null, new Map<String,Object>{'countyMatched'=>CHATSUtility.checkCountyWithUserCounty(countyId), 'countyName'=>county.Name});
    }
    
    @auraEnabled
    public static LightningServerResponse getCaseName(String caseId){
        List<T_SBSD_CASE__c> cases = [SELECT Name FROM T_SBSD_CASE__c WHERE Id =:caseId WITH SECURITY_ENFORCED];
        String caseName;
        if(!cases.isEmpty()){
            caseName = cases.get(0).Name;
        }
        return new LightningServerResponse(true,null, new Map<String,Object>{'caseName'=>caseName});
    }
    
}