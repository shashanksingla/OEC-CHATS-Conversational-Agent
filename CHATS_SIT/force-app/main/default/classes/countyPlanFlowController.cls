    @auraEnabled
    public static T_COUNTY_Plan__c getCountyValidatedForNewCountyPlan(String countyID){
        system.debug('Apex validate reached');
        Map<String,Object> methodInfo = new Map<String,Object>{'Class__c'=>'countyPlanFlowController','Method__c'=>'getCountyValidatedForNewCountyPlan'};
            T_COUNTY_PLAN__c countyPlan = new T_COUNTY_PLAN__c();
        try{
            List<T_COUNTY_PLAN__c> lstCountyPlan = [select Id FROM T_COUNTY_PLAN__c WHERE CDE_COUNTY__c =:countyId AND CDE_STATUS__c != 'APV' LIMIT 1];    
            if(!lstCountyPlan.isEmpty()){
                countyPlan = lstCountyPlan.get(0);
            }
        }
        catch(Exception ex){
            ExceptionLoggingServices.captureExceptionLog(ex,methodInfo);
        }
        return countyPlan;
    }
    
    @AuraEnabled
    public static map<String, Object> ownerCountyValidation(String recordId, Boolean isCounty){
        map<String, Object> responseMap = new map<String, Object>();
        Boolean countyMatched = true;
        String countyName = '';
        Id countyId;
        if(!String.isBlank(recordId)){            
            if(isCounty){
                countyId = recordId;
                T_COUNTY__c county = [SELECT Id, Name FROM T_COUNTY__c WHERE Id = :recordId];
                countyName = county.Name;
            }
            else{
                T_COUNTY_PLAN__c countyPlan = [SELECT Id, CDE_COUNTY__c, CDE_COUNTY__r.Name,DTE_BEGIN_EFFEV__c FROM T_COUNTY_PLAN__c WHERE Id = :recordId];
                countyId = countyPlan.CDE_COUNTY__c;
                countyName = countyPlan.CDE_COUNTY__r.Name;
                Boolean feedbacksExist = [select id from CP_CRP_Feedback__c where County__c =:countyId AND feedback_type__c IN ('CP')]?.size()>0;
                responseMap.put('isFeedbackVisible',feedbacksExist && CompareCP_CRP_lwc.IsDateAfter_15June2025(countyPlan.DTE_BEGIN_EFFEV__c));
            }
            countyMatched = CHATSUtility.checkCountyWithUserCounty(countyId);
        }
        responseMap.put('countyMatched', countyMatched);
        responseMap.put('countyName', countyName);
        responseMap.put('countyId', countyId);
        return responseMap;
    }
    
    @auraEnabled
    public static LightningServerResponse updateFPGValueFromTemplate(String templateName ,String countyId, String recordId) {
        List<T_COUNTY_PLAN__c> countyPlanTemplate = new List<T_COUNTY_PLAN__c>();
        Map<String,Object> methodInfo = new Map<String,Object>{'Class__c'=>'countyPlanFlowController','Method__c'=>'getCountyPlanRecordForTemplate'};
        try{
            countyPlanTemplate = [SELECT Id, CDE_COUNTY__c, DTE_BEGIN_EFFEV__c, CDE_COUNTY_PLAN_TEMPLT__c,ELIGIBILITY_Q1_1__c FROM T_COUNTY_PLAN__c WHERE CDE_COUNTY_PLAN_TEMPLT__c=:templateName AND IND_COUNTY_PLAN_TEMPLT__c = true AND CDE_COUNTY__c =:countyId ORDER BY LastModifiedDate DESC NULLS FIRST LIMIT 1];
        }
        catch(Exception ex){    
            ExceptionLoggingServices.captureExceptionLog(ex,methodInfo);
            return new LightningServerResponse(false, ex.getMessage(), null);
        }
        if(countyPlanTemplate.size()>0){
            List<T_COUNTY_PLAN__c> countyPlanRecord = new List<T_COUNTY_PLAN__c>();
            List<T_COUNTY_PLAN__c> countyPlanToBeUpdated = new List<T_COUNTY_PLAN__c>();
            countyPlanRecord = [SELECT Id, CDE_COUNTY__c, ELIGIBILITY_Q1_1__c FROM T_COUNTY_PLAN__c WHERE Id=:recordId LIMIT 1];
            if(countyPlanRecord.size() > 0){
                countyPlanRecord[0].ELIGIBILITY_Q1_1__c = countyPlanTemplate[0].ELIGIBILITY_Q1_1__c;
                countyPlanToBeUpdated.add(countyPlanRecord[0]);
            }
            if(!countyPlanToBeUpdated.isEmpty()){
                GenericDMLHandler.updateRecords(countyPlanToBeUpdated,new Map<String,Object>{'Method__c'=>'updateFPGValueFromTemplate','Class__c'=>'countyPlanFlowContoller'}, new List<String>{'ELIGIBILITY_Q1_1__c'});
            }
            return new LightningServerResponse(true, 'Success', new Map<String, Object>{'countyPlanRecord'=>countyPlanRecord[0]});  
        }else{
            return new LightningServerResponse(true, 'Template not found', new Map<String, Object>{'countyPlanRecord'=>new T_COUNTY_PLAN__c()}); 
        }
    }
